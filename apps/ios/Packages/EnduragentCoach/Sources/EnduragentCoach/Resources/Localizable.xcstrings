    "chat.planCreation.clarifyRetryHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell me again in a different way, with weekdays, time limits, or exact dates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dímelo otra vez de otra forma, con días de la semana, límites de tiempo o fechas exactas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis-le-moi autrement, avec les jours de la semaine, des limites de temps ou des dates exactes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimmi di nuovo in un altro modo, con i giorni della settimana, i limiti di tempo o le date esatte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag es mir noch einmal anders, mit Wochentagen, Zeitlimits oder genauen Daten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeg het nog een keer anders, met weekdagen, tijdslimieten of exacte datums."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sig det igen på en anden måde, med ugedage, tidsgrænser eller præcise datoer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Säg det igen på ett annat sätt, med veckodagar, tidsgränser eller exakta datum."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Si det igjen på en annen måte, med ukedager, tidsgrenser eller nøyaktige datoer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerro se uudestaan toisella tavalla, viikonpäivineen, aikarajoineen tai tarkkoine päivämäärineen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Diz-me outra vez de outra forma, com dias da semana, limites de tempo ou datas exactas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga de outro jeito, com dias da semana, limites de tempo ou datas exatas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiedz to jeszcze raz inaczej: z dniami tygodnia, limitami czasu albo dokładnymi datami."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요일, 시간 제한, 정확한 날짜를 넣어 다른 방식으로 다시 알려 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曜日、時間の上限、正確な日付を入れて、別の言い方でもう一度教えてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请换一种方式再说一次，并带上星期几、时间上限或确切日期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請換一種方式再說一次，並附上星期幾、時間上限或確切日期。"
          }
        }
      }
    },
