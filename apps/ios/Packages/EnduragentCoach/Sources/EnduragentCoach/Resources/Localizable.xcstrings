        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O usuário principal de %#@telegram@ pode ter sido salvo, mas %#@product@ não conseguiu verificar o armazenamento. Reinicie %#@product@ e verifique %#@telegram@ antes de parear novamente."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
