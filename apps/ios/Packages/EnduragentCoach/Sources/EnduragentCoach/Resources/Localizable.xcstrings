    "settings.telegram.delete.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This turns the bot off, deletes its encrypted token and allowed-user access from %#@computer@. The %#@telegram@ bot and its chat remain in %#@telegram@."
          },
          "substitutions": {
            "computer": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "telegram": {
              "argNum": 2,
              "formatSpecifier": "@"
