    "plan.view.readiness.incompleteLoadDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recent training load is incomplete, so a race-day Form range cannot be shown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carga de entrenamiento reciente está incompleta, por lo que no se puede mostrar un rango de forma para el día de la carrera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La charge d’entraînement récente est incomplète. Il est donc impossible d’afficher une fourchette de forme pour le jour de la course."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il carico di allenamento recente è incompleto, quindi non è possibile mostrare un intervallo di forma per il giorno della gara."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktuelle Trainingsbelastung ist unvollständig. Deshalb kann keine Formspanne für den Renntag angezeigt werden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De recente trainingsbelasting is onvolledig. Daarom kan geen bandbreedte voor de vorm op de wedstrijddag worden getoond."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den seneste træningsbelastning er ufuldstændig, så et interval for form på konkurrencedagen kan ikke vises."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den senaste träningsbelastningen är ofullständig, så inget TSB-intervall för tävlingsdagen kan visas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den nylige treningsbelastningen er ufullstendig, så et intervall for form på konkurransedagen kan ikke vises."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeaikainen harjoituskuorma on puutteellinen, joten kilpailupäivän tuoreuden vaihteluväliä ei voida näyttää."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A carga de treino recente está incompleta, pelo que não é possível apresentar um intervalo de forma para o dia da prova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A carga de treinamento recente está incompleta, por isso não é possível mostrar uma faixa de forma para o dia da prova."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnie dane o obciążeniu treningowym są niekompletne, więc nie można pokazać zakresu formy w dniu wyścigu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 훈련 부하 데이터가 불완전하여 대회 당일 밸런스 범위를 표시할 수 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近のトレーニング負荷が不完全なため、レース当日のフォームの範囲を表示できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
