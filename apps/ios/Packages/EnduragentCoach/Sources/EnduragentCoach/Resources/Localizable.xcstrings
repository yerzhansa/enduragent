    "training.ride.limitationDuration": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usable duration is below the 60-minute reference context."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La duración utilizable es inferior a los 60 minutos de referencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La durée exploitable est inférieure aux 60 minutes de référence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La durata utilizzabile è inferiore ai 60 minuti del contesto di riferimento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die nutzbare Dauer liegt unter der Referenzdauer von 60 Minuten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bruikbare duur ligt onder de referentieduur van 60 minuten."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den brugbare varighed er under referenceperioden på 60 minutter."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den användbara tiden är kortare än referensens 60 minuter."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Brukbar varighet er kortere enn referansen på 60 minutter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttökelpoinen kesto alittaa 60 minuutin vertailuajan."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A duração utilizável é inferior aos 60 minutos do contexto de referência."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A duração utilizável está abaixo dos 60 minutos de referência."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czas nadający się do analizy jest krótszy niż 60-minutowy okres odniesienia."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 가능한 시간이 참고 기준인 60분보다 짧습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用可能な時間が、参照基準の60分を下回っています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用时长不足参考所需的 60 分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可用時長少於 60 分鐘的參考時長。"
          }
        }
      }
    },
