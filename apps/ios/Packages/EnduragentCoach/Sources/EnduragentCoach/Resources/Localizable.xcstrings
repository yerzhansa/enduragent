          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建议使用专用机器人。它会创建新的 @username 和 %#@telegram@ 聊天；原机器人的可见历史记录不会迁移。运动员记忆、训练数据和计划会共享。"
          },
