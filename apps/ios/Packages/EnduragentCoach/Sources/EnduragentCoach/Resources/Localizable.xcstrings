    "settings.telegram.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A dedicated bot is recommended. It creates a new @username and %#@telegram@ chat; visible history from a previous bot does not move. Athlete memory, training data and plans are shared."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se recomienda un bot dedicado. Crea un nuevo @username y un chat de %#@telegram@; el historial visible de un bot anterior no se transfiere. La memoria del deportista, los datos de entrenamiento y los planes se comparten."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bot dédié est recommandé. Il crée un nouveau @username et une conversation %#@telegram@ ; l’historique visible d’un ancien bot n’est pas transféré. La mémoire de l’athlète, les données d’entraînement et les plans sont partagés."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si consiglia un bot dedicato. Crea un nuovo @username e una chat %#@telegram@; la cronologia visibile di un bot precedente non viene trasferita. La memoria dell’atleta, i dati di allenamento e i piani sono condivisi."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein eigener Bot wird empfohlen. Dadurch entstehen ein neuer @username und ein neuer %#@telegram@-Chat; der sichtbare Verlauf eines bisherigen Bots wird nicht übertragen. Gespeicherte Erinnerungen über dich, Trainingsdaten und Pläne werden gemeinsam genutzt."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een aparte bot wordt aanbevolen. Deze krijgt een nieuwe @username en een nieuwe %#@telegram@-chat. Zichtbare geschiedenis van een vorige bot wordt niet overgenomen. Atleetgeheugen, trainingsgegevens en plannen worden gedeeld."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En særskilt bot anbefales. Den opretter et nyt @username og en ny %#@telegram@-chat. Synlig historik fra en tidligere bot flyttes ikke med. Atlethukommelse, træningsdata og planer deles."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En separat bot rekommenderas. Den får ett nytt @username och en ny %#@telegram@-chatt. Den synliga historiken från en tidigare bot flyttas inte. Minnet om dig, träningsdata och planer delas."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En egen bot anbefales. Den oppretter et nytt @username og en ny %#@telegram@-samtale. Synlig historikk fra en tidligere bot flyttes ikke. Lagret informasjon om utøveren, treningsdata og planer deles."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suosittelemme erillistä bottia. Se luo uuden @username-tunnuksen ja %#@telegram@-keskustelun. Edellisen botin näkyvä historia ei siirry. Urheilijaa koskeva muisti, harjoitustiedot ja suunnitelmat ovat yhteisiä."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Recomenda-se um bot dedicado. Cria um novo @username e uma conversa no %#@telegram@. O histórico visível de um bot anterior não é transferido. A memória do atleta, os dados de treino e os planos são partilhados."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recomendamos um bot exclusivo. Ele cria um novo @username e uma conversa no %#@telegram@; o histórico visível de um bot anterior não é transferido. A memória do atleta, os dados de treinamento e os planos são compartilhados."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalecany jest osobny bot. Powstaje nowa nazwa @username i czat %#@telegram@; widoczna historia poprzedniego bota nie jest przenoszona. Pamięć o sportowcu, dane treningowe i plany są wspólne."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전용 봇을 권장합니다. 새 @username과 %#@telegram@ 채팅이 생성되며, 이전 봇에 표시되는 대화 기록은 옮겨지지 않습니다. 선수에 대한 기억, 훈련 데이터 및 계획은 공유됩니다."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "専用のボットをおすすめします。新しい@usernameと%#@telegram@チャットが作成され、以前のボットの表示履歴は引き継がれません。アスリートに関する記憶、トレーニングデータ、プランは共有されます。"
