          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa conversazione non contiene messaggi leggibili."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gespräch enthält keine lesbaren Nachrichten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit gesprek bevat geen leesbare berichten."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne samtale har ingen læsbare beskeder."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här samtalet har inga läsbara meddelanden."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne samtalen har ingen lesbare meldinger."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tässä keskustelussa ei ole luettavia viestejä."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conversa não tem mensagens legíveis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conversa não tem mensagens legíveis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta rozmowa nie zawiera wiadomości, które można odczytać."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 대화에는 읽을 수 있는 메시지가 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会話には表示できるメッセージがありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这段对话没有可读取的消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
