    "training.response.fitCaption": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provider-fitted power and heart-rate curve details"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detalles de la curva de potencia y frecuencia cardiaca ajustada por el proveedor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détails des courbes de puissance et de fréquence cardiaque ajustées par le fournisseur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dettagli delle curve di potenza e frequenza cardiaca stimate dal fornitore"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Details der vom Anbieter angepassten Leistungs- und Herzfrequenzkurve"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Details van de door de aanbieder berekende vermogens- en hartslagcurve"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Detaljer om udbyderens tilpassede effekt- og pulskurver"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detaljer om leverantörens anpassade effekt- och pulskurvor"
          }
        },
        "nb": {
