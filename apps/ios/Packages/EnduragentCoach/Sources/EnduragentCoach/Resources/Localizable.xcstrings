            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請 %#@botFather@ 建立機器人，複製其權杖後返回這裡。%#@product@ 會直接從剪貼簿讀取並驗證權杖，全程不會顯示權杖。"
          },
          "substitutions": {
