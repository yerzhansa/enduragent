    "chat.planChange.feedback.dayChanged": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The day changed while this choice was open. Request a fresh choice for today; no date was assigned."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha cambiado el día mientras esta opción estaba abierta. Solicita una nueva opción para hoy; no se ha asignado ninguna fecha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jour a changé pendant que ce choix était ouvert. Demande un nouveau choix pour aujourd’hui ; aucune date n’a été attribuée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il giorno è cambiato mentre questa scelta era aperta. Richiedi una nuova scelta per oggi. Non è stata assegnata alcuna data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während diese Auswahl geöffnet war, hat ein neuer Tag begonnen. Fordere eine neue Auswahl für heute an; es wurde kein Datum zugewiesen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De dag is veranderd terwijl deze keuze openstond. Vraag een nieuwe keuze voor vandaag aan. Er is geen datum toegewezen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoen skiftede, mens dette valg var åbent. Bed om et nyt valg for i dag. Ingen dato blev tildelt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagen ändrades medan det här valet var öppet. Begär ett nytt val för idag. Inget datum tilldelades."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det ble en ny dag mens dette valget var åpent. Be om et nytt valg for i dag. Ingen dato ble satt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivä vaihtui tämän valinnan ollessa auki. Pyydä uusi valinta tälle päivälle. Päivämäärää ei asetettu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O dia mudou enquanto esta escolha estava aberta. Pede uma nova escolha para hoje; não foi atribuída nenhuma data."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dia mudou enquanto esta escolha estava aberta. Peça uma nova escolha para hoje; não foi atribuída nenhuma data."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzień zmienił się, gdy ten wybór był otwarty. Poproś o nowy wybór na dziś. Nie przypisano daty."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 선택 항목을 열어 둔 동안 날짜가 바뀌었습니다. 오늘 날짜에 맞는 새 선택 항목을 요청하세요. 날짜는 지정되지 않았습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この選択画面を開いている間に日付が変わりました。今日の選択肢を再度取得してください。日付は割り当てられていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此选项打开期间已跨日。请重新请求今天的选项，尚未指定日期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此選項開啟期間已跨日。請重新請求今天的選項，尚未指定日期。"
          }
        }
      }
    },
