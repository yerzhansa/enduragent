            },
            "product": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poproś %#@botFather@ o bota, skopiuj jego token i wróć tutaj. %#@product@ odczytuje i weryfikuje token bezpośrednio ze schowka; token nigdy nie jest wyświetlany."
          },
          "substitutions": {
