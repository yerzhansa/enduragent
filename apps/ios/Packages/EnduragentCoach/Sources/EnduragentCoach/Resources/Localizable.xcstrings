          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den godkjente endringen er en del av planen din. Oppdateringen av de sju dagene i %#@intervals@ har ikke startet ennå."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
