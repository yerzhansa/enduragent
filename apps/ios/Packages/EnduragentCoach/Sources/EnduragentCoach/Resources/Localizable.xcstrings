    "settings.application.resetDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clears the visible conversation. Training data and saved coach memory remain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra la conversación visible. Los datos de entrenamiento y la memoria guardada del entrenador se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface la conversation visible. Les données d’entraînement et la mémoire enregistrée du coach sont conservées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella la conversazione visibile. I dati di allenamento e la memoria salvata del coach rimangono."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leert das sichtbare Gespräch. Trainingsdaten und gespeicherte Erinnerungen des Coaches bleiben erhalten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wist het zichtbare gesprek. Trainingsgegevens en het opgeslagen coachgeheugen blijven bewaard."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rydder den synlige samtale. Træningsdata og trænerens gemte hukommelse bevares."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rensar det synliga samtalet. Träningsdata och tränarens sparade minne finns kvar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tømmer den synlige samtalen. Treningsdata og trenerens lagrede hukommelse beholdes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyhjentää näkyvän keskustelun. Harjoitustiedot ja valmentajan tallennettu muisti säilyvät."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpa a conversa visível. Os dados de treino e a memória guardada do treinador mantêm-se."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpa a conversa visível. Os dados de treinamento e a memória salva do treinador permanecem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czyści widoczną rozmowę. Dane treningowe i zapisana pamięć trenera pozostają."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 표시된 대화를 지웁니다. 훈련 데이터와 저장된 코치 기억은 유지됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示中の会話を消去します。トレーニングデータと保存されたコーチの記憶は残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除当前显示的对话。训练数据和已保存的教练记忆会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除目前顯示的對話。訓練資料與已儲存的教練記憶會保留。"
          }
        }
      }
    },
