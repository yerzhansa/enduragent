    "setup.ai.claude.statusDetail.absentBinary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@claudeCode@ CLI was not found, or the installed version is too old. Install or update it, then choose Check again."
          },
          "substitutions": {
            "claudeCode": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado la CLI de %#@claudeCode@ o la versión instalada es demasiado antigua. Instálala o actualízala y elige Comprobar de nuevo."
          },
          "substitutions": {
            "claudeCode": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’outil en ligne de commande %#@claudeCode@ est introuvable ou sa version installée est trop ancienne. Installe-le ou mets-le à jour, puis choisis Vérifier à nouveau."
          },
          "substitutions": {
            "claudeCode": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La CLI di %#@claudeCode@ non è stata trovata oppure la versione installata è troppo vecchia. Installala o aggiornala, poi scegli Controlla di nuovo."
          },
          "substitutions": {
            "claudeCode": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die %#@claudeCode@-CLI wurde nicht gefunden oder die installierte Version ist zu alt. Installiere oder aktualisiere sie und wähle dann „Erneut prüfen“."
          },
          "substitutions": {
            "claudeCode": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De %#@claudeCode@-CLI is niet gevonden of de geïnstalleerde versie is te oud. Installeer of werk deze bij en kies Opnieuw controleren."
          },
          "substitutions": {
            "claudeCode": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@claudeCode@-CLI'en blev ikke fundet, eller den installerede version er for gammel. Installér eller opdatér den, og vælg derefter Kontrollér igen."
          },
          "substitutions": {
            "claudeCode": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommandoradsverktyget %#@claudeCode@ hittades inte eller så är den installerade versionen för gammal. Installera eller uppdatera det och välj sedan Kontrollera igen."
          },
          "substitutions": {
            "claudeCode": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@claudeCode@-kommandolinjeverktøyet ble ikke funnet, eller den installerte versjonen er for gammel. Installer eller oppdater det, og velg Sjekk igjen."
          },
          "substitutions": {
            "claudeCode": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@claudeCode@-komentorivityökalua ei löytynyt tai asennettu versio on liian vanha. Asenna tai päivitä se ja valitse sitten Tarkista uudelleen."
