          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svar på de obligatoriske sikkerhetsspørsmålene for å fortsette."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastaa pakollisiin turvallisuuskysymyksiin jatkaaksesi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde às perguntas de segurança obrigatórias para continuar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Responda às perguntas de segurança obrigatórias para continuar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiedz na wymagane pytania dotyczące bezpieczeństwa, aby kontynuować."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하려면 필수 안전 질문에 답하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
