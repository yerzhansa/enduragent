    "cli.startup.usageCommandCommandsSetupInteractiveWizard": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage: %#@binaryName@ [command]\n\nCommands:\n  %#@setup@                     Interactive wizard to create the config file\n  %#@version@                   Show current version\n  %#@addSender@       Authorize a %#@telegram@ user-id to interact with the bot\n  %#@removeSender@    Revoke a previously-authorized %#@telegram@ user-id\n  %#@listSenders@              Show current allowlist + known session candidates\n  (none)                    Start the coaching agent (%#@telegram@ or CLI mode)\n\nOptions:\n  %#@help@                    Show this help message"
          },
          "substitutions": {
            "binaryName": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "setup": {
              "argNum": 2,
              "formatSpecifier": "@"
