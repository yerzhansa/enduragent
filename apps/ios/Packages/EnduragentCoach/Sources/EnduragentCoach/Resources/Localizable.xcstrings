    "chat.supportingEvent.reviewSource": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review the synchronized name and date in a fresh preview before accepting them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa el nombre y la fecha sincronizados en una nueva vista previa antes de aceptarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie le nom et la date synchronisés dans un nouvel aperçu avant de les accepter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla il nome e la data sincronizzati in una nuova anteprima prima di accettarli."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe den synchronisierten Namen und das Datum in einer neuen Vorschau, bevor du sie übernimmst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk de gesynchroniseerde naam en datum in een nieuw wijzigingsvoorbeeld voordat je ze accepteert."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gennemgå det synkroniserede navn og den synkroniserede dato i en ny forhåndsvisning, før du accepterer dem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Granska det synkroniserade namnet och datumet i en ny förhandsgranskning innan du godkänner dem."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se gjennom det synkroniserte navnet og datoen i en ny forhåndsvisning før du godtar dem."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista synkronoitu nimi ja päivämäärä uudessa esikatselussa ennen niiden hyväksymistä."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Revê o nome e a data sincronizados numa nova pré-visualização antes de os aceitares."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise o nome e a data sincronizados em uma nova prévia antes de aceitá-los."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź zsynchronizowaną nazwę i datę w nowym podglądzie, zanim je zaakceptujesz."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반영하기 전에 새 미리보기에서 동기화된 이름과 날짜를 검토하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認する前に、新しいプレビューで同期された名前と日付を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接受前，请在新预览中查看已同步的名称和日期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接受前，請在新預覽中檢視已同步的名稱與日期。"
          }
        }
      }
    },
