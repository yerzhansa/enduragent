    "settings.coach.unsupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@codex@ agent isn’t supported on %#@operatingSystem@. Choose %#@claude@ subscription or an API-key provider, then save the coach route. Your credentials, athlete data, conversations, and other settings stay unchanged."
          },
