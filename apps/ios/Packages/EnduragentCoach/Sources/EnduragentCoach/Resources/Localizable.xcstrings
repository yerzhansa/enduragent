        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorry, er is iets misgegaan bij het maken van je trainingsschema. Probeer het opnieuw."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beklager, noget gik galt, da jeg lavede din plan. Prøv igen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Något gick tyvärr fel när jag skapade din plan. Försök igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beklager, noe gikk galt da jeg laget planen din. Prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pahoittelut, suunnitelman luomisessa meni jokin pieleen. Yritä uudelleen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desculpa, algo correu mal ao criar o teu plano. Tenta novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desculpe, algo deu errado ao criar seu plano. Tente novamente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przepraszam, coś poszło nie tak podczas tworzenia planu. Spróbuj ponownie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "죄송합니다. 계획을 만드는 중 문제가 발생했습니다. 다시 시도해 주세요."
