    "training.power.unavailable.insufficientData": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Power progress needs rides with recorded power in both 28-day windows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La evolución de potencia necesita salidas con potencia registrada en ambos periodos de 28 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La progression de puissance nécessite des sorties avec puissance enregistrée sur chacune des deux périodes de 28 jours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per valutare i progressi di potenza servono uscite con potenza registrata in entrambi i periodi di 28 giorni."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für den Leistungsverlauf werden in beiden 28-Tage-Zeiträumen Fahrten mit aufgezeichneter Leistung benötigt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor vermogensontwikkeling zijn ritten met geregistreerd vermogen in beide perioden van 28 dagen nodig."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Effektudvikling kræver ture med registreret effekt i begge perioder på 28 dage."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Effektutvecklingen kräver cykelturer med registrerad effekt i båda 28-dagarsperioderna."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Wattutvikling krever turer med registrert watt i begge 28-dagersperiodene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tehon kehitys vaatii tehotietoja sisältäviä lenkkejä molemmilta 28 päivän jaksoilta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A evolução da potência precisa de voltas com potência registada em ambos os períodos de 28 dias."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O progresso de potência precisa de pedaladas com potência registrada em ambos os períodos de 28 dias."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Postępy mocy wymagają przejazdów z zarejestrowaną mocą w obu okresach 28 dni."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파워 추이를 확인하려면 두 28일 기간 모두에 파워가 기록된 라이딩이 필요합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パワーの推移を確認するには、両方の28日間にパワーを記録したライドが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "功率进展对比需要两个 28 天时段均有记录功率的骑行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "功率進展比較需要兩個 28 天期間都有記錄功率的騎乘。"
          }
        }
      }
    },
