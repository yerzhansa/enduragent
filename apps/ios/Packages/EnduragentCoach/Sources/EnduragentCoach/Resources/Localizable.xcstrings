      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bot resumed after a long gap, so messages sent during that time may not have reached %#@product@. Check the %#@telegram@ chat before clearing this warning."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "telegram": {
              "argNum": 2,
              "formatSpecifier": "@"
