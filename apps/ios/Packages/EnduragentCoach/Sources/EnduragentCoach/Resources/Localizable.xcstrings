            "value": "%#@telegram@ meldte om en konflikt (%#@code@) — en annen instans henter allerede meldinger med dette bot-tokenet. Stopp den andre instansen, og start deretter på nytt."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
