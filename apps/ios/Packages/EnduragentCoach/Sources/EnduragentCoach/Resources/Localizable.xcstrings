    "training.response.powerDistributionIntro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows how much measured ride time fell inside each recorded power range. Missing ranges are not filled with zeros."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra cuánto tiempo medido de la salida corresponde a cada rango de potencia registrado. Los rangos que faltan no se rellenan con ceros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique le temps de sortie mesuré dans chaque plage de puissance enregistrée. Les plages manquantes ne sont pas remplacées par des zéros."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra quanto tempo misurato in sella rientra in ciascun intervallo di potenza registrato. Gli intervalli mancanti non vengono riempiti con zeri."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt, wie viel gemessene Fahrzeit in den jeweiligen aufgezeichneten Leistungsbereich fällt. Fehlende Bereiche werden nicht mit Nullen aufgefüllt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont hoeveel gemeten rijtijd binnen elk geregistreerd vermogensbereik viel. Ontbrekende bereiken worden niet met nullen ingevuld."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser, hvor meget målt køretid der lå inden for hvert registreret effektinterval. Manglende intervaller udfyldes ikke med nuller."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar hur mycket av den uppmätta cykeltiden som låg inom varje registrerat effektintervall. Saknade intervall fylls inte med nollor."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser hvor mye av den målte turtiden som falt innenfor hvert registrerte wattintervall. Manglende intervaller fylles ikke med nuller."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää, kuinka paljon mitattua ajoaikaa osui kuhunkin tallennettuun tehoväliin. Puuttuvia vaihteluvälejä ei täytetä nollilla."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra quanto tempo medido da volta ficou dentro de cada intervalo de potência registado. Os intervalos em falta não são preenchidos com zeros."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra quanto tempo medido da pedalada ficou em cada faixa de potência registrada. Faixas ausentes não são preenchidas com zeros."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje, ile zmierzonego czasu jazdy przypada na każdy zarejestrowany zakres mocy. Brakujące zakresy nie są uzupełniane zerami."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록된 각 파워 범위에서 측정된 라이딩 시간을 표시합니다. 누락된 범위를 0으로 채우지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録された各パワーの範囲に含まれる測定ライド時間を表示します。欠測範囲をゼロで埋めることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示各记录功率范围内的实测骑行时间。缺失范围不会以零填充。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示各記錄功率範圍內的實測騎乘時間。不會以零填補缺少的範圍。"
          }
        }
      }
    },
