    "training.view.history.refreshFailure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Training could not be refreshed. Showing the last recorded data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron actualizar los datos de entrenamiento. Se muestran los últimos datos registrados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données d’entraînement n’ont pas pu être actualisées. Affichage des dernières données enregistrées."
          }
        },
        "it": {
