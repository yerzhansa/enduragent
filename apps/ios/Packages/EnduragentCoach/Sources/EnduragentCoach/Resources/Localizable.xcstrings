    "training.response.fitDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fit quality and model terms are supplied by the provider. The desktop does not infer a model equation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor suministra la calidad del ajuste y los términos del modelo. La aplicación de escritorio no deduce una ecuación del modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La qualité de l’ajustement et les termes du modèle sont fournis par le fournisseur. L’application de bureau ne déduit aucune équation de modèle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La qualità dell’adattamento e i termini del modello sono forniti dal fornitore. L’app desktop non deduce un’equazione del modello."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anpassungsgüte und Modellterme stammen vom Anbieter. Die Desktop-App leitet keine Modellgleichung ab."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aanbieder levert de kwaliteit van de curvepassing en de modeltermen. De desktopapp leidt zelf geen modelvergelijking af."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilpasningskvalitet og modelled leveres af udbyderen. Desktopappen udleder ikke en modelligning."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Leverantören anger anpassningens kvalitet och modellens termer. Datorappen härleder ingen modellekvation."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Leverandøren oppgir tilpasningskvalitet og modellledd. Skrivebordsappen utleder ingen modelligning."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palveluntarjoaja toimittaa sovituksen laadun ja mallin termit. Työpöytäsovellus ei päättele mallin yhtälöä."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A qualidade do ajuste e os termos do modelo são fornecidos pelo fornecedor. A aplicação de computador não infere uma equação do modelo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A qualidade do ajuste e os termos do modelo são fornecidos pelo provedor. O aplicativo para computador não deduz uma equação para o modelo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakość dopasowania i składniki modelu pochodzą od dostawcy. Aplikacja komputerowa nie wyznacza równania modelu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적합도와 모델 항은 제공업체가 제공합니다. 데스크톱 앱은 모델 방정식을 추론하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近似の精度とモデルの項はプロバイダーから提供されます。デスクトップアプリでモデル式を推定することはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拟合质量和模型项由数据提供方提供。桌面应用不会推导模型方程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擬合品質與模型項均由服務供應商提供。桌面應用程式不會推導模型方程式。"
          }
        }
      }
    },
