    "training.ride.driftIntro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compares power per heartbeat in the first and second time-weighted halves. This local estimate is distinct from %#@provider@'s cleaned power/HR metric."
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara la potencia por latido entre la primera y la segunda mitad, ponderadas por tiempo. Esta estimación local es distinta de la métrica depurada de potencia/frecuencia cardiaca de %#@provider@."
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare la puissance par battement cardiaque entre la première et la seconde moitié, pondérées par le temps. Cette estimation locale est distincte de la mesure puissance/fréquence cardiaque de %#@provider@ après nettoyage des données."
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confronta la potenza per battito cardiaco nelle due metà dell’uscita, con ponderazione temporale. Questa stima locale è distinta dalla metrica potenza/FC di %#@provider@ basata su dati ripuliti."
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleicht die Leistung pro Herzschlag in der ersten und zweiten zeitgewichteten Hälfte. Diese lokale Schätzung unterscheidet sich von der bereinigten Leistungs-/Herzfrequenz-Kennzahl von %#@provider@."
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergelijkt het vermogen per hartslag tussen de eerste en tweede tijdgewogen helft. Deze lokale schatting staat los van de opgeschoonde vermogen/hartslagmeting van %#@provider@."
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammenligner effekt pr. hjerteslag i den første og anden tidsvægtede halvdel. Dette lokale estimat er adskilt fra det rensede effekt/puls-mål fra %#@provider@."
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jämför effekt per hjärtslag mellan den första och andra tidsviktade halvan. Den här lokala uppskattningen är skild från det rensade effekt-/pulsmåttet från %#@provider@."
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammenligner watt per hjerteslag i første og andre tidsvektede halvdel. Dette lokale estimatet er atskilt fra %#@provider@ sin watt/puls-verdi basert på rensede data."
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertaa tehoa sydämenlyöntiä kohti ensimmäisessä ja toisessa ajalla painotetussa puolikkaassa. Tämä paikallinen arvio on erillinen palvelun %#@provider@ puhdistetusta teho-sykemittarista."
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara a potência por batimento cardíaco na primeira e na segunda metade, ponderadas pelo tempo. Esta estimativa local é distinta da métrica de potência/FC tratada de %#@provider@."
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara a potência por batimento cardíaco na primeira e na segunda metade, ponderadas pelo tempo. Esta estimativa local é distinta da métrica de potência/frequência cardíaca com dados tratados de %#@provider@."
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porównuje moc na uderzenie serca w pierwszej i drugiej połowie, z uwzględnieniem wag czasowych. Ten lokalny szacunek różni się od wskaźnika mocy do tętna %#@provider@ opartego na oczyszczonych danych."
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간 가중치를 적용한 전반부와 후반부의 심박수 대비 파워를 비교합니다. 이 로컬 추정값은 %#@provider@에서 정제한 파워/심박수 지표와 다릅니다."
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間で重み付けした前半と後半の、心拍あたりのパワーを比較します。このコンピュータで算出する推定値は、%#@provider@がデータを整理して算出するパワー／心拍指標とは異なります。"
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按时间权重将骑行分为前后两半，对比每单位心率对应的功率。此本地估算不同于 %#@provider@ 清理数据后计算的功率/心率指标。"
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "比較依時間加權的前後半段每次心跳對應的功率。此本機估算與 %#@provider@ 清理資料後的功率／心率指標不同。"
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        }
      }
    },
