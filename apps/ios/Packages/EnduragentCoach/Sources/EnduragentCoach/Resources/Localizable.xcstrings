    "plan.view.draft.approvalDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approval activates the Plan, then updates today plus the next six days in %#@intervals@."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aprobación activa el Plan y después actualiza el día de hoy y los seis siguientes en %#@intervals@."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’approbation active le plan, puis met à jour aujourd’hui et les six jours suivants dans %#@intervals@."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’approvazione attiva il piano, poi aggiorna oggi e i sei giorni successivi in %#@intervals@."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Zustimmung aktiviert den Plan. Danach werden der heutige Tag und die nächsten sechs Tage in %#@intervals@ aktualisiert."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Goedkeuren activeert het trainingsschema en werkt daarna vandaag en de komende zes dagen bij in %#@intervals@."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Godkendelsen aktiverer træningsplanen og opdaterer derefter i dag og de næste seks dage i %#@intervals@."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du godkänner aktiveras planen. Därefter uppdateras idag och de följande sex dagarna i %#@intervals@."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Godkjenning aktiverer planen og oppdaterer deretter i dag og de neste seks dagene i %#@intervals@."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyväksyntä aktivoi suunnitelman ja päivittää sitten tämän päivän sekä seuraavat kuusi päivää palvelussa %#@intervals@."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A aprovação ativa o Plano e depois atualiza o dia de hoje e os seis dias seguintes em %#@intervals@."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A aprovação ativa o plano e depois atualiza o dia de hoje e os próximos seis dias em %#@intervals@."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatwierdzenie aktywuje plan, a następnie aktualizuje dzisiejszy dzień i sześć kolejnych dni w %#@intervals@."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인하면 계획이 활성화되고 %#@intervals@에서 오늘부터 7일간의 일정이 업데이트됩니다."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認するとプランが有効になり、%#@intervals@の今日から6日後までの予定を更新します。"
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准后将启用计划，然后更新 %#@intervals@ 中今天及接下来六天的日程。"
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "核准後將啟用計畫，接著更新 %#@intervals@ 中今天及未來六天的行事曆。"
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        }
      }
    },
