    "telegram.plan.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorry, something went wrong generating your plan. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo siento, algo ha fallado al generar tu plan. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désolé, une erreur s’est produite lors de la création de ton plan. Réessaie."
          }
        },
        "it": {
