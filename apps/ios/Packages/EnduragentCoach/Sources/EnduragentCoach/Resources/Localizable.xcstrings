          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En %#@intervals@, abre Ajustes → Ajustes de desarrollador, copia la clave de API y vuelve aquí. %#@product@ la lee sin mostrarla."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "product": {
              "argNum": 2,
              "formatSpecifier": "@"
