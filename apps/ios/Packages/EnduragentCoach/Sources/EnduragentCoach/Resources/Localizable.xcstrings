    "setup.error.intakeSaveFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your answers could not be saved. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido guardar tus respuestas. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes réponses n’ont pas pu être enregistrées. Réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare le tue risposte. Riprova."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Antworten konnten nicht gespeichert werden. Bitte versuche es erneut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je antwoorden konden niet worden opgeslagen. Probeer het opnieuw."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine svar kunne ikke gemmes. Prøv igen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina svar kunde inte sparas. Försök igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svarene dine kunne ikke lagres. Prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastauksiasi ei voitu tallentaa. Yritä uudelleen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar as tuas respostas. Tenta novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar suas respostas. Tente novamente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać twoich odpowiedzi. Spróbuj ponownie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변을 저장하지 못했습니다. 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答を保存できませんでした。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存回答。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存回答。請重試。"
          }
        }
      }
    },
    "setup.error.intervalsClipboardClearFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The API key wasn’t saved because %#@product@ couldn’t safely clear it from the clipboard. Copy it again, then try again."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha guardado la clave de API porque %#@product@ no ha podido borrarla del portapapeles de forma segura. Cópiala otra vez e inténtalo de nuevo."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé API n’a pas été enregistrée, car %#@product@ n’a pas pu l’effacer du presse-papiers en toute sécurité. Copie-la à nouveau, puis réessaie."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave API non è stata salvata perché %#@product@ non ha potuto rimuoverla in sicurezza dagli appunti. Copiala di nuovo, poi riprova."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der API-Schlüssel wurde nicht gespeichert, weil %#@product@ ihn nicht sicher aus der Zwischenablage entfernen konnte. Kopiere ihn nochmals und versuche es dann erneut."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De API-sleutel is niet opgeslagen omdat %#@product@ deze niet veilig van het klembord kon wissen. Kopieer de sleutel opnieuw en probeer het nogmaals."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "API-nøglen blev ikke gemt, fordi %#@product@ ikke kunne fjerne den sikkert fra udklipsholderen. Kopiér den igen, og prøv igen."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "API-nyckeln sparades inte eftersom %#@product@ inte kunde rensa den från urklipp på ett säkert sätt. Kopiera den igen och försök på nytt."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "API-nøkkelen ble ikke lagret fordi %#@product@ ikke kunne fjerne den fra utklippstavlen på en trygg måte. Kopier den på nytt og prøv igjen."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "API-avainta ei tallennettu, koska %#@product@ ei voinut poistaa sitä turvallisesti leikepöydältä. Kopioi se uudelleen ja yritä sitten uudelleen."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de API não foi guardada porque %#@product@ não conseguiu limpá-la da área de transferência em segurança. Copia-a novamente e volta a tentar."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de API não foi salva porque %#@product@ não conseguiu removê-la da área de transferência com segurança. Copie-a novamente e tente outra vez."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz API nie został zapisany, ponieważ %#@product@ nie mógł bezpiecznie usunąć go ze schowka. Skopiuj go ponownie i spróbuj jeszcze raz."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@product@에서 API 키를 클립보드에서 안전하게 지우지 못해 저장하지 않았습니다. 다시 복사한 후 재시도하세요."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@product@がAPIキーをクリップボードから安全に消去できなかったため、保存されませんでした。コピーし直して、もう一度お試しください。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@product@ 无法安全地从剪贴板清除 API 密钥，因此未保存。请重新复制后重试。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@product@ 無法安全地從剪貼簿清除 API 金鑰，因此未儲存。請再次複製後重試。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        }
      }
    },
