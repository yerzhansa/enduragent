    "settings.conversation.fields.timezone.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use an IANA timezone, such as %#@timezone@. %#@product@ follows this computer’s timezone until you save one here, and keeps yours after that."
          },
          "substitutions": {
            "timezone": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "product": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una zona horaria IANA, como %#@timezone@. %#@product@ usa la zona horaria de este ordenador hasta que guardes una aquí y, a partir de entonces, conserva la tuya."
          },
          "substitutions": {
            "timezone": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "product": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise un fuseau horaire IANA, comme %#@timezone@. %#@product@ suit le fuseau horaire de cet ordinateur jusqu’à ce que tu en enregistres un ici, puis conserve le tien."
          },
          "substitutions": {
            "timezone": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "product": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un fuso orario IANA, ad esempio %#@timezone@. %#@product@ segue il fuso orario di questo computer finché non ne salvi uno qui, poi mantiene quello che hai scelto."
          },
          "substitutions": {
            "timezone": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "product": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende eine IANA-Zeitzone, zum Beispiel %#@timezone@. %#@product@ verwendet die Zeitzone dieses Computers, bis du hier eine speicherst, und behält danach deine Auswahl bei."
          },
          "substitutions": {
            "timezone": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "product": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik een IANA-tijdzone, zoals %#@timezone@. %#@product@ volgt de tijdzone van deze computer totdat je er hier een opslaat en blijft daarna jouw keuze gebruiken."
          },
          "substitutions": {
            "timezone": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "product": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug en IANA-tidszone, f.eks. %#@timezone@. %#@product@ følger denne computers tidszone, indtil du gemmer en her, og beholder derefter dit valg."
          },
          "substitutions": {
            "timezone": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "product": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd en IANA-tidszon, till exempel %#@timezone@. %#@product@ följer datorns tidszon tills du sparar en här och behåller sedan ditt val."
          },
          "substitutions": {
            "timezone": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "product": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk en IANA-tidssone, som %#@timezone@. %#@product@ følger datamaskinens tidssone til du lagrer en her, og beholder deretter ditt valg."
          },
          "substitutions": {
            "timezone": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "product": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä IANA-aikavyöhykettä, esimerkiksi %#@timezone@. %#@product@ käyttää tämän tietokoneen aikavyöhykettä, kunnes tallennat tähän oman valintasi. Sen jälkeen se säilyttää valintasi."
          },
          "substitutions": {
            "timezone": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "product": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa um fuso horário IANA, como %#@timezone@. %#@product@ segue o fuso horário deste computador até guardares um aqui e mantém o teu a partir daí."
          },
          "substitutions": {
            "timezone": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "product": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um fuso horário IANA, como %#@timezone@. %#@product@ segue o fuso horário deste computador até você salvar um aqui e mantém sua escolha depois disso."
          },
          "substitutions": {
            "timezone": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "product": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj strefy czasowej IANA, np. %#@timezone@. %#@product@ korzysta ze strefy tego komputera, dopóki nie zapiszesz tutaj własnej. Potem zachowuje twój wybór."
          },
          "substitutions": {
            "timezone": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "product": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@timezone@ 등의 IANA 시간대를 사용하세요. 여기에서 저장하기 전까지 %#@product@은(는) 이 컴퓨터의 시간대를 따르며, 저장한 후에는 선택한 시간대를 유지합니다."
          },
          "substitutions": {
            "timezone": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "product": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@timezone@などのIANAタイムゾーンを使用してください。ここで保存するまでは、%#@product@はこのコンピュータのタイムゾーンに従います。保存後は指定したタイムゾーンを使い続けます。"
          },
          "substitutions": {
            "timezone": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "product": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用 IANA 时区，例如 %#@timezone@。在此保存时区前，%#@product@ 会跟随此电脑的时区；保存后将使用所设时区。"
          },
          "substitutions": {
            "timezone": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "product": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用 IANA 時區，例如 %#@timezone@。在此儲存時區前，%#@product@ 會依照此電腦的時區；儲存後則會保留您的設定。"
          },
          "substitutions": {
            "timezone": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "product": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        }
      }
    },
