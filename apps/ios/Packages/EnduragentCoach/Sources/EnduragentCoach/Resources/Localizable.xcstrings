    "training.ride.elapsedFallback": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Elapsed time used because moving time was not recorded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa el tiempo transcurrido porque no se registró el tiempo en movimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le temps écoulé est utilisé, car le temps en mouvement n’a pas été enregistré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene usato il tempo trascorso perché il tempo in movimento non è stato registrato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesamtzeit verwendet, da keine Bewegungszeit aufgezeichnet wurde."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstreken tijd gebruikt omdat de bewegingstijd niet is geregistreerd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Samlet tid er brugt, fordi tid i bevægelse ikke blev registreret."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förfluten tid används eftersom tid i rörelse inte registrerades."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Medgått tid brukes fordi tid i bevegelse ikke ble registrert."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytetään kokonaisaikaa, koska liikkeelläoloaikaa ei tallennettu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi usado o tempo decorrido porque o tempo em movimento não foi registado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo decorrido foi usado porque o tempo em movimento não foi registrado."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyto całkowitego czasu, ponieważ nie zarejestrowano czasu w ruchu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이동 시간이 기록되지 않아 경과 시간을 사용했습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動時間が記録されていないため、経過時間を使用しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未记录移动时间，已使用总经过时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未記錄移動時間，因此使用經過時間。"
          }
