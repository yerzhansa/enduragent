    "chat.planChange.restoreSummary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore the previewed future training. Completed and past training stays unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura el entrenamiento futuro de la vista previa. Los entrenamientos completados y pasados no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablir l’entraînement à venir présenté dans l’aperçu. Les entraînements terminés et passés restent inchangés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina gli allenamenti futuri mostrati nell’anteprima. Gli allenamenti completati e passati restano invariati."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle das künftige Training aus der Vorschau wieder her. Absolviertes und vergangenes Training bleibt unverändert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstel de toekomstige trainingen zoals getoond in het wijzigingsvoorbeeld. Voltooide en eerdere trainingen blijven ongewijzigd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gendan den fremtidige træning, som forhåndsvisningen viser. Gennemført og tidligere træning forbliver uændret."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Återställ den förhandsgranskade framtida träningen. Genomförd och tidigare träning är oförändrad."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjenopprett den fremtidige treningen som vises i forhåndsvisningen. Fullført og tidligere trening forblir uendret."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palauta esikatselussa näkyvä tuleva harjoittelu. Tehdyt ja menneet harjoitukset säilyvät ennallaan."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar os treinos futuros da pré-visualização. Os treinos concluídos e passados mantêm-se."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar os treinos futuros da prévia. Os treinos concluídos e passados permanecem inalterados."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywróć przyszły trening pokazany w podglądzie. Ukończone i przeszłe treningi pozostają bez zmian."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기에 표시된 향후 훈련을 복원합니다. 완료한 훈련과 과거 훈련은 변경되지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューに示した今後のトレーニングを復元します。完了済みと過去のトレーニングは変更されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复预览中的未来训练。已完成和过去的训练保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還原預覽中的未來訓練。已完成與過去的訓練維持不變。"
          }
        }
      }
    },
    "chat.planChange.reviewNotice": {
