    "plan.view.draft.replacementApprovalDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approval swaps Plans locally. New calendar writing waits for old cleanup verification."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aprobación sustituye los planes en este dispositivo. Los nuevos datos del calendario se añadirán cuando se verifique la limpieza del anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’approbation remplace les plans localement. L’ajout au calendrier attend la vérification du nettoyage de l’ancien plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’approvazione sostituisce i piani localmente. L’inserimento nel calendario attende la verifica della pulizia del vecchio piano."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Zustimmung ersetzt den Plan lokal. Neue Kalendereinträge warten, bis die Bereinigung des alten Plans bestätigt ist."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Goedkeuren vervangt het trainingsschema lokaal. Nieuwe agenda-items worden pas geschreven nadat het opschonen van de oude items is gecontroleerd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Godkendelsen udskifter træningsplanerne lokalt. Nye kalenderposter afventer bekræftet oprydning af den gamle træningsplan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du godkänner byts planerna lokalt. Inga nya kalenderposter skrivs förrän rensningen av den gamla planen har verifierats."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Godkjenning bytter planene lokalt. Nye kalenderoppføringer venter til oppryddingen etter den gamle planen er bekreftet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hyväksyntä vaihtaa suunnitelmat paikallisesti. Uuden kalenterin kirjoittaminen odottaa vanhan kalenterin siivouksen vahvistusta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A aprovação substitui os planos localmente. A escrita no novo calendário aguarda a verificação da limpeza do anterior."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A aprovação troca os planos localmente. A inclusão no calendário aguarda a verificação da limpeza do plano anterior."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatwierdzenie zastępuje plan lokalnie. Zapis nowego planu w kalendarzu czeka na weryfikację usunięcia starego."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인하면 로컬에서 계획이 교체됩니다. 새 캘린더 일정 추가는 이전 일정 정리가 확인될 때까지 대기합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認すると、このコンピュータ上でプランを置き換えます。以前の予定の削除を確認してから、新しい予定をカレンダーに書き込みます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准后将在本地替换计划。确认旧计划的日历清理完成后，才会写入新日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "核准後會在本機替換計畫。驗證舊計畫清理完成後，才會寫入新行事曆。"
          }
        }
      }
    },
    "plan.view.draft.replacementDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The old Plan ends and the replacement activates locally together. Today's workout stays. New calendar writing waits for old cleanup verification."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Plan anterior termina y el nuevo se activa a la vez en este dispositivo. El entrenamiento de hoy se conserva. Los nuevos datos del calendario se añadirán cuando se verifique la limpieza del anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ancien plan prend fin au moment où le nouveau s’active localement. L’entraînement d’aujourd’hui est conservé. L’ajout au calendrier attend la vérification du nettoyage de l’ancien plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il vecchio piano termina e quello sostitutivo si attiva localmente nello stesso momento. L’allenamento di oggi rimane. L’inserimento nel calendario attende la verifica della pulizia del vecchio piano."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der alte Plan endet und der neue wird gleichzeitig lokal aktiviert. Das heutige Training bleibt bestehen. Neue Kalendereinträge warten, bis die Bereinigung des alten Plans bestätigt ist."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het oude trainingsschema eindigt en de vervanging wordt tegelijk lokaal actief. De training van vandaag blijft staan. Nieuwe agenda-items worden pas geschreven nadat het opschonen van de oude items is gecontroleerd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den gamle træningsplan afsluttes, samtidig med at erstatningen aktiveres lokalt. Dagens træning bliver bevaret. Nye kalenderposter afventer bekræftet oprydning af den gamle træningsplan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den gamla planen avslutas samtidigt som den nya aktiveras lokalt. Dagens träningspass finns kvar. Inga nya kalenderposter skrivs förrän rensningen av den gamla planen har verifierats."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den gamle planen avsluttes samtidig som erstatningen aktiveres lokalt. Dagens treningsøkt beholdes. Nye kalenderoppføringer venter til oppryddingen etter den gamle planen er bekreftet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanha suunnitelma päättyy ja korvaava suunnitelma aktivoituu samalla paikallisesti. Tämän päivän harjoitus säilyy. Uuden kalenterin kirjoittaminen odottaa vanhan kalenterin siivouksen vahvistusta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Plano anterior termina e o novo é ativado localmente ao mesmo tempo. O treino de hoje mantém-se. A escrita no novo calendário aguarda a verificação da limpeza do anterior."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano anterior é encerrado e o substituto é ativado localmente ao mesmo tempo. O treino de hoje permanece. A inclusão no calendário aguarda a verificação da limpeza do plano anterior."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stary plan kończy się i jednocześnie nowy plan zostaje aktywowany lokalnie. Dzisiejszy trening pozostaje. Zapis nowego planu w kalendarzu czeka na weryfikację usunięcia starego."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬에서 이전 계획 종료와 새 계획 활성화가 함께 이루어집니다. 오늘의 워크아웃은 유지됩니다. 새 캘린더 일정 추가는 이전 일정 정리가 확인될 때까지 대기합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコンピュータ上で、以前のプランの終了と新しいプランの有効化を同時に行います。今日のワークアウトは残ります。以前の予定の削除を確認してから、新しい予定をカレンダーに書き込みます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧计划将结束，替代计划同时在本地启用。今天的训练课程会保留。确认旧计划的日历清理完成后，才会写入新日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舊計畫會結束，新計畫會同時在本機啟用。今天的訓練課表會保留。驗證舊計畫清理完成後，才會寫入新行事曆。"
          }
        }
      }
    },
    "plan.view.draft.replacementPendingDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It changes only after you approve this replacement Draft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo cambia cuando apruebas este borrador de sustitución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne change qu’après ton approbation de ce brouillon de remplacement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia solo dopo che approvi questa bozza sostitutiva."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er ändert sich erst, wenn du diesem Ersatzentwurf zustimmst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het verandert pas nadat je dit vervangende concept goedkeurt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den ændres først, når du godkender denne erstatningskladde."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den ändras först när du godkänner det här ersättningsutkastet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den endres først når du godkjenner dette erstatningsutkastet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muuttuu vasta, kun hyväksyt tämän korvaavan luonnoksen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só muda depois de aprovares este rascunho de substituição."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele só muda depois que você aprovar este rascunho de substituição."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmieni się dopiero po zatwierdzeniu tej wersji roboczej nowego planu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 대체 초안을 승인해야 변경됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "置き換え用の下書きを承認した後にのみ変更されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准此替代草稿后，当前计划才会改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有核准此替換草稿後，目前計畫才會變更。"
          }
        }
      }
    },
    "plan.view.draft.replacementTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace the active Plan?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Sustituir el Plan activo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacer le plan actif ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituire il piano attivo?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den aktiven Plan ersetzen?"
          }
        },
        "nl": {
