          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagrede tilgangsopplysninger er ikke tilgjengelige. Koble til og last inn på nytt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennetut tunnistautumistiedot eivät ole käytettävissä. Yhdistä ja lataa uudelleen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
