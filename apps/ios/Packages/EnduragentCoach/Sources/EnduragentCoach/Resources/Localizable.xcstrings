    "chat.planChange.feedback.previewStale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This preview is stale because the Plan or its sources changed. Request a fresh preview; no training changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta vista previa está desactualizada porque el plan o sus fuentes han cambiado. Solicita una nueva vista previa; no ha cambiado ningún entrenamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet aperçu est obsolète, car le plan ou ses sources ont changé. Demande un nouvel aperçu ; aucun entraînement n’a changé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa anteprima non è aggiornata perché il piano o le sue fonti sono cambiati. Richiedi una nuova anteprima. Nessun allenamento è cambiato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Vorschau ist veraltet, weil sich der Plan oder seine Quellen geändert haben. Fordere eine neue Vorschau an; kein Training wurde geändert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit wijzigingsvoorbeeld is verouderd doordat het trainingsschema of de bronnen zijn gewijzigd. Vraag een nieuw wijzigingsvoorbeeld aan. Er is geen training gewijzigd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne forhåndsvisning er forældet, fordi træningsplanen eller dens kilder er ændret. Bed om en ny forhåndsvisning. Ingen træning er ændret."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förhandsgranskningen är inaktuell eftersom planen eller dess källor har ändrats. Begär en ny förhandsgranskning. Ingen träning har ändrats."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne forhåndsvisningen er utdatert fordi planen eller kildene er endret. Be om en ny forhåndsvisning. Ingen trening er endret."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä esikatselu on vanhentunut, koska suunnitelma tai sen lähteet muuttuivat. Pyydä uusi esikatselu. Harjoittelu ei muuttunut."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pré-visualização está desatualizada porque o plano ou as suas fontes mudaram. Pede uma nova pré-visualização; nenhum treino mudou."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta prévia está desatualizada porque o plano ou as suas fontes mudaram. Peça uma nova prévia; nenhum treino mudou."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten podgląd jest nieaktualny, ponieważ plan lub jego źródła się zmieniły. Poproś o nowy podgląd. Trening pozostał bez zmian."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계획 또는 출처가 변경되어 이 미리보기가 오래되었습니다. 새 미리보기를 요청하세요. 훈련은 변경되지 않았습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プランまたはその参照元が変更されたため、このプレビューは古くなっています。新しいプレビューを取得してください。トレーニングは変更されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计划或其来源已发生变化，此预览已过期。请重新请求预览，训练未改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計畫或其來源已發生變更，此預覽已過期。請重新請求預覽，訓練未變更。"
          }
        }
      }
    },
    "chat.planChange.feedback.previewUncertain": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The preview result could not be confirmed. The Plan library will show the current state after refresh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar el resultado de la vista previa. La biblioteca de planes mostrará el estado actual al actualizarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat de l’aperçu n’a pas pu être confirmé. La bibliothèque de plans affichera l’état actuel après actualisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile confermare l’esito dell’anteprima. La raccolta dei piani mostrerà lo stato attuale dopo l’aggiornamento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis der Vorschau konnte nicht bestätigt werden. Die Planbibliothek zeigt nach dem Aktualisieren den aktuellen Stand."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het resultaat van het wijzigingsvoorbeeld kon niet worden bevestigd. Na het vernieuwen toont de bibliotheek in Plan de huidige status."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultatet af forhåndsvisningen kunne ikke bekræftes. Biblioteket i Plan viser den aktuelle status efter genindlæsning."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultatet av förhandsgranskningen kunde inte bekräftas. Planbiblioteket visar det aktuella läget efter uppdatering."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultatet av forhåndsvisningen kunne ikke bekreftes. Planbiblioteket viser gjeldende status etter oppdatering."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Esikatselun tulosta ei voitu vahvistaa. Suunnitelmakirjasto näyttää nykyisen tilan päivityksen jälkeen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar o resultado da pré-visualização. A biblioteca de planos mostrará o estado atual após a atualização."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar o resultado da prévia. A biblioteca de planos mostrará o estado atual após a atualização."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się potwierdzić wyniku podglądu. Biblioteka planów pokaże bieżący stan po odświeżeniu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기 결과를 확인하지 못했습니다. 계획 라이브러리를 새로고침하면 현재 상태가 표시됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューの結果を確認できませんでした。プランライブラリを更新すると現在の状態が表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认预览结果。刷新后，计划库将显示当前状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認預覽結果。重新整理後，計畫庫將顯示目前狀態。"
          }
        }
      }
    },
    "chat.planChange.feedback.raceWindowNotApplied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only training reductions are allowed in the current race window. This Change was not applied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante el periodo actual de competición solo se permite reducir el entrenamiento. No se ha aplicado este cambio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les réductions d’entraînement sont autorisées dans la période actuelle autour de la course. Cette modification n’a pas été appliquée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel periodo di gara attuale sono consentite solo riduzioni degli allenamenti. Questa modifica non è stata applicata."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im aktuellen Wettkampfzeitraum sind nur Trainingsreduzierungen erlaubt. Diese Änderung wurde nicht angewendet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de huidige periode rond de wedstrijd mag je alleen minder trainen. Deze wijziging is niet toegepast."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I den aktuelle periode omkring konkurrencen er det kun tilladt at reducere træningen. Denne ændring blev ikke anvendt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Under den aktuella tävlingsperioden får träningen bara minskas. Ändringen tillämpades inte."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare redusert trening er tillatt i denne konkurranseperioden. Denne endringen ble ikke tatt i bruk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tällä kilpailujaksolla sallitaan vain harjoittelun vähentäminen. Tätä muutosta ei otettu käyttöön."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só são permitidas reduções de treino no período atual em torno da prova. Esta alteração não foi aplicada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só são permitidas reduções de treinamento no período atual em torno da prova. Esta alteração não foi aplicada."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W bieżącym okresie wokół zawodów można tylko ograniczać trening. Tej zmiany nie zastosowano."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 대회 관련 기간에는 훈련을 줄이는 변경만 허용됩니다. 이 변경은 적용되지 않았습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のレース期間中は、トレーニングを減らす変更のみ可能です。この変更は適用されませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前比赛时段内只允许减少训练。未应用此更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前比賽期間內只允許減少訓練。未套用此變更。"
          }
        }
      }
    },
