            "value": "Toegangsgegevens lokaal verwijderd. De huidige status kon niet worden vernieuwd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgangsoplysninger slettet lokalt. Den aktuelle status kunne ikke opdateres."
          }
        },
        "sv": {
