          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 %#@telegram@ 사용자가 저장되었을 수 있지만 %#@product@에서 저장소를 확인하지 못했습니다. %#@product@을(를) 다시 시작하고 %#@telegram@을(를) 확인한 후 다시 페어링하세요."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "product": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@telegram@のメインユーザーは保存された可能性がありますが、%#@product@はストレージを検証できませんでした。%#@product@を再起動して%#@telegram@を確認してから、ペアリングをやり直してください。"
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
