        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueia o teu porta-chaves de início de sessão fora de %#@product@ e escolhe Tentar novamente."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
