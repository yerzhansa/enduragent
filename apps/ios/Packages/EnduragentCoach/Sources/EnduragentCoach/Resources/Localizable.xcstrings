    "coach.proposal.savePlan": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the training plan — replaces the current saved plan"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar el plan de entrenamiento. Sustituye al plan guardado actual"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer le plan d’entraînement — remplace le plan actuellement enregistré"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva il piano di allenamento. Sostituisce il piano attualmente salvato"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trainingsplan speichern. Ersetzt den aktuell gespeicherten Plan"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het trainingsschema opslaan. Dit vervangt het huidige opgeslagen schema"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem træningsplanen — erstatter den nuværende gemte plan"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara träningsplanen. Den ersätter den nuvarande sparade planen"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagre treningsplanen — erstatter den lagrede planen"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna harjoitussuunnitelma. Tämä korvaa nykyisen tallennetun suunnitelman"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar o plano de treino. Substitui o plano atualmente guardado"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar o plano de treinamento. Substitui o plano salvo atual"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz plan treningowy — zastąpi obecnie zapisany plan"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "훈련 계획 저장. 현재 저장된 계획을 대체합니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トレーニングプランを保存。現在保存されているプランを置き換えます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存训练计划，将替换当前已保存的计划"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存訓練計畫，將取代目前已儲存的計畫"
          }
        }
      }
    },
