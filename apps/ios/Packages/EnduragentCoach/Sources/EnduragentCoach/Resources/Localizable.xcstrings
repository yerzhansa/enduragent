    "plan.view.ended.outcomeSavedDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The race outcome is saved separately from the ended Plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado de la carrera se guarda por separado del Plan terminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat de la course est enregistré séparément du plan terminé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’esito della gara viene salvato separatamente dal piano terminato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Rennergebnis wird getrennt vom beendeten Plan gespeichert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De afloop van de wedstrijd is apart van het beëindigde trainingsschema opgeslagen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Konkurrencens udfald gemmes separat fra den afsluttede træningsplan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tävlingsutfallet sparas separat från den avslutade planen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Konkurransens utfall lagres separat fra den avsluttede planen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilpailun lopputulos tallennetaan erillään päättyneestä suunnitelmasta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O desfecho da prova é guardado separadamente do Plano terminado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O desfecho da prova é salvo separadamente do plano encerrado."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezultat wyścigu jest zapisany oddzielnie od zakończonego planu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대회 결과는 종료된 계획과 별도로 저장됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レースの結果は、終了したプランとは別に保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比赛完成情况已单独保存，与已结束的计划分开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "比賽成果已與結束的計畫分開儲存。"
          }
        }
      }
    },
