    "archive.empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No past conversations yet. Starting a new conversation keeps the old one here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay conversaciones anteriores. Al iniciar una nueva conversación, la anterior se guarda aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune conversation passée pour le moment. Quand tu démarres une nouvelle conversation, l’ancienne est conservée ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono ancora conversazioni passate. Quando inizi una nuova conversazione, quella precedente viene conservata qui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine früheren Gespräche. Wenn du ein neues Gespräch beginnst, bleibt das alte hier erhalten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen eerdere gesprekken. Als je een nieuw gesprek begint, blijft het oude hier bewaard."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen tidligere samtaler endnu. Når du starter en ny samtale, bliver den gamle gemt her."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga tidigare samtal än. När du startar ett nytt samtal sparas det gamla här."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen tidligere samtaler ennå. Når du starter en ny samtale, beholdes den gamle her."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä aiempia keskusteluja. Kun aloitat uuden keskustelun, vanha säilyy täällä."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há conversas anteriores. Ao iniciares uma nova conversa, a anterior fica aqui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há conversas anteriores. Ao iniciar uma nova conversa, a anterior fica aqui."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze wcześniejszych rozmów. Gdy rozpoczniesz nową rozmowę, poprzednia zostanie zachowana tutaj."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 이전 대화가 없습니다. 새 대화를 시작하면 기존 대화가 여기에 보관됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去の会話はまだありません。新しい会話を始めると、以前の会話がここに保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无历史对话。开始新对话后，原对话会保留在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無過往對話。開始新對話後，舊對話會保留在這裡。"
          }
        }
      }
    },
    "archive.emptyConversation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This conversation has no readable messages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conversación no tiene mensajes legibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
