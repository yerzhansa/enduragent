        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Główny użytkownik %#@telegram@ mógł zostać zapisany, ale %#@product@ nie mógł zweryfikować magazynu. Uruchom ponownie %#@product@ i sprawdź %#@telegram@ przed ponownym parowaniem."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "product": {
              "argNum": 2,
              "formatSpecifier": "@"
