    "plan.view.active.revisionPrompt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I’ll keep the active Plan unchanged while we revise this Proposal. What should change?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantendré el Plan activo sin cambios mientras revisamos esta propuesta. ¿Qué quieres cambiar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je garde le plan actif inchangé pendant que nous révisons cette proposition. Que faut-il changer ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Manterrò invariato il piano attivo mentre rivediamo questa proposta. Cosa vuoi cambiare?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich lasse den aktiven Plan unverändert, während wir diesen Vorschlag überarbeiten. Was soll sich ändern?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik laat het actieve trainingsschema ongewijzigd terwijl we dit voorstel herzien. Wat moet er veranderen?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg beholder den aktive træningsplan uændret, mens vi redigerer dette forslag. Hvad skal ændres?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag låter den aktiva planen vara oförändrad medan vi ändrar det här förslaget. Vad ska ändras?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg lar den aktive planen være uendret mens vi reviderer dette forslaget. Hva skal endres?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidän aktiivisen suunnitelman ennallaan, kun muokkaamme tätä ehdotusta. Mitä pitäisi muuttaa?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Vou manter o Plano ativo enquanto revemos esta proposta. O que queres alterar?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vou manter o plano ativo inalterado enquanto revisamos esta proposta. O que deve mudar?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowam aktywny plan bez zmian, gdy będziemy poprawiać tę propozycję. Co zmienić?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 제안을 수정하는 동안 활성 계획은 그대로 유지하겠습니다. 무엇을 변경할까요?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この提案を修正している間、有効なプランは変更しません。何を変更しますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改此方案期间，当前启用的计划将保持不变。需要更改什么？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "修改此提案期間，我會保留進行中的計畫。想變更哪些內容？"
          }
        }
      }
    },
