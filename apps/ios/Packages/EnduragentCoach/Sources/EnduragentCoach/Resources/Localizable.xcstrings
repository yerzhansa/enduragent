          "stringUnit": {
            "state": "translated",
            "value": "이벤트 목표는 여전히 %#@value1@입니다. 이벤트까지 24주 이내로 남으면 이벤트 준비를 위한 새 계획을 시작하세요."
          },
          "substitutions": {
            "value1": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イベントの目標は引き続き%#@value1@です。イベントまで24週間以内になったら、準備のための新しいプランを開始してください。"
          },
          "substitutions": {
            "value1": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "赛事目标仍为 %#@value1@。距离赛事不超过 24 周时，可开始新的备赛计划。"
          },
          "substitutions": {
            "value1": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "賽事目標仍為 %#@value1@。距離賽事 24 週內時，可開始新的計畫來備賽。"
          },
          "substitutions": {
