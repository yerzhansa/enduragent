          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan zakończy się teraz. Dzisiejszy trening pozostaje, a treningi %#@product@ od jutra zostaną usunięte z %#@intervals@."
          },
          "substitutions": {
