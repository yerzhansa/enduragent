    "telegram.pairing.shell": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "from a shell on the host where the bot runs, then send your message again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "desde un terminal en el equipo donde se ejecuta el bot y vuelve a enviar tu mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "dans un terminal sur la machine où fonctionne le bot, puis renvoie ton message."
          }
        },
