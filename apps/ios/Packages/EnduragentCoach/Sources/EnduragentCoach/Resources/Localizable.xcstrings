    "training.ride.unavailable.activityTooShort": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least 30 usable minutes, with 15 minutes in each half, are required."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesitan al menos 30 minutos utilizables, con 15 minutos en cada mitad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faut au moins 30 minutes exploitables, dont 15 minutes dans chaque moitié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Servono almeno 30 minuti utilizzabili, con 15 minuti in ciascuna metà."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benötigt werden mindestens 30 nutzbare Minuten, davon 15 Minuten in jeder Hälfte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn minstens 30 bruikbare minuten nodig, met 15 minuten in elke helft."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der kræves mindst 30 brugbare minutter med 15 minutter i hver halvdel."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Minst 30 användbara minuter krävs, med 15 minuter i varje halva."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det kreves minst 30 brukbare minutter, med 15 minutter i hver halvdel."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarvitaan vähintään 30 käyttökelpoista minuuttia, 15 minuuttia kummassakin puolikkaassa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "São necessários pelo menos 30 minutos utilizáveis, com 15 minutos em cada metade."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "São necessários pelo menos 30 minutos utilizáveis, com 15 minutos em cada metade."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymagane jest co najmniej 30 minut nadających się do analizy, po 15 minut w każdej połowie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 가능한 시간이 최소 30분이며 전반부와 후반부에 각각 15분 이상 있어야 합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前半と後半に各15分、合計30分以上の利用可能なデータが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要至少 30 分钟可用数据，且前后半程各不少于 15 分钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "至少需要 30 分鐘的可用資料，前後半段各需 15 分鐘。"
          }
        }
      }
    },
    "training.ride.unavailable.ambiguousSource": {
