    "settings.athlete.validation.athleteWhitespace": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Athlete IDs cannot begin or end with whitespace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ID de deportista no pueden empezar ni terminar con espacios en blanco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les identifiants d’athlète ne peuvent pas commencer ou se terminer par des espaces."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli ID atleta non possono iniziare o terminare con spazi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Athleten-IDs dürfen nicht mit Leerraum beginnen oder enden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Atleet-ID's mogen niet beginnen of eindigen met witruimte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Atlet-ID'er må ikke begynde eller slutte med blanktegn."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Idrotts-ID får inte börja eller sluta med blanktecken."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utøver-ID-er kan ikke begynne eller slutte med blanktegn."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Urheilijatunnuksen alussa tai lopussa ei saa olla tyhjemerkkejä."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os IDs de atleta não podem começar nem terminar com espaços em branco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "IDs de atleta não podem começar nem terminar com espaços em branco."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Identyfikatory sportowca nie mogą zaczynać się ani kończyć białymi znakami."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선수 ID의 시작이나 끝에는 공백을 사용할 수 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アスリートIDの先頭と末尾に空白は使用できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运动员 ID 的开头和结尾不能有空白字符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "運動員 ID 的開頭與結尾不可有空白。"
          }
        }
      }
    },
    "settings.athlete.verificationPending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifying the connected training account… Training data stays paused until it completes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificando la cuenta de entrenamiento conectada… Los datos de entrenamiento siguen en pausa hasta que termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification du compte d’entraînement connecté… Les données d’entraînement restent en pause jusqu’à la fin de la vérification."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica dell’account di allenamento collegato… I dati di allenamento restano in pausa fino al completamento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das verbundene Trainingskonto wird überprüft… Die Trainingsdaten bleiben bis zum Abschluss pausiert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het gekoppelde trainingsaccount verifiëren… Trainingsgegevens blijven gepauzeerd totdat dit is voltooid."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekræfter den tilknyttede træningskonto… Træningsdata forbliver sat på pause, indtil det er fuldført."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifierar det anslutna träningskontot… Träningsdata förblir pausade tills verifieringen är klar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekrefter den tilkoblede treningskontoen… Treningsdata er satt på pause til dette er fullført."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vahvistetaan yhdistettyä harjoittelutiliä… Harjoitustietojen käsittely pysyy keskeytettynä vahvistuksen valmistumiseen asti."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A verificar a conta de treino ligada… Os dados de treino ficam em pausa até a verificação terminar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificando a conta de treinamento conectada… Os dados de treinamento ficam pausados até a conclusão."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weryfikowanie połączonego konta treningowego… Dane treningowe pozostają wstrzymane do zakończenia weryfikacji."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 훈련 계정 확인 중… 완료될 때까지 훈련 데이터 처리가 일시 중지됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続中のトレーニングアカウントを確認中… 完了するまでトレーニングデータの処理は一時停止されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在验证已连接的训练账号… 验证完成前，训练数据将保持暂停状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在驗證已連結的訓練帳號… 完成前會暫停訓練資料。"
          }
        }
      }
    },
