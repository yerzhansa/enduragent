    "telegram.session.resetCaveat": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: I couldn't fully reset our previous session, so some earlier context may still apply."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso: no he podido reiniciar por completo nuestra sesión anterior, así que puede que aún se use parte del contexto previo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À noter : je n’ai pas pu réinitialiser entièrement notre conversation précédente. Une partie de son contexte peut donc encore s’appliquer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota: non ho potuto azzerare del tutto la sessione precedente, quindi parte del contesto passato potrebbe ancora essere usata."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweis: Ich konnte unser vorheriges Gespräch nicht vollständig zurücksetzen. Einige frühere Informationen können daher weiterhin einfließen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Let op: ik kon onze vorige sessie niet volledig opnieuw instellen. Daardoor kan eerdere context nog van toepassing zijn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bemærk: Jeg kunne ikke nulstille vores forrige samtale helt, så noget tidligere kontekst kan stadig være med."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Obs! Jag kunde inte återställa vår tidigare session helt, så en del tidigare sammanhang kan finnas kvar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Merk: Jeg kunne ikke nullstille hele den forrige samtalen vår, så noe av den tidligere konteksten kan fortsatt gjelde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Huomaa: en voinut nollata edellistä keskusteluamme kokonaan, joten osa sen sisällöstä voi edelleen vaikuttaa vastauksiini."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota: não consegui reiniciar completamente a nossa conversa anterior, por isso algum contexto anterior pode continuar a aplicar-se."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota: não consegui reiniciar completamente nossa conversa anterior, então algum contexto anterior pode continuar se aplicando."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwaga: nie udało mi się w pełni zresetować poprzedniej sesji, więc część wcześniejszego kontekstu może nadal być używana."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 대화를 완전히 초기화하지 못해 일부 내용이 아직 반영될 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前の会話を完全にはリセットできなかったため、その内容が一部引き継がれる場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒一下：未能完全重置之前的对话，部分先前内容可能仍会影响回复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒一下：未能完全重設先前的對話，部分先前內容可能仍會影響回覆。"
          }
        }
      }
    },
    "telegram.session.resetFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong resetting your session — your history is untouched. Please try %#@command@ again."
          },
          "substitutions": {
            "command": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo ha fallado al reiniciar tu sesión. Tu historial sigue intacto. Prueba %#@command@ de nuevo."
          },
          "substitutions": {
            "command": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une erreur s’est produite lors de la réinitialisation de ta conversation — ton historique est intact. Réessaie %#@command@."
          },
          "substitutions": {
            "command": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa è andato storto nel reimpostare la sessione. La cronologia è intatta. Riprova con %#@command@."
          },
          "substitutions": {
            "command": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Zurücksetzen deines Gesprächs ist etwas schiefgelaufen. Dein Verlauf ist unverändert. Versuche %#@command@ bitte erneut."
          },
          "substitutions": {
            "command": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is iets misgegaan bij het opnieuw instellen van je sessie. Je geschiedenis is ongewijzigd. Probeer %#@command@ opnieuw."
          },
          "substitutions": {
            "command": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noget gik galt under nulstillingen af din samtale — din historik er uændret. Prøv %#@command@ igen."
          },
          "substitutions": {
            "command": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Något gick fel när sessionen skulle återställas. Din historik är orörd. Försök med %#@command@ igen."
          },
          "substitutions": {
            "command": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noe gikk galt da jeg nullstilte samtalen din — historikken er uendret. Prøv %#@command@ igjen."
          },
          "substitutions": {
            "command": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskustelun nollaamisessa meni jokin pieleen. Historiasi säilyy ennallaan. Yritä komentoa %#@command@ uudelleen."
          },
          "substitutions": {
            "command": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
