          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppel het trainingsaccount in Configuratie voordat je de atleet-ID opslaat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
