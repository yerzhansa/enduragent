    "desktop.lifecycle.unavailableContent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The background service could not start or its saved connection state could not be read. Quit %#@product@ and reopen it. If the problem continues, %#@restartComputer@ before trying again."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "restartComputer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar el servicio en segundo plano o leer su estado de conexión guardado. Cierra %#@product@ y vuelve a abrirlo. Si el problema continúa, %#@restartComputer@ antes de volver a intentarlo."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "restartComputer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service en arrière-plan n'a pas pu démarrer ou son état de connexion enregistré n'a pas pu être lu. Quitte %#@product@ et rouvre-le. Si le problème persiste, %#@restartComputer@ avant de réessayer."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "restartComputer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile avviare il servizio in background o leggere lo stato di connessione salvato. Chiudi %#@product@ e riaprilo. Se il problema persiste, %#@restartComputer@ prima di riprovare."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "restartComputer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hintergrunddienst konnte nicht gestartet oder sein gespeicherter Verbindungsstatus nicht gelesen werden. Beende %#@product@ und öffne es erneut. Wenn das Problem weiterhin besteht, %#@restartComputer@, bevor du es erneut versuchst."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "restartComputer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De achtergrondservice kon niet starten of de opgeslagen verbindingsstatus kon niet worden gelezen. Sluit %#@product@ af en open het opnieuw. Blijft het probleem bestaan, %#@restartComputer@ voordat je het opnieuw probeert."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "restartComputer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Baggrundstjenesten kunne ikke starte, eller dens gemte forbindelsestilstand kunne ikke læses. Afslut %#@product@, og åbn det igen. Hvis problemet fortsætter, så %#@restartComputer@, før du prøver igen."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "restartComputer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakgrundstjänsten kunde inte starta eller så gick det inte att läsa dess sparade anslutningstillstånd. Avsluta %#@product@ och öppna det igen. Om problemet kvarstår, %#@restartComputer@ innan du försöker igen."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "restartComputer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakgrunnstjenesten kunne ikke starte, eller den lagrede tilkoblingstilstanden kunne ikke leses. Avslutt %#@product@, og åpne det på nytt. Hvis problemet fortsetter, %#@restartComputer@ før du prøver igjen."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "restartComputer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taustapalvelu ei käynnistynyt tai sen tallennettua yhteystilaa ei voitu lukea. Lopeta %#@product@ ja avaa se uudelleen. Jos ongelma jatkuu, %#@restartComputer@ ennen uutta yritystä."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "restartComputer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar o serviço em segundo plano ou ler o estado da ligação guardado. Encerra %#@product@ e volta a abri-lo. Se o problema continuar, %#@restartComputer@ antes de tentares novamente."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "restartComputer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar o serviço em segundo plano ou ler o estado salvo da conexão. Encerre %#@product@ e reabra o aplicativo. Se o problema continuar, %#@restartComputer@ antes de tentar novamente."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "restartComputer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się uruchomić usługi w tle lub odczytać zapisanego stanu jej połączenia. Zamknij %#@product@ i otwórz go ponownie. Jeśli problem nadal występuje, %#@restartComputer@ przed kolejną próbą."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "restartComputer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드 서비스를 시작하지 못했거나 저장된 연결 상태를 읽지 못했습니다. %#@product@을(를) 종료하고 다시 여세요. 문제가 계속되면 %#@restartComputer@ 후 다시 시도하세요."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "restartComputer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドサービスを起動できなかったか、保存された接続状態を読み取れませんでした。%#@product@を終了して開き直してください。問題が続く場合は、%#@restartComputer@から、もう一度お試しください。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "restartComputer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
