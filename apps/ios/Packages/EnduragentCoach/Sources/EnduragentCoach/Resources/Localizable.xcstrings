          "stringUnit": {
            "state": "translated",
            "value": "Já está atualizado. Não foram encontrados novos dados de treino."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já está atualizado. Nenhum dado novo de treinamento foi encontrado."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane są już aktualne — nie znaleziono nowych danych treningowych."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 최신 상태입니다. 새 훈련 데이터가 없습니다."
