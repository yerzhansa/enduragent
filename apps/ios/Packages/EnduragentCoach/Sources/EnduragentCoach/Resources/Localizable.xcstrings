    "plan.view.planningRequestDateConflict.conflictDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose another date by default, or explicitly replace a future coach-owned Workout."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige otra fecha como opción predeterminada o decide expresamente sustituir un entrenamiento futuro gestionado por el entrenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis de préférence une autre date, ou remplace explicitement un entraînement à venir géré par le coach."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scelta predefinita è un’altra data; in alternativa, scegli esplicitamente di sostituire un allenamento futuro gestito dal coach."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle normalerweise ein anderes Datum oder ersetze ausdrücklich ein künftiges, vom Coach verwaltetes Training."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies bij voorkeur een andere datum, of vervang uitdrukkelijk een toekomstige training die door de coach wordt beheerd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg som udgangspunkt en anden dato, eller vælg udtrykkeligt at erstatte en fremtidig træning, som styres af træneren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj i första hand ett annat datum, eller välj uttryckligen att ersätta ett framtida träningspass som hanteras av tränaren."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg som standard en annen dato, eller velg uttrykkelig å erstatte en fremtidig treningsøkt som styres av treneren."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse ensisijaisesti toinen päivämäärä tai päätä erikseen korvata tuleva, valmentajan hallinnassa oleva harjoitus."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe outra data como opção padrão ou substitui explicitamente um treino futuro gerido pelo treinador."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefira outra data ou escolha explicitamente substituir um treino futuro gerenciado pelo treinador."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domyślnie wybierz inną datę lub wyraźnie zdecyduj o zastąpieniu przyszłego treningu zarządzanego przez trenera."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본적으로 다른 날짜를 선택하세요. 또는 코치가 관리하는 향후 워크아웃을 명시적으로 선택하여 대체하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常は別の日付を選んでください。今後のコーチ管理のワークアウトを置き換える場合は、明示的に選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
