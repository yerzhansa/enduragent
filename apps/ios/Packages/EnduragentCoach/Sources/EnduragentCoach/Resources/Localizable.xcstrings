    "settings.telegram.sender.loadFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed users could not be loaded. %#@product@ will try again automatically."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido cargar los usuarios autorizados. %#@product@ lo intentará de nuevo automáticamente."
          },
          "substitutions": {
            "product": {
