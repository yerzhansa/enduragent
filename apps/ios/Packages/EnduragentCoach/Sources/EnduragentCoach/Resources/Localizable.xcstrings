        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明日以降のプランのワークアウトを確認している間、今日のワークアウトは残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查从明天起的计划训练课程期间，今天的训练课程会保留。"
          }
