    "training.response.distributionAxisHeartRate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Horizontal position is heart rate; bar height is accumulated ride time. Gaps are left as recorded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La posición horizontal indica la frecuencia cardiaca; la altura de las barras, el tiempo acumulado de la salida. Los huecos se conservan tal como se registraron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La position horizontale indique la fréquence cardiaque ; la hauteur des barres indique le temps de sortie cumulé. Les lacunes de l’enregistrement sont conservées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La posizione orizzontale indica la frequenza cardiaca; l’altezza delle barre indica il tempo accumulato in sella. Le lacune restano come registrate."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die horizontale Position zeigt die Herzfrequenz, die Balkenhöhe die aufsummierte Fahrzeit. Lücken bleiben wie aufgezeichnet bestehen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De horizontale positie geeft de hartslag weer. De balkhoogte geeft de opgetelde rijtijd weer. Gaten blijven zoals geregistreerd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den vandrette position viser puls. Søjlehøjden viser samlet køretid. Huller bevares som registreret."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den vågräta axeln visar puls och staplarnas höjd visar sammanlagd cykeltid. Luckor visas som de registrerades."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vannrett posisjon viser puls. Søylehøyden viser samlet turtid. Hull i registreringen beholdes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaaka-akseli kuvaa sykettä ja pylvään korkeus kertynyttä ajoaikaa. Aukot säilyvät tallennetun mukaisina."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A posição horizontal representa a frequência cardíaca; a altura das barras representa o tempo acumulado da volta. As lacunas mantêm-se conforme registadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A posição horizontal indica a frequência cardíaca; a altura das barras indica o tempo acumulado da pedalada. As lacunas são mantidas como registradas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Położenie w poziomie oznacza tętno. Wysokość słupka oznacza łączny czas jazdy. Luki pozostają zgodne z zapisem."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가로 위치는 심박수, 막대 높이는 누적 라이딩 시간입니다. 데이터가 없는 부분은 기록된 그대로 둡니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "横軸は心拍数、棒の高さはライド時間の合計です。欠測部分はそのまま表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "横轴表示心率，柱高表示累计骑行时间。数据空缺按原始记录保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "橫軸為心率，長條高度為累計騎乘時間。資料缺口保留原樣。"
          }
        }
      }
    },
