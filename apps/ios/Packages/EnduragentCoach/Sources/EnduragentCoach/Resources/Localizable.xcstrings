        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mallien nimissä ei voi olla ohjausmerkkejä."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os nomes de modelos não podem conter carateres de controlo."
