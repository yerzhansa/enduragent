          "stringUnit": {
            "state": "translated",
            "value": "無法儲存運動員 ID。編輯內容仍保留在這裡。"
          }
        }
      }
    },
    "settings.athlete.error.runtimeUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current training account couldn’t be reloaded. Your edit is still here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
