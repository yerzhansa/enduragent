    "training.ride.unavailable.duplicateStream": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplicate sensor streams prevent a reliable comparison."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las series de datos de sensores duplicadas impiden una comparación fiable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des séries de données de capteurs en double empêchent une comparaison fiable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serie duplicate di dati dei sensori impediscono un confronto attendibile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppelte Sensormessreihen verhindern einen zuverlässigen Vergleich."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dubbele sensorgegevensreeksen verhinderen een betrouwbare vergelijking."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dublerede sensordataserier forhindrer en pålidelig sammenligning."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dubbla sensordataserier hindrar en tillförlitlig jämförelse."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dupliserte dataserier fra sensorer hindrer en pålitelig sammenligning."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päällekkäiset anturien aikasarjat estävät luotettavan vertailun."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As séries de dados de sensores duplicadas impedem uma comparação fiável."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Séries de dados de sensores duplicadas impedem uma comparação confiável."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zduplikowane strumienie danych czujników uniemożliwiają wiarygodne porównanie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "센서 시계열 데이터가 중복되어 신뢰할 수 있는 비교가 불가능합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "センサーの時系列データが重複しているため、信頼できる比較ができません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "传感器数据流重复，无法可靠对比。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重複的感測器資料串流導致無法可靠比較。"
          }
        }
      }
    },
    "training.ride.unavailable.insufficientCoverage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Less than 80%% of the ride has usable power and heart-rate coverage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos del 80%% de la salida tiene datos utilizables de potencia y frecuencia cardiaca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moins de 80 %% de la sortie dispose de données exploitables de puissance et de fréquence cardiaque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Meno dell’80%% dell’uscita ha dati utilizzabili di potenza e frequenza cardiaca."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für weniger als 80%% der Fahrt liegen nutzbare Leistungs- und Herzfrequenzdaten vor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minder dan 80%% van de rit bevat bruikbare vermogens- en hartslaggegevens."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindre end 80 %% af turen har brugbare effekt- og pulsdata."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindre än 80 %% av cykelturen har användbar effekt- och pulsdata."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Under 80%% av turen har brukbare watt- og pulsdata."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle 80 %% lenkistä sisältää käyttökelpoista teho- ja syketietoa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos de 80%% da volta tem dados utilizáveis de potência e frequência cardíaca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos de 80%% da pedalada tem cobertura utilizável de potência e frequência cardíaca."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mniej niż 80%% przejazdu ma dane mocy i tętna nadające się do analizy."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 가능한 파워 및 심박수 데이터가 라이딩의 80%% 미만입니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用可能なパワーと心拍データがあるのは、ライドの80%%未満です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "骑行中可用功率和心率数据的覆盖率不足 80%%。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可用的功率與心率資料涵蓋不到騎乘時間的 80%%。"
          }
        }
      }
    },
    "training.ride.unavailable.invalidTimestamps": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ride timeline contains invalid timestamps or a long recording gap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronología de la salida contiene marcas de tiempo no válidas o una interrupción larga en el registro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La chronologie de la sortie contient des horodatages invalides ou une longue interruption de l’enregistrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sequenza temporale dell’uscita contiene riferimenti temporali non validi o una lunga interruzione nella registrazione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
