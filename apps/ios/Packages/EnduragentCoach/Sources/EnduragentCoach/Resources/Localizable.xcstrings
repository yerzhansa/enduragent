    "plan.view.active.endConfirmationDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Plan ends now. Today's workout stays, and tomorrow-onward %#@product@ workouts are removed from %#@intervals@."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "intervals": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Plan termina ahora. El entrenamiento de hoy se conserva y los entrenamientos de %#@product@ a partir de mañana se eliminan de %#@intervals@."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "intervals": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plan prend fin maintenant. L’entraînement d’aujourd’hui est conservé et les entraînements %#@product@ prévus à partir de demain sont supprimés de %#@intervals@."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "intervals": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il piano termina ora. L’allenamento di oggi rimane e gli allenamenti di %#@product@ da domani in poi vengono rimossi da %#@intervals@."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "intervals": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Plan endet jetzt. Das heutige Training bleibt bestehen. Ab morgen geplante Trainings von %#@product@ werden aus %#@intervals@ entfernt."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "intervals": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het trainingsschema eindigt nu. De training van vandaag blijft staan. Vanaf morgen worden trainingen van %#@product@ uit %#@intervals@ verwijderd."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "intervals": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træningsplanen afsluttes nu. Dagens træning bliver bevaret, og %#@product@-træninger fra i morgen og frem fjernes fra %#@intervals@."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "intervals": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Planen avslutas nu. Dagens träningspass finns kvar, och träningspass från %#@product@ från och med imorgon tas bort från %#@intervals@."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "intervals": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Planen avsluttes nå. Dagens treningsøkt beholdes, og %#@product@-treningsøkter fra i morgen og fremover fjernes fra %#@intervals@."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "intervals": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suunnitelma päättyy nyt. Tämän päivän harjoitus säilyy, ja sovelluksen %#@product@ harjoitukset huomisesta eteenpäin poistetaan palvelusta %#@intervals@."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "intervals": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Plano termina agora. O treino de hoje mantém-se e os treinos de %#@product@ a partir de amanhã são removidos de %#@intervals@."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "intervals": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano termina agora. O treino de hoje permanece, e os treinos de %#@product@ a partir de amanhã são removidos de %#@intervals@."
          },
          "substitutions": {
            "product": {
