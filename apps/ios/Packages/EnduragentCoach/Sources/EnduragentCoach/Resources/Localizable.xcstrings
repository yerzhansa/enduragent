    "plan.view.replacementLifecycle.cleanupVerifiedDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No tomorrow-onward old Plan workouts remain. The replacement mirror can now write."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No quedan entrenamientos del Plan anterior a partir de mañana. Ya se puede copiar el Plan de sustitución al calendario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun entraînement de l’ancien plan prévu à partir de demain ne reste. Le nouveau plan peut maintenant être ajouté au calendrier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non restano allenamenti del vecchio piano da domani in poi. Ora è possibile inserire il piano sostitutivo nel calendario."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es sind keine alten Plantrainings ab morgen mehr vorhanden. Der Ersatzplan kann jetzt in den Kalender übertragen werden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen trainingen vanaf morgen meer over uit het oude trainingsschema. Het vervangende schema kan nu naar de agenda worden geschreven."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen træninger fra den gamle træningsplan er tilbage fra i morgen og frem. Erstatningen kan nu synkroniseres til kalenderen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga träningspass från den gamla planen från och med imorgon finns kvar. Den nya planen kan nu skrivas till kalendern."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen treningsøkter fra den gamle planen gjenstår fra i morgen og fremover. Erstatningsplanen kan nå overføres til kalenderen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanhan suunnitelman harjoituksia ei ole enää huomisesta eteenpäin. Korvaavan suunnitelman kalenterikopio voidaan nyt kirjoittaa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não restam treinos do Plano anterior a partir de amanhã. A cópia do novo Plano no calendário pode agora ser escrita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não restam treinos do plano anterior a partir de amanhã. Agora é possível sincronizar o plano substituto com o calendário."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma już treningów starego planu od jutra. Teraz można zapisać kopię nowego planu w kalendarzu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내일 이후의 이전 계획 워크아웃이 남아 있지 않습니다. 이제 대체 계획의 캘린더 일정을 추가할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明日以降の以前のプランのワークアウトは残っていません。新しいプランの予定をカレンダーに書き込めます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已无从明天起的旧计划训练课程。现在可以写入替代计划的同步日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "明天起的舊計畫訓練課表已全數移除。現在可寫入新計畫的行事曆副本。"
          }
        }
      }
    },
