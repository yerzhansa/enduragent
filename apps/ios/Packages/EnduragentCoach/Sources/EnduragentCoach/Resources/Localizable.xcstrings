    "plan.view.datePicker.dateConstraints": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Past dates are unavailable. Shorter blocks stay valid; weekly preferences keep their weekdays."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedes elegir fechas pasadas. Los bloques más cortos siguen siendo válidos; las preferencias semanales mantienen sus días de la semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dates passées sont indisponibles. Les blocs plus courts restent valides ; tes préférences hebdomadaires conservent leurs jours de la semaine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le date passate non sono disponibili. I blocchi più brevi restano validi; le preferenze settimanali mantengono i rispettivi giorni della settimana."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergangene Daten sind nicht verfügbar. Kürzere Trainingsblöcke bleiben gültig. Deine wöchentlichen Vorgaben behalten ihre Wochentage."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Datums in het verleden zijn niet beschikbaar. Kortere blokken blijven geldig. Je wekelijkse voorkeuren behouden hun weekdagen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidligere datoer kan ikke vælges. Kortere træningsblokke er stadig gyldige. Ugentlige præferencer beholder deres ugedage."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Datum som har passerat kan inte väljas. Kortare träningsblock är fortfarande giltiga. Veckoinställningarna behåller sina veckodagar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidligere datoer kan ikke velges. Kortere treningsblokker er fortsatt gyldige. Ukentlige preferanser beholder ukedagene sine."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Menneitä päivämääriä ei voi valita. Lyhyemmät harjoitusblokit ovat sallittuja. Viikoittaiset toiveet säilyvät samoilla viikonpäivillä."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As datas passadas estão indisponíveis. Os blocos mais curtos continuam válidos; as preferências semanais mantêm os respetivos dias da semana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Datas passadas não estão disponíveis. Blocos mais curtos continuam válidos; as preferências semanais mantêm seus dias da semana."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeszłe daty są niedostępne. Krótsze bloki treningowe pozostają dopuszczalne. Tygodniowe preferencje zachowują wybrane dni tygodnia."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "과거 날짜는 선택할 수 없습니다. 짧은 블록도 유효하며, 주간 훈련 선호 요일은 유지됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去の日付は選べません。短いブロックも利用でき、毎週の設定の曜日は維持されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法选择过去的日期。较短的训练区块仍然有效；每周偏好保留原定星期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法選擇過去的日期。較短的訓練週期仍可使用；每週偏好設定的星期不變。"
          }
        }
      }
    },
