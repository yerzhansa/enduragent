    "settings.credentials.delete.intervalsDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved API key and imported connection will be removed. Your synced rides and past chats stay on %#@computer@."
          },
          "substitutions": {
            "computer": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán tu clave de API guardada y la conexión importada. Tus salidas sincronizadas y chats anteriores se conservan en %#@computer@."
          },
          "substitutions": {
            "computer": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta clé API enregistrée et ta connexion importée seront supprimées. Tes sorties synchronisées et tes conversations passées restent sur %#@computer@."
          },
          "substitutions": {
            "computer": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave API salvata e la connessione importata verranno rimosse. Le uscite sincronizzate e le chat passate rimangono su %#@computer@."
          },
          "substitutions": {
            "computer": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein gespeicherter API-Schlüssel und die importierte Verbindung werden entfernt. Deine synchronisierten Fahrten und bisherigen Chats bleiben auf %#@computer@."
          },
          "substitutions": {
            "computer": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je opgeslagen API-sleutel en geïmporteerde verbinding worden verwijderd. Je gesynchroniseerde ritten en eerdere chats blijven op %#@computer@."
          },
          "substitutions": {
            "computer": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din gemte API-nøgle og importerede forbindelse fjernes. Dine synkroniserede ture og tidligere chats bliver på %#@computer@."
          },
          "substitutions": {
            "computer": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din sparade API-nyckel och importerade anslutning tas bort. Dina synkroniserade cykelturer och tidigare chattar finns kvar på %#@computer@."
          },
          "substitutions": {
            "computer": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lagrede API-nøkkelen og den importerte tilkoblingen fjernes. Synkroniserte turer og tidligere samtaler beholdes på %#@computer@."
          },
          "substitutions": {
            "computer": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennettu API-avaimesi ja tuotu yhteys poistetaan. Synkronoidut lenkkisi ja aiemmat keskustelusi säilyvät tietokoneella %#@computer@."
          },
          "substitutions": {
            "computer": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua chave de API guardada e a ligação importada serão removidas. As tuas voltas sincronizadas e conversas anteriores mantêm-se em %#@computer@."
          },
