        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar o ID de atleta. A tua alteração continua aqui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar o ID de atleta. Sua edição continua aqui."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać identyfikatora sportowca. Twoja zmiana nadal tu jest."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선수 ID를 저장하지 못했습니다. 입력한 내용은 유지됩니다."
