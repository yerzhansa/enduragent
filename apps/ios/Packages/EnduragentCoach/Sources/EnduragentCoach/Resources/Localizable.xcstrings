    "cli.startup.shuttingDownFinishingInFlightMessages": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\nShutting down — finishing in-flight messages..."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\nCerrando. Terminando de procesar los mensajes en curso..."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\nArrêt en cours — fin du traitement des messages en cours…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\nArresto in corso. Completamento dei messaggi in elaborazione..."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\nWird beendet. Laufende Nachrichten werden fertig verarbeitet..."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "\nAfsluiten. Lopende berichten afronden..."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "\nLukker ned — færdiggør igangværende beskeder..."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\nStänger av. Slutför pågående meddelanden..."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "\nAvslutter — fullfører meldinger som behandles…"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "\nSuljetaan. Viimeistellään keskeneräisiä viestejä..."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "\nA encerrar. A concluir as mensagens em curso..."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\nEncerrando. Concluindo as mensagens em andamento..."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\nZamykanie — kończenie obsługi wiadomości w toku…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\n종료 중입니다. 처리 중인 메시지를 마무리하고 있습니다..."
