        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bot se ha reanudado tras una larga interrupción, por lo que los mensajes enviados durante ese tiempo pueden no haber llegado a %#@product@. Revisa el chat de %#@telegram@ antes de quitar este aviso."
          },
