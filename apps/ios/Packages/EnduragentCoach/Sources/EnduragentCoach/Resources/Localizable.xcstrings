    "settings.spend.cache.explicit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explicit caching on this route."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caché explícita en esta conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mise en cache explicite pour cette configuration."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache esplicita per questa configurazione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Explizites Caching für diese Verbindung."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Expliciete caching op deze route."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksplicit caching på denne rute."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Explicit cachelagring används för den här anslutningen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksplisitt mellomlagring i dette treneroppsettet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä yhteys käyttää erikseen määritettyä välimuistia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache explícita nesta ligação."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache explícito nesta rota."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawne buforowanie w tym połączeniu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 연결에서는 캐싱을 명시적으로 설정합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この接続先では明示的なキャッシュを使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此配置使用显式缓存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此教練連線使用明確指定的快取。"
          }
        }
      }
    },
    "settings.spend.cache.none": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No cache reads"
