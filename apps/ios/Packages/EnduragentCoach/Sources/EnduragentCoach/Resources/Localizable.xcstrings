    "settings.conversation.fields.dailyResetHour.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Athlete-local hour, from 0 to 23. A change may make your next message start a fresh conversation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hora local del deportista, de 0 a 23. Un cambio puede hacer que tu siguiente mensaje inicie una nueva conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Heure locale de l’athlète, de 0 à 23. Une modification peut faire démarrer une nouvelle conversation à ton prochain message."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora locale dell’atleta, da 0 a 23. Una modifica potrebbe far iniziare una nuova conversazione al tuo prossimo messaggio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stunde in deiner Zeitzone, von 0 bis 23. Nach einer Änderung beginnt deine nächste Nachricht möglicherweise ein neues Gespräch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uur in de lokale tijd van de atleet, van 0 tot 23. Een wijziging kan ervoor zorgen dat je volgende bericht een nieuw gesprek begint."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Time i atletens lokale tid, fra 0 til 23. En ændring kan få din næste besked til at starte en ny samtale."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Timme i din lokala tid, från 0 till 23. En ändring kan göra att ditt nästa meddelande startar ett nytt samtal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokal time for utøveren, fra 0 til 23. En endring kan føre til at neste melding starter en ny samtale."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunti urheilijan paikallista aikaa, välillä 0–23. Muutoksen jälkeen seuraava viestisi voi aloittaa uuden keskustelun."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Hora local do atleta, de 0 a 23. Uma alteração pode fazer com que a tua próxima mensagem inicie uma nova conversa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hora local do atleta, de 0 a 23. Uma alteração pode fazer sua próxima mensagem iniciar uma nova conversa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Godzina w lokalnej strefie czasowej sportowca, od 0 do 23. Po zmianie następna wiadomość może rozpocząć nową rozmowę."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선수의 현지 시간 기준으로 0~23시입니다. 변경하면 다음 메시지에서 새 대화가 시작될 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アスリートの現地時刻で0〜23時を指定します。変更すると、次のメッセージから新しい会話が始まる場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用运动员当地时间，范围为 0 至 23 时。更改后，下一条消息可能会开启新对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "運動員當地時間的小時數，範圍為 0 至 23。變更後，下一則訊息可能會開始新對話。"
          }
        }
      }
    },
