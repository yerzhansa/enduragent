    "settings.telegram.sender.removeDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This user will lose access to your coach and shared athlete data until you re-add them by sender ID %#@senderId@."
          },
          "substitutions": {
            "senderId": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este usuario perderá el acceso a tu entrenador y a los datos de deportista compartidos hasta que lo vuelvas a añadir con el ID de remitente %#@senderId@."
          },
          "substitutions": {
            "senderId": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet utilisateur perdra l’accès à ton coach et aux données d’athlète partagées jusqu’à ce que tu l’ajoutes à nouveau avec l’identifiant d’expéditeur %#@senderId@."
          },
          "substitutions": {
            "senderId": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo utente perderà l’accesso al tuo coach e ai dati condivisi dell’atleta finché non lo aggiungerai di nuovo tramite l’ID mittente %#@senderId@."
          },
          "substitutions": {
            "senderId": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Nutzer verliert den Zugriff auf deinen Coach und deine gemeinsam genutzten Athletendaten, bis du ihn mit der Absender-ID %#@senderId@ erneut hinzufügst."
          },
          "substitutions": {
            "senderId": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze gebruiker verliest toegang tot je coach en gedeelde atleetgegevens totdat je diegene opnieuw toevoegt met afzender-ID %#@senderId@."
          },
          "substitutions": {
            "senderId": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne bruger mister adgang til din træner og dine delte atletdata, indtil du tilføjer vedkommende igen med afsender-ID %#@senderId@."
          },
          "substitutions": {
            "senderId": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här användaren förlorar åtkomsten till din tränare och dina delade träningsdata tills du lägger till användaren igen med avsändar-ID %#@senderId@."
          },
          "substitutions": {
            "senderId": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne brukeren mister tilgangen til treneren din og delte utøverdata til du legger vedkommende til igjen med avsender-ID %#@senderId@."
          },
          "substitutions": {
            "senderId": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä käyttäjä menettää pääsyn valmentajaasi ja yhteisiin urheilijatietoihin, kunnes lisäät hänet uudelleen lähettäjätunnuksella %#@senderId@."
          },
          "substitutions": {
            "senderId": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este utilizador perderá o acesso ao teu treinador e aos dados de atleta partilhados até o voltares a adicionar com o ID de remetente %#@senderId@."
          },
          "substitutions": {
            "senderId": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este usuário perderá o acesso ao seu treinador e aos dados de atleta compartilhados até que você o adicione novamente pelo ID de remetente %#@senderId@."
          },
          "substitutions": {
            "senderId": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten użytkownik utraci dostęp do twojego trenera i wspólnych danych sportowca, dopóki nie dodasz go ponownie za pomocą identyfikatora nadawcy %#@senderId@."
          },
          "substitutions": {
            "senderId": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발신자 ID %#@senderId@(으)로 다시 추가할 때까지 이 사용자는 코치와 공유 선수 데이터에 접근할 수 없습니다."
          },
          "substitutions": {
            "senderId": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信者ID%#@senderId@で再追加するまで、このユーザーはコーチと共有アスリートデータにアクセスできなくなります。"
          },
          "substitutions": {
            "senderId": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此用户将无法访问教练和共享的运动员数据，直到您通过发送者 ID %#@senderId@ 将其重新添加。"
          },
          "substitutions": {
            "senderId": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此使用者將無法使用教練與共用的運動員資料，直到您透過傳送者 ID %#@senderId@ 重新新增。"
          },
          "substitutions": {
            "senderId": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        }
      }
    },
