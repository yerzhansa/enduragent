    "cli.setup.setupWillRegisterYourTelegramAccount": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup will register your %#@telegram@ account as the primary operator. Send your bot the pairing code shown below from your %#@telegram@ app within %#@seconds@ seconds."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "seconds": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración registrará tu cuenta de %#@telegram@ como operador principal. Envía al bot el código de vinculación que aparece abajo desde tu aplicación de %#@telegram@ en un plazo de %#@seconds@ segundos."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "seconds": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration enregistrera ton compte %#@telegram@ comme opérateur principal. Envoie au bot le code d’association ci-dessous depuis ton application %#@telegram@ dans les %#@seconds@ secondes."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "seconds": {
              "argNum": 2,
              "formatSpecifier": "@"
