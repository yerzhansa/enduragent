    "plan.view.active.proposalPreserved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The active Plan is unchanged and this Proposal is still available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Plan activo no ha cambiado y esta propuesta sigue disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plan actif reste inchangé et cette proposition reste disponible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il piano attivo resta invariato e questa proposta è ancora disponibile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktive Plan bleibt unverändert und dieser Vorschlag ist weiterhin verfügbar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het actieve trainingsschema is ongewijzigd en dit voorstel is nog beschikbaar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den aktive træningsplan er uændret, og dette forslag er stadig tilgængeligt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den aktiva planen är oförändrad och det här förslaget finns kvar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den aktive planen er uendret, og dette forslaget er fortsatt tilgjengelig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiivinen suunnitelma säilyy ennallaan ja tämä ehdotus on yhä käytettävissä."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Plano ativo mantém-se e esta proposta continua disponível."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano ativo permanece inalterado e esta proposta continua disponível."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktywny plan pozostaje bez zmian, a ta propozycja jest nadal dostępna."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 계획은 변경되지 않았으며 이 제안은 계속 사용할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なプランは変更されておらず、この提案は引き続き利用できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前启用的计划未改变，此方案仍可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進行中的計畫未變更，此提案仍可使用。"
          }
        }
      }
    },
