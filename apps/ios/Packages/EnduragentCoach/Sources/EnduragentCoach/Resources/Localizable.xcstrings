        "da": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%#@number@ af %#@total@ aktivitet er skjult af %#@source@ og er derfor ikke med. En API-begrænsning hos %#@source@ forhindrer %#@service@ i at dele aktiviteter fra %#@source@. For fremtidige ture skal du forbinde din optagelseskilde direkte med %#@service@ og beholde forbindelsen til %#@source@. For tidligere ture skal du bruge %#@importAction@ i indstillingerne i %#@service@; det kræver et supporterabonnement hos %#@service@."
                }
              },
              "other": {
                "stringUnit": {
