            "computer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa palvelun %#@telegram@ käytöstä sekä salatun tunnisteen ja sallittujen käyttäjien käyttöoikeudet tietokoneelta %#@computer@. %#@telegram@-botti ja keskustelu säilyvät palvelussa %#@telegram@."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "computer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto desliga %#@telegram@ e elimina o token encriptado e o acesso dos utilizadores autorizados de %#@computer@. O bot do %#@telegram@ e a conversa mantêm-se no %#@telegram@."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "computer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação desativa %#@telegram@ e exclui de %#@computer@ o token criptografado e o acesso dos usuários autorizados. O bot de %#@telegram@ e a conversa permanecem em %#@telegram@."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "computer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to wyłączenie %#@telegram@ oraz usunięcie zaszyfrowanego tokena i dostępu dozwolonych użytkowników z %#@computer@. Bot %#@telegram@ i czat pozostaną w %#@telegram@."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "computer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@telegram@을(를) 끄고 %#@computer@에서 암호화된 토큰과 허용된 사용자의 접근 권한을 삭제합니다. %#@telegram@ 봇과 채팅은 %#@telegram@에 유지됩니다."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "computer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@telegram@をオフにし、暗号化したトークンと許可ユーザーのアクセス権を%#@computer@から削除します。%#@telegram@のボットとチャットは%#@telegram@に残ります。"
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
