    "settings.telegram.feedback.sender.daemonUncertain": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The allowed-user list may have changed, but %#@product@ lost confirmation from the local coaching service. Restart %#@product@ and check the list before trying again."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que la lista de usuarios autorizados haya cambiado, pero %#@product@ ha perdido la confirmación del servicio local de entrenamiento. Reinicia %#@product@ y comprueba la lista antes de intentarlo de nuevo."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste des utilisateurs autorisés a peut-être changé, mais %#@product@ a perdu la confirmation du service de coaching local. Redémarre %#@product@ et vérifie la liste avant de réessayer."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’elenco degli utenti autorizzati potrebbe essere cambiato, ma %#@product@ non ha ricevuto conferma dal servizio di coaching locale. Riavvia %#@product@ e controlla l’elenco prima di riprovare."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Liste zugelassener Nutzer wurde möglicherweise geändert, aber %#@product@ hat die Bestätigung des lokalen Coaching-Dienstes verloren. Starte %#@product@ neu und prüfe die Liste, bevor du es noch einmal versuchst."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lijst met toegestane gebruikers is mogelijk gewijzigd, maar %#@product@ heeft geen bevestiging ontvangen van de lokale coachservice. Start %#@product@ opnieuw op en controleer de lijst voordat je het nogmaals probeert."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen over tilladte brugere kan være ændret, men %#@product@ mistede bekræftelsen fra den lokale trænertjeneste. Genstart %#@product@, og kontrollér listen, før du prøver igen."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Listan över behöriga användare kan ha ändrats, men %#@product@ fick ingen bekräftelse från den lokala tränartjänsten. Starta om %#@product@ och kontrollera listan innan du försöker igen."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen over tillatte brukere kan ha blitt endret, men %#@product@ mistet bekreftelsen fra den lokale trenertjenesten. Start %#@product@ på nytt og sjekk listen før du prøver igjen."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sallittujen käyttäjien luettelo on ehkä muuttunut, mutta %#@product@ ei saanut vahvistusta paikalliselta valmennuspalvelulta. Käynnistä %#@product@ uudelleen ja tarkista luettelo ennen uutta yritystä."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista de utilizadores autorizados pode ter mudado, mas %#@product@ perdeu a confirmação do serviço local de treino. Reinicia %#@product@ e verifica a lista antes de tentares novamente."
          },
          "substitutions": {
