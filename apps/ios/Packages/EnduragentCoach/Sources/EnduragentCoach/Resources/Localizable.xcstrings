    "settings.credentials.feedback.delete.unverified": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Credential deletion could not be confirmed because secure storage could not be verified. Restart %#@product@ and reload before trying again."
