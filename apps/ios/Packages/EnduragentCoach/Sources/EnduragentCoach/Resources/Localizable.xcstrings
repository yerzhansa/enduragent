        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette slår av %#@telegram@ og sletter det krypterte tokenet og tilgangen for tillatte brukere fra %#@computer@. %#@telegram@-boten og samtalen beholdes i %#@telegram@."
          },
          "substitutions": {
