    "desktop.tray.closeHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the window without quitting. Right-click the menu-bar icon for more options."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra la ventana sin salir de la aplicación. Haz clic derecho en el icono de la barra de menús para ver más opciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferme la fenêtre sans quitter l'application. Fais un clic droit sur l'icône de la barre des menus pour voir plus d'options."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi la finestra senza uscire dall'app. Fai clic destro sull'icona nella barra dei menu per altre opzioni."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe das Fenster, ohne die App zu beenden. Klicke mit der rechten Maustaste auf das Symbol in der Menüleiste, um weitere Optionen anzuzeigen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit het venster zonder de app af te sluiten. Klik met de rechtermuisknop op het pictogram in de menubalk voor meer opties."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Luk vinduet uden at afslutte appen. Højreklik på ikonet i menulinjen for flere muligheder."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stäng fönstret utan att avsluta appen. Högerklicka på ikonen i menyraden för fler alternativ."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukk vinduet uten å avslutte appen. Høyreklikk på ikonet i menylinjen for flere alternativer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulje ikkuna lopettamatta sovellusta. Saat lisää vaihtoehtoja napsauttamalla valikkorivin kuvaketta hiiren oikealla painikkeella."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fecha a janela sem encerrar a aplicação. Clica com o botão direito no ícone da barra de menus para veres mais opções."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Feche a janela sem encerrar o aplicativo. Clique com o botão direito no ícone da barra de menus para ver mais opções."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknij okno bez zamykania aplikacji. Kliknij prawym przyciskiem myszy ikonę na pasku menu, aby zobaczyć więcej opcji."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 종료하지 않고 창을 닫습니다. 더 많은 옵션을 보려면 메뉴 막대 아이콘을 마우스 오른쪽 버튼으로 클릭하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを終了せずにウインドウを閉じます。その他のオプションは、メニューバーのアイコンを右クリックすると表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭窗口，应用会继续运行。右键点击菜单栏图标可查看更多选项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉視窗，應用程式會繼續執行。以滑鼠右鍵按一下選單列圖示可查看更多選項。"
          }
        }
      }
    },
