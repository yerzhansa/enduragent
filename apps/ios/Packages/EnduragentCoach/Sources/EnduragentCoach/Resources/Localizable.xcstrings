    "plan.view.active.staleProposal": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Plan changed before approval. Review this updated Proposal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Plan ha cambiado antes de la aprobación. Revisa esta propuesta actualizada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plan a changé avant l’approbation. Vérifie cette proposition mise à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il piano è cambiato prima dell’approvazione. Controlla questa proposta aggiornata."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Plan hat sich vor der Zustimmung geändert. Prüfe diesen aktualisierten Vorschlag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het trainingsschema is vóór de goedkeuring gewijzigd. Bekijk dit bijgewerkte voorstel."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træningsplanen blev ændret før godkendelsen. Gennemgå dette opdaterede forslag."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Planen ändrades före godkännandet. Granska det här uppdaterade förslaget."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Planen ble endret før godkjenning. Se gjennom dette oppdaterte forslaget."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suunnitelma muuttui ennen hyväksymistä. Tarkista tämä päivitetty ehdotus."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Plano mudou antes da aprovação. Revê esta proposta atualizada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano mudou antes da aprovação. Revise esta proposta atualizada."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan zmienił się przed zatwierdzeniem. Sprawdź zaktualizowaną propozycję."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
