    "sidebar.sync.restriction.tooltipBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A %#@source@ API restriction prevents %#@provider@ from sharing these activities with %#@product@."
          },
          "substitutions": {
            "source": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "provider": {
              "argNum": 2,
              "formatSpecifier": "@"
