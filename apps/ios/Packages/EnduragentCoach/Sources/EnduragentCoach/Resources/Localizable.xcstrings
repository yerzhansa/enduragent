          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändringen tillämpades inte eftersom lagringen inte kunde verifieras. Starta om %#@product@ och kontrollera den här inställningen innan du försöker igen."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Endringen ble ikke tatt i bruk fordi lagringen ikke kunne bekreftes. Start %#@product@ på nytt og sjekk denne innstillingen før du prøver igjen."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muutosta ei otettu käyttöön, koska tallennustilaa ei voitu varmistaa. Käynnistä %#@product@ uudelleen ja tarkista tämä asetus ennen uutta yritystä."
          },
          "substitutions": {
