    "chat.attachment.processingDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is being checked and prepared without sending its raw contents to a provider."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo se está comprobando y preparando sin enviar su contenido sin procesar a un proveedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier est vérifié et préparé sans envoyer son contenu brut à un fournisseur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file viene controllato e preparato senza inviare il contenuto originale a un fornitore."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei wird geprüft und vorbereitet, ohne ihren Rohinhalt an einen Anbieter zu senden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand wordt gecontroleerd en voorbereid zonder de onbewerkte inhoud naar een aanbieder te sturen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen bliver kontrolleret og klargjort uden at sende dens rå indhold til en udbyder."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen kontrolleras och förbereds utan att dess råinnehåll skickas till en leverantör."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen kontrolleres og klargjøres uten at råinnholdet sendes til en leverandør."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedosto tarkistetaan ja valmistellaan lähettämättä sen raakasisältöä palveluntarjoajalle."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ficheiro está a ser verificado e preparado sem enviar o seu conteúdo em bruto a um fornecedor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo está sendo verificado e preparado sem enviar seu conteúdo bruto a um provedor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik jest sprawdzany i przygotowywany bez wysyłania jego surowej zawartości do dostawcy."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 원본 내용을 제공업체에 보내지 않고 파일을 확인하고 준비하고 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルの内容をそのままプロバイダーに送ることなく、確認と準備を進めています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查并准备文件，不会将原始内容发送给提供商。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在檢查並準備檔案，不會將原始內容傳送給供應商。"
          }
        }
      }
    },
