    "plan.view.draft.recalculationDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Race day and weekly availability stay fixed. Your previous Draft remains safe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El día de la carrera y la disponibilidad semanal no cambian. Tu borrador anterior se conserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date de la course et tes disponibilités hebdomadaires restent fixes. Ton brouillon précédent est conservé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La data della gara e la disponibilità settimanale restano fisse. La tua bozza precedente è conservata."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Renntag und wöchentliche Verfügbarkeit bleiben unverändert. Dein bisheriger Entwurf bleibt erhalten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De wedstrijddatum en je wekelijkse beschikbaarheid blijven gelijk. Je vorige concept blijft bewaard."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Konkurrencedagen og den ugentlige tilgængelighed ændres ikke. Din tidligere kladde bliver bevaret."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tävlingsdagen och veckans tillgängliga träningstid är oförändrade. Ditt tidigare utkast finns kvar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Konkurransedagen og den ukentlige tilgjengeligheten er uendret. Det forrige utkastet ditt er bevart."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilpailupäivä ja viikoittainen käytettävyys säilyvät ennallaan. Aiempi luonnoksesi säilyy."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O dia da prova e a disponibilidade semanal mantêm-se. O teu rascunho anterior continua preservado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dia da prova e a disponibilidade semanal permanecem fixos. Seu rascunho anterior está preservado."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Data wyścigu i tygodniowa dostępność pozostają bez zmian. Twoja poprzednia wersja robocza jest zachowana."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대회일과 주간 훈련 가능 시간은 고정됩니다. 이전 초안은 안전하게 보관되어 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レース日と毎週のトレーニング可能な日時は変わりません。前の下書きは保持されています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比赛日和每周可训练时间保持不变。此前的草稿会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "比賽日與每週可訓練時間維持不變。先前的草稿會保留。"
          }
        }
      }
    },
