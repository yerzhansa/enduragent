    "plan.view.readiness.refreshDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking recent training before recalculating the Form range. The last available readiness view stays safe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobando el entrenamiento reciente antes de recalcular el rango de forma. La última vista de preparación disponible se conserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification de l’entraînement récent avant de recalculer la fourchette de forme. La dernière vue disponible de la préparation est conservée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica degli allenamenti recenti prima di ricalcolare l’intervallo di forma. L’ultima valutazione disponibile della preparazione è conservata."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzten Trainings werden vor der Neuberechnung der Formspanne geprüft. Die zuletzt verfügbare Ansicht der Rennbereitschaft bleibt erhalten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Recente trainingen controleren voordat de bandbreedte voor je vorm opnieuw wordt berekend. Het laatst beschikbare overzicht van je wedstrijdgereedheid blijft bewaard."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollerer den seneste træning, før intervallet for form genberegnes. Den seneste tilgængelige visning af konkurrenceparathed bliver bevaret."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollerar den senaste träningen innan TSB-intervallet beräknas om. Den senast tillgängliga beredskapsvyn finns kvar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjekker nylig trening før formintervallet beregnes på nytt. Den siste tilgjengelige visningen av beredskap beholdes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkistetaan viimeaikaista harjoittelua ennen tuoreuden vaihteluvälin uudelleenlaskentaa. Viimeisin saatavilla oleva valmiusnäkymä säilyy."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A verificar o treino recente antes de recalcular o intervalo de forma. A última avaliação disponível da preparação mantém-se preservada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificando o treinamento recente antes de recalcular a faixa de forma. A última visão disponível da preparação permanece preservada."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzanie ostatnich treningów przed przeliczeniem zakresu formy. Ostatni dostępny widok gotowości pozostaje zachowany."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밸런스 범위를 다시 계산하기 전에 최근 훈련을 확인합니다. 마지막으로 확인한 준비 상태는 안전하게 보관되어 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォームの範囲を再計算する前に、最近のトレーニングを確認しています。前回の準備状況の表示は保持されています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查近期训练，然后重新计算状态范围。上次可用的备赛情况视图会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在檢查近期訓練，再重新計算狀態範圍。會保留上次可用的備賽狀態。"
          }
        }
      }
    },
