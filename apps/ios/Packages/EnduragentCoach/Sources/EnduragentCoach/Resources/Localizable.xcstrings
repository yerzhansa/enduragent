          "stringUnit": {
            "state": "translated",
            "value": "Angiv ugentlige timer i trin på et kvarter, f.eks. 2.25."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange antalet timmar per vecka i steg om en kvart, till exempel 2.25."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Angi ukentlige timer i trinn på et kvarter, for eksempel 2.25."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna viikoittaiset tunnit neljännestunnin välein, esimerkiksi 2,25."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduz as horas semanais em incrementos de um quarto de hora, como 2,25."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira as horas semanais em incrementos de um quarto de hora, como 2,25."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz liczbę godzin tygodniowo w odstępach co kwadrans, np. 2,25."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주간 시간은 2.25처럼 0.25시간 단위로 입력하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週あたりの時間は2.25のように0.25時間単位で入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入以 0.25 小时为单位的每周时长，例如 2.25。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入以 0.25 小時為單位的每週時間長度，例如 2.25。"
          }
        }
      }
    },
