        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@reply@\n\n(À noter : mon disque est plein, je n’ai donc pas pu enregistrer cet échange dans notre historique — mais ton message est bien passé. Libère de l’espace quand tu peux.)"
          },
          "substitutions": {
