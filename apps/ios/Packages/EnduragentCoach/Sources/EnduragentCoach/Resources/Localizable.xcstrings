            "state": "translated",
            "value": "Reading the connections already saved on this computer. This can take a moment right after launch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leyendo las conexiones ya guardadas en este ordenador. Puede tardar un momento justo después del inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture des connexions déjà enregistrées sur cet ordinateur. Cela peut prendre un moment juste après le démarrage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lettura delle connessioni già salvate su questo computer. Subito dopo l’avvio può richiedere qualche istante."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die auf diesem Computer bereits gespeicherten Verbindungen werden gelesen. Direkt nach dem Start kann das einen Moment dauern."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verbindingen lezen die al op deze computer zijn opgeslagen. Dit kan vlak na het opstarten even duren."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Læser de forbindelser, der allerede er gemt på denne computer. Det kan tage et øjeblik lige efter start."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läser anslutningarna som redan är sparade på den här datorn. Det kan ta en stund direkt efter start."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Leser tilkoblingene som allerede er lagret på denne datamaskinen. Dette kan ta litt tid rett etter oppstart."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luetaan tälle tietokoneelle jo tallennettuja yhteyksiä. Tämä voi kestää hetken heti käynnistyksen jälkeen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A ler as ligações já guardadas neste computador. Pode demorar um pouco logo após o arranque."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lendo as conexões já salvas neste computador. Isso pode levar um momento logo após a abertura."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytywanie połączeń zapisanych już na tym komputerze. Tuż po uruchomieniu może to chwilę potrwać."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 컴퓨터에 이미 저장된 연결을 읽고 있습니다. 앱 실행 직후에는 잠시 걸릴 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコンピュータに保存済みの接続情報を読み取っています。起動直後は少し時間がかかる場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取此电脑上已保存的连接。刚启动时可能需要稍等。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在讀取此電腦上已儲存的連線。剛啟動時可能需要稍候。"
          }
        }
      }
    },
    "setup.error.configurationUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach choices are unavailable right now. Check the setup area again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las opciones del entrenador no están disponibles ahora. Comprueba de nuevo el área de configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les choix du coach sont indisponibles pour le moment. Vérifie à nouveau la zone de configuration."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le opzioni del coach non sono disponibili al momento. Controlla di nuovo l’area di configurazione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Coach-Auswahl ist gerade nicht verfügbar. Prüfe den Einrichtungsbereich erneut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coachopties zijn nu niet beschikbaar. Controleer het configuratiegedeelte opnieuw."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Trænervalg er utilgængelige lige nu. Kontrollér opsætningsområdet igen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tränaralternativen är inte tillgängliga just nu. Kontrollera konfigurationen igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenervalg er utilgjengelige akkurat nå. Sjekk oppsettområdet igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valmentajan valinnat eivät ole juuri nyt käytettävissä. Tarkista käyttöönotto-osio uudelleen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As opções do treinador não estão disponíveis agora. Verifica novamente a área de configuração."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As opções do treinador não estão disponíveis agora. Verifique a área de configuração novamente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcje trenera są teraz niedostępne. Sprawdź ponownie sekcję konfiguracji."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 코치 선택 항목을 사용할 수 없습니다. 설정 영역을 다시 확인하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、コーチの選択肢を利用できません。セットアップ欄をもう一度確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "教练选项暂时不可用。请重新查看初始设置区域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法使用教練選項。請再次檢查初始設定區。"
          }
        }
      }
    },
    "setup.error.credentialReenterRequired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That saved key could not be used. Enter it again to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido usar esa clave guardada. Vuelve a introducirla para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette clé enregistrée n’a pas pu être utilisée. Saisis-la à nouveau pour continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile usare la chiave salvata. Inseriscila di nuovo per continuare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser gespeicherte Schlüssel konnte nicht verwendet werden. Gib ihn erneut ein, um fortzufahren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die opgeslagen sleutel kon niet worden gebruikt. Voer deze opnieuw in om door te gaan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den gemte nøgle kunne ikke bruges. Indtast den igen for at fortsætte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den sparade nyckeln kunde inte användas. Ange den igen för att fortsätta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lagrede nøkkelen kunne ikke brukes. Skriv den inn på nytt for å fortsette."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennettua avainta ei voitu käyttää. Anna se uudelleen jatkaaksesi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível usar essa chave guardada. Introduz a chave novamente para continuar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível usar essa chave salva. Insira-a novamente para continuar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się użyć tego zapisanego klucza. Wpisz go ponownie, aby kontynuować."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 키를 사용할 수 없습니다. 계속하려면 다시 입력하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みのキーを使用できませんでした。続けるには再入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法使用该已保存的密钥。请重新输入以继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法使用此已儲存的金鑰。請重新輸入以繼續。"
          }
        }
      }
    },
