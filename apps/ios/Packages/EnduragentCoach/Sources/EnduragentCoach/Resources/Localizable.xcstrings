    "settings.telegram.attention.conflict": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another app or deployment is polling this bot. Stop it there, then choose Check again. Different bots can still run at the same time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra aplicación o instancia está consultando este bot. Detén esa aplicación o instancia allí y elige Comprobar de nuevo. Los bots distintos pueden seguir funcionando a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre application ou un autre déploiement interroge ce bot. Arrête-le là-bas, puis choisis Vérifier à nouveau. Des bots différents peuvent toujours fonctionner en même temps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un’altra app o installazione sta interrogando questo bot. Interrompila lì, poi scegli Controlla di nuovo. Bot diversi possono comunque funzionare contemporaneamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere App oder Installation ruft Nachrichten dieses Bots ab. Beende das dort und wähle dann „Erneut prüfen“. Verschiedene Bots können weiterhin gleichzeitig laufen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een andere app of implementatie vraagt deze bot al om updates. Stop dat daar en kies daarna Opnieuw controleren. Verschillende bots kunnen wel tegelijk actief zijn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En anden app eller installation henter opdateringer fra denne bot. Stop det dér, og vælg derefter Kontrollér igen. Forskellige bots kan stadig køre samtidig."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En annan app eller installation hämtar meddelanden för den här boten. Stoppa den där och välj sedan Kontrollera igen. Olika botar kan fortfarande köras samtidigt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En annen app eller installasjon henter meldinger fra denne boten. Stopp den der, og velg Sjekk igjen. Ulike boter kan fortsatt kjøre samtidig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toinen sovellus tai palvelinasennus hakee tämän botin viestejä. Pysäytä se siellä ja valitse sitten Tarkista uudelleen. Eri botit voivat silti toimia samanaikaisesti."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra aplicação ou instalação está a consultar este bot. Para-a aí e escolhe Verificar novamente. Bots diferentes podem continuar a funcionar ao mesmo tempo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro aplicativo ou serviço implantado está consultando este bot. Interrompa-o lá e selecione Verificar novamente. Bots diferentes podem continuar funcionando ao mesmo tempo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inna aplikacja lub uruchomiona instancja odpytuje tego bota. Zatrzymaj ją tam, a następnie wybierz Sprawdź ponownie. Różne boty nadal mogą działać jednocześnie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱이나 배포 환경에서 이 봇을 폴링하고 있습니다. 해당 환경에서 중지한 후 다시 확인을 선택하세요. 서로 다른 봇은 동시에 실행할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のアプリまたは稼働環境がこのボットをポーリングしています。そちらで停止してから「再確認」を選んでください。異なるボットは同時に実行できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他应用或部署正在轮询此机器人。请先在该处停止，再选择“重新检查”。不同机器人仍可同时运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一個應用程式或部署正在輪詢此機器人。請先在該處停止，再選擇「再次檢查」。不同的機器人仍可同時執行。"
          }
        }
      }
    },
    "settings.telegram.attention.credentialUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved bot token could not be read from secure storage. Quit and reopen %#@product@, then choose Check again. If it still cannot be read, delete this connection, then connect a new bot."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido leer el token del bot guardado en el almacenamiento seguro. Cierra y vuelve a abrir %#@product@ y elige Comprobar de nuevo. Si sigue sin poder leerse, elimina esta conexión y conecta un nuevo bot."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeton du bot enregistré n’a pas pu être lu dans le stockage sécurisé. Quitte et rouvre %#@product@, puis choisis Vérifier à nouveau. S’il reste illisible, supprime cette connexion, puis connecte un nouveau bot."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere il token del bot salvato nell’archivio sicuro. Chiudi e riapri %#@product@, poi scegli Controlla di nuovo. Se non è ancora leggibile, elimina questa connessione e collega un nuovo bot."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das gespeicherte Bot-Token konnte nicht aus dem sicheren Speicher gelesen werden. Beende %#@product@, öffne es erneut und wähle dann „Erneut prüfen“. Falls es weiterhin nicht gelesen werden kann, lösche diese Verbindung und verbinde einen neuen Bot."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het opgeslagen bottoken kon niet uit de beveiligde opslag worden gelezen. Sluit %#@product@ af, open het opnieuw en kies Opnieuw controleren. Als het nog steeds niet kan worden gelezen, verwijder dan deze verbinding en koppel een nieuwe bot."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gemte bottoken kunne ikke læses fra sikker lagring. Luk og åbn %#@product@ igen, og vælg derefter Kontrollér igen. Hvis det stadig ikke kan læses, skal du slette denne forbindelse og forbinde en ny bot."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Botens sparade token kunde inte läsas från den säkra lagringen. Avsluta och öppna %#@product@ igen och välj sedan Kontrollera igen. Om den fortfarande inte går att läsa tar du bort den här anslutningen och ansluter en ny bot."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det lagrede bottokenet kunne ikke leses fra sikker lagring. Avslutt og åpne %#@product@ igjen, og velg Sjekk igjen. Hvis det fortsatt ikke kan leses, slett denne tilkoblingen og koble til en ny bot."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennettua botin tunnistetta ei voitu lukea suojatusta tallennustilasta. Sulje %#@product@ ja avaa se uudelleen. Valitse sitten Tarkista uudelleen. Jos tunnistetta ei vieläkään voi lukea, poista tämä yhteys ja yhdistä uusi botti."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o token guardado do bot no armazenamento seguro. Fecha e volta a abrir %#@product@ e escolhe Verificar novamente. Se continuar a não ser possível lê-lo, elimina esta ligação e liga um novo bot."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o token salvo do bot no armazenamento seguro. Feche e reabra %#@product@ e selecione Verificar novamente. Se ainda não for possível lê-lo, exclua esta conexão e conecte um novo bot."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać zapisanego tokena bota z bezpiecznego magazynu. Zamknij i otwórz ponownie %#@product@, a następnie wybierz Sprawdź ponownie. Jeśli nadal nie można go odczytać, usuń to połączenie i połącz nowego bota."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안 저장소에서 저장된 봇 토큰을 읽지 못했습니다. %#@product@을(를) 종료하고 다시 연 후 다시 확인을 선택하세요. 그래도 읽을 수 없으면 이 연결을 삭제한 후 새 봇을 연결하세요."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全なストレージから保存済みのボットトークンを読み取れませんでした。%#@product@を終了して開き直し、「再確認」を選んでください。それでも読み取れない場合は、この接続を削除して新しいボットを接続してください。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从安全存储读取已保存的机器人令牌。请退出并重新打开 %#@product@，然后选择“重新检查”。如果仍无法读取，请删除此连接后连接新机器人。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法從安全儲存空間讀取已儲存的機器人權杖。請結束並重新開啟 %#@product@，再選擇「再次檢查」。若仍無法讀取，請刪除此連線，再連結新的機器人。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        }
      }
    },
