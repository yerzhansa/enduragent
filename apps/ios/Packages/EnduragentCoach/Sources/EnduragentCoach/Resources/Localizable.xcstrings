            "value": "The Plan could not be activated. Your Draft is unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo activar el Plan. Tu borrador no ha cambiado."
          }
        },
        "fr": {
