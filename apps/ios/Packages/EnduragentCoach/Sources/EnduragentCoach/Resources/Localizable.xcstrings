    "plan.view.planCoach.goalDateConstraints": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a date from today through 24 weeks from now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una fecha entre hoy y dentro de 24 semanas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise une date comprise entre aujourd’hui et dans 24 semaines."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una data da oggi alle prossime 24 settimane."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Datum zwischen heute und in 24 Wochen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik een datum vanaf vandaag tot en met 24 weken vanaf nu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en dato fra i dag til og med 24 uger frem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd ett datum från idag till och med 24 veckor framåt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk en dato fra i dag til og med 24 uker frem i tid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse päivämäärä tästä päivästä 24 viikon päähän."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa uma data entre hoje e daqui a 24 semanas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use uma data entre hoje e daqui a 24 semanas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz datę od dzisiaj do 24 tygodni od dziś."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘부터 24주 이내의 날짜를 사용하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日から24週間後までの日付を指定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择今天至 24 周后的日期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用今天起至未來 24 週內的日期。"
          }
        }
      }
    },
