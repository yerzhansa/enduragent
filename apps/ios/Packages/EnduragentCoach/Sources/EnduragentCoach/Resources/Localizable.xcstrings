    "setup.telegram.deleteCopy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This turns %#@telegram@ off and deletes the encrypted token and allowed-user access from %#@computer@. The %#@telegram@ bot and chat remain in %#@telegram@."
