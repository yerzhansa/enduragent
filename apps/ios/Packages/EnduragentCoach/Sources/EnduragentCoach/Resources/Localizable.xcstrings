            },
            "service": {
              "argNum": 4,
              "formatSpecifier": "@"
            },
            "importAction": {
              "argNum": 5,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%#@number@ von %#@total@ Aktivitäten wird von %#@source@ ausgeblendet und daher nicht einbezogen. Eine API-Einschränkung von %#@source@ verhindert, dass %#@service@ Aktivitäten von %#@source@ weitergibt. Verbinde für künftige Fahrten deine Aufzeichnungsquelle direkt mit %#@service@ und lasse %#@source@ verbunden. Nutze für frühere Fahrten %#@importAction@ in den Einstellungen von %#@service@; dafür ist ein Unterstützer-Abonnement bei %#@service@ erforderlich."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%#@number@ von %#@total@ Aktivitäten werden von %#@source@ ausgeblendet und daher nicht einbezogen. Eine API-Einschränkung von %#@source@ verhindert, dass %#@service@ Aktivitäten von %#@source@ weitergibt. Verbinde für künftige Fahrten deine Aufzeichnungsquelle direkt mit %#@service@ und lasse %#@source@ verbunden. Nutze für frühere Fahrten %#@importAction@ in den Einstellungen von %#@service@; dafür ist ein Unterstützer-Abonnement bei %#@service@ erforderlich."
                }
              }
            }
          },
          "substitutions": {
            "number": {
              "argNum": 1,
