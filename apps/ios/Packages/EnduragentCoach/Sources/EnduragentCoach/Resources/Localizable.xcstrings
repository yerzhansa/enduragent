    "chat.planCreation.editStale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A changed answer makes the Draft stale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar una respuesta deja el borrador desactualizado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifier une réponse rend le brouillon obsolète."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificando una risposta, la bozza non sarà più aggiornata."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine geänderte Antwort macht den Entwurf veraltet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een gewijzigd antwoord maakt het concept verouderd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et ændret svar gør kladden forældet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du ändrar ett svar blir utkastet inaktuellt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et endret svar gjør utkastet utdatert."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastauksen muuttaminen vanhentaa luonnoksen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterar uma resposta torna o rascunho desatualizado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterar uma resposta torna o rascunho desatualizado."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana odpowiedzi sprawia, że wersja robocza staje się nieaktualna."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변을 변경하면 초안을 다시 생성해야 합니다."
