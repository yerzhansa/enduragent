    "settings.telegram.feedback.health.transferRequired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This bot is still owned by another Desktop installation. Delete the connection there before connecting it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este bot sigue perteneciendo a otra instalación de la aplicación de escritorio. Elimina la conexión allí antes de conectarlo aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce bot appartient toujours à une autre installation de l’application de bureau. Supprime sa connexion là-bas avant de le connecter ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo bot appartiene ancora a un’altra installazione dell’app desktop. Elimina la connessione lì prima di collegarlo qui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Bot gehört noch zu einer anderen Desktop-Installation. Lösche die Verbindung dort, bevor du ihn hier verbindest."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze bot hoort nog bij een andere Desktop-installatie. Verwijder de verbinding daar voordat je de bot hier verbindt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne bot tilhører stadig en anden Desktop-installation. Slet forbindelsen dér, før du forbinder den her."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här boten tillhör fortfarande en annan installation av datorappen. Ta bort anslutningen där innan du ansluter den här."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne boten tilhører fortsatt en annen installasjon av skrivebordsappen. Slett tilkoblingen der før du kobler den til her."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä botti kuuluu yhä toiseen työpöytäsovelluksen asennukseen. Poista yhteys siellä ennen sen yhdistämistä tänne."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este bot ainda pertence a outra instalação da aplicação de computador. Elimina a ligação aí antes de o ligares aqui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este bot ainda pertence a outra instalação do aplicativo de computador. Exclua a conexão lá antes de conectá-lo aqui."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten bot nadal należy do innej instalacji aplikacji komputerowej. Usuń tam połączenie, zanim połączysz go tutaj."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 봇은 아직 다른 데스크톱 앱 설치에 속해 있습니다. 여기에서 연결하기 전에 해당 설치에서 연결을 삭제하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このボットはまだ別のデスクトップアプリのインストールに属しています。そちらの接続を削除してから、ここで接続してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此机器人仍属于另一个桌面应用安装实例。请先在该处删除连接，再在此连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此機器人仍屬於另一個桌面應用程式安裝。請先在該處刪除連線，再於此處連結。"
          }
        }
      }
    },
