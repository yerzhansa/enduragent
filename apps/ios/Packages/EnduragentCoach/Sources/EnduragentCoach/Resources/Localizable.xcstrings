    "settings.telegram.setup.afterBotfather": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "for a bot, copy its token, then return here. %#@product@ reads the token directly from the clipboard; there is no token field."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "que cree un bot, copia su token y vuelve aquí. %#@product@ lee el token directamente del portapapeles; no hay un campo de token."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "de créer un bot, copie son jeton, puis reviens ici. %#@product@ lit le jeton directement dans le presse-papiers ; il n’y a aucun champ de saisie du jeton."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "un bot, copia il suo token, poi torna qui. %#@product@ legge il token direttamente dagli appunti; non c’è un campo per il token."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "um einen Bot, kopiere sein Token und kehre dann hierher zurück. %#@product@ liest das Token direkt aus der Zwischenablage; es gibt kein Eingabefeld für das Token."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "om een bot, kopieer het token en keer hier terug. %#@product@ leest het token rechtstreeks van het klembord. Er is geen invoerveld voor het token."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "om en bot, kopiér dens token, og vend tilbage hertil. %#@product@ læser tokenet direkte fra udklipsholderen. Der er intet tokenfelt."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "om en bot, kopiera dess token och återvänd sedan hit. %#@product@ läser token direkt från urklipp. Det finns inget tokenfält."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "om en bot, kopier tokenet og kom tilbake hit. %#@product@ leser tokenet direkte fra utklippstavlen. Det finnes ikke noe tokenfelt."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "luomaan botti, kopioi sen tunniste ja palaa sitten tänne. %#@product@ lukee tunnisteen suoraan leikepöydältä. Tunnisteelle ei ole kenttää."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "que crie um bot, copia o respetivo token e volta aqui. %#@product@ lê o token diretamente da área de transferência. Não há nenhum campo para o token."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "um bot, copie seu token e volte aqui. %#@product@ lê o token diretamente da área de transferência; não há campo para o token."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "o bota, skopiuj jego token i wróć tutaj. %#@product@ odczytuje token bezpośrednio ze schowka; nie ma pola na token."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에게 봇을 요청하고 토큰을 복사한 후 여기로 돌아오세요. %#@product@에서 클립보드의 토큰을 직접 읽으므로 토큰 입력란은 없습니다."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "にボットの作成を依頼し、トークンをコピーしてここに戻ってください。%#@product@はクリップボードからトークンを直接読み取ります。トークンの入力欄はありません。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申请机器人，复制其令牌后返回此处。%#@product@ 直接从剪贴板读取令牌，无需令牌输入框。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立機器人，複製其權杖後返回這裡。%#@product@ 會直接從剪貼簿讀取權杖；此處沒有權杖輸入欄位。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        }
      }
    },
