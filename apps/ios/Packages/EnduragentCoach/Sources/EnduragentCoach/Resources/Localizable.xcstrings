    "settings.conversation.fields.resetArchiveRetentionDays.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whole days to keep reset archives. Use 0 to keep them forever; changes apply only to future pruning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Días enteros durante los que se conservan las conversaciones archivadas tras un reinicio. Usa 0 para conservarlas siempre; los cambios solo se aplican a futuras limpiezas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre entier de jours de conservation des archives de réinitialisation. Utilise 0 pour les garder indéfiniment ; les modifications s’appliquent uniquement aux prochaines suppressions automatiques."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Giorni interi di conservazione delle conversazioni archiviate dopo una reimpostazione. Usa 0 per conservarle per sempre; le modifiche si applicano solo alle eliminazioni future."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganze Tage, für die Archive zurückgesetzter Gespräche aufbewahrt werden. Mit 0 bleiben sie dauerhaft erhalten; Änderungen gelten nur für künftige Bereinigungen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aantal hele dagen dat archieven van opnieuw ingestelde gesprekken bewaard blijven. Gebruik 0 om ze voor altijd te bewaren. Wijzigingen gelden alleen voor toekomstige opschoning."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hele dage, som arkiver fra nulstillede samtaler skal gemmes. Brug 0 for at beholde dem for altid. Ændringer gælder kun fremtidig oprydning."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Antal hela dagar som arkiv från återställda samtal sparas. Ange 0 för att behålla dem för alltid. Ändringar gäller bara framtida rensning."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Antall hele dager arkiverte samtaler beholdes etter nullstilling. Bruk 0 for å beholde dem for alltid. Endringer gjelder bare fremtidig opprydding."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokonaiset päivät, joina nollattujen keskustelujen arkistoja säilytetään. Säilytä pysyvästi arvolla 0. Muutokset koskevat vain tulevia siivouksia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dias inteiros durante os quais se guardam as conversas arquivadas após reinício. Usa 0 para as manter para sempre. As alterações só se aplicam a futuras limpezas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dias inteiros para manter os arquivos de conversas reiniciadas. Use 0 para mantê-los para sempre; alterações só se aplicam a limpezas futuras."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczba pełnych dni przechowywania archiwów zresetowanych rozmów. Wpisz 0, aby zachować je na zawsze; zmiany dotyczą tylko przyszłego usuwania."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초기화된 대화의 보관 기간을 일 단위 정수로 입력합니다. 0이면 영구 보관하며, 변경 사항은 앞으로의 정리에만 적용됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リセットした会話の保存日数を整数で指定します。0にすると無期限に保存します。変更は今後の自動削除にのみ適用されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置后的对话归档保留天数，须为整数。设为 0 可永久保留；更改仅影响今后的清理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留重設後封存對話的整數天數。設為 0 可永久保留；變更僅適用於日後的清理。"
          }
        }
      }
    },
