    "settings.telegram.feedback.failure.changeStorageUnverified": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change was not applied because storage could not be verified. Restart %#@product@ and check this setting before trying again."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha aplicado el cambio porque no se ha podido verificar el almacenamiento. Reinicia %#@product@ y comprueba este ajuste antes de intentarlo de nuevo."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La modification n’a pas été appliquée, car le stockage n’a pas pu être vérifié. Redémarre %#@product@ et vérifie ce paramètre avant de réessayer."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modifica non è stata applicata perché non è stato possibile verificare l’archiviazione. Riavvia %#@product@ e controlla questa impostazione prima di riprovare."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Änderung wurde nicht übernommen, weil der Speicher nicht überprüft werden konnte. Starte %#@product@ neu und prüfe diese Einstellung, bevor du es noch einmal versuchst."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De wijziging is niet toegepast omdat de opslag niet kon worden geverifieerd. Start %#@product@ opnieuw op en controleer deze instelling voordat je het nogmaals probeert."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
