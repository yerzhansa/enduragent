    "chat.planChange.feedback.revisionChanged": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This request used an older Plan revision. Request a fresh preview."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta solicitud usaba una versión anterior del plan. Solicita una nueva vista previa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette demande utilisait une ancienne version du plan. Demande un nouvel aperçu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa richiesta usava una versione precedente del piano. Richiedi una nuova anteprima."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anfrage verwendete eine ältere Planversion. Fordere eine neue Vorschau an."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verzoek gebruikte een oudere versie van het trainingsschema. Vraag een nieuw wijzigingsvoorbeeld aan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne anmodning brugte en ældre version af træningsplanen. Bed om en ny forhåndsvisning."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förfrågan använde en äldre version av planen. Begär en ny förhandsgranskning."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne forespørselen brukte en eldre planversjon. Be om en ny forhåndsvisning."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä pyyntö käytti vanhempaa suunnitelmaversiota. Pyydä uusi esikatselu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este pedido usou uma versão anterior do plano. Pede uma nova pré-visualização."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta solicitação usou uma versão anterior do plano. Peça uma nova prévia."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta prośba dotyczyła starszej wersji planu. Poproś o nowy podgląd."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 요청은 이전 계획 버전을 사용했습니다. 새 미리보기를 요청하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリクエストは古いバージョンのプランに基づいています。新しいプレビューを取得してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此请求使用了旧版计划。请重新请求预览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此請求使用了舊版計畫。請重新請求預覽。"
          }
        }
      }
    },
    "chat.planChange.feedback.sourcesPaused": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan Changes are paused because synchronized training is older than 24 hours. Refresh the connection, then request a fresh preview."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios del plan están en pausa porque los datos de entrenamiento se sincronizaron hace más de 24 horas. Actualiza la conexión y solicita una nueva vista previa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications du plan sont en pause, car les données d’entraînement synchronisées datent de plus de 24 heures. Actualise la connexion, puis demande un nouvel aperçu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche al piano sono in pausa perché i dati di allenamento sincronizzati risalgono a più di 24 ore fa. Aggiorna la connessione, poi richiedi una nuova anteprima."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Planänderungen sind pausiert, weil die synchronisierten Trainingsdaten älter als 24 Stunden sind. Aktualisiere die Verbindung und fordere dann eine neue Vorschau an."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigingen aan het trainingsschema zijn gepauzeerd omdat de gesynchroniseerde trainingsgegevens ouder zijn dan 24 uur. Vernieuw de verbinding en vraag daarna een nieuw wijzigingsvoorbeeld aan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ændringer af træningsplanen er sat på pause, fordi de synkroniserede træningsdata er over 24 timer gamle. Opdatér forbindelsen, og bed derefter om en ny forhåndsvisning."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Planändringar är pausade eftersom de synkroniserade träningsuppgifterna är äldre än 24 timmar. Uppdatera anslutningen och begär sedan en ny förhandsgranskning."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Planendringer er satt på pause fordi den synkroniserte treningen er eldre enn 24 timer. Oppdater tilkoblingen, og be deretter om en ny forhåndsvisning."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suunnitelman muutokset on keskeytetty, koska synkronoidut harjoitustiedot ovat yli 24 tuntia vanhoja. Päivitä yhteys ja pyydä sitten uusi esikatselu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações ao plano estão em pausa porque os dados de treino sincronizados têm mais de 24 horas. Atualiza a ligação e pede uma nova pré-visualização."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações ao plano estão em pausa porque os dados de treinamento sincronizados têm mais de 24 horas. Atualize a conexão e peça uma nova prévia."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany planu są wstrzymane, ponieważ zsynchronizowane dane treningowe mają ponad 24 godziny. Odśwież połączenie, a potem poproś o nowy podgląd."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화된 훈련 데이터가 24시간 이상 지나 계획 변경이 일시 중지되었습니다. 연결을 새로고침한 후 새 미리보기를 요청하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期されたトレーニングデータが24時間以上前のため、プランの変更を一時停止しています。接続を更新してから、新しいプレビューを取得してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步的训练数据已超过 24 小时未更新，计划更改已暂停。请刷新连接后重新请求预览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同步的訓練資料已超過 24 小時未更新，計畫變更已暫停。請重新整理連線後重新請求預覽。"
          }
        }
      }
    },
    "chat.planChange.feedback.sourcesResumed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sources are available again. Request a fresh preview before applying."
          }
        },
        "es": {
