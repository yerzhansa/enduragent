              "formatSpecifier": "@"
            },
            "telegram": {
              "argNum": 5,
              "formatSpecifier": "@"
            },
            "removeSender": {
              "argNum": 6,
              "formatSpecifier": "@"
            },
            "listSenders": {
              "argNum": 7,
              "formatSpecifier": "@"
            },
            "help": {
              "argNum": 8,
              "formatSpecifier": "@"
