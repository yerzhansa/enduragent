    "chat.spend.capReached": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ve reached today’s %#@amount@ spend cap. You can keep chatting; this is a warning, not a block."
          },
          "substitutions": {
            "amount": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has alcanzado el límite de gasto de hoy de %#@amount@. Puedes seguir chateando; es un aviso, no un bloqueo."
          },
          "substitutions": {
            "amount": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as atteint ton plafond de dépenses de %#@amount@ pour aujourd’hui. Tu peux continuer à discuter ; c’est un avertissement, pas un blocage."
          },
          "substitutions": {
            "amount": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai raggiunto il limite di spesa di oggi di %#@amount@. Puoi continuare a chattare. È solo un avviso, non un blocco."
          },
          "substitutions": {
            "amount": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast dein heutiges Ausgabenlimit von %#@amount@ erreicht. Du kannst weiterchatten; dies ist eine Warnung und keine Sperre."
          },
          "substitutions": {
            "amount": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt je uitgavenlimiet van %#@amount@ voor vandaag bereikt. Je kunt blijven chatten. Dit is een waarschuwing en blokkeert niets."
          },
          "substitutions": {
            "amount": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har nået dagens forbrugsgrænse på %#@amount@. Du kan fortsætte med at chatte. Dette er en advarsel, ikke en blokering."
          },
          "substitutions": {
            "amount": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har nått dagens kostnadsgräns på %#@amount@. Du kan fortsätta chatta. Det här är en varning och spärrar inte chatten."
          },
          "substitutions": {
            "amount": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har nådd dagens kostnadsgrense på %#@amount@. Du kan fortsette å chatte. Dette er et varsel, ikke en sperre."
          },
          "substitutions": {
            "amount": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet saavuttanut tämän päivän kulutusrajan %#@amount@. Voit jatkaa keskustelua. Tämä on varoitus, ei esto."
          },
          "substitutions": {
            "amount": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingiste o limite de despesa de %#@amount@ para hoje. Podes continuar a conversar; este aviso não bloqueia a conversa."
          },
          "substitutions": {
            "amount": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você atingiu o limite de gastos de %#@amount@ para hoje. Pode continuar conversando; este aviso não bloqueia a conversa."
          },
          "substitutions": {
            "amount": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzisiejszy limit wydatków %#@amount@ został osiągnięty. Możesz dalej rozmawiać. To ostrzeżenie, nie blokada."
          },
          "substitutions": {
            "amount": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 지출 한도 %#@amount@에 도달했습니다. 계속 채팅할 수 있습니다. 사용을 차단하지 않는 경고입니다."
          },
          "substitutions": {
            "amount": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本日の利用額が上限の%#@amount@に達しました。チャットは続けられます。これは警告であり、利用を制限するものではありません。"
          },
          "substitutions": {
            "amount": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今日花费已达到 %#@amount@ 的上限。仍可继续聊天，此提示不会阻止使用。"
          },
          "substitutions": {
            "amount": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今日花費已達到 %#@amount@ 的上限。仍可繼續聊天，此提示不會阻止使用。"
          },
          "substitutions": {
            "amount": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        }
      }
    },
