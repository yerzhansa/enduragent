            },
            "intervals": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계획이 지금 종료됩니다. 오늘의 워크아웃은 유지되며, 내일 이후의 %#@product@ 워크아웃은 %#@intervals@에서 삭제됩니다."
