    "plan.view.appliedHistory.approvedDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The approved change is part of your Plan. The seven-day %#@intervals@ update has not started yet."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cambio aprobado forma parte de tu Plan. La actualización de los siete días en %#@intervals@ aún no ha empezado."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La modification approuvée fait partie de ton plan. La mise à jour des sept jours dans %#@intervals@ n’a pas encore commencé."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modifica approvata fa parte del tuo piano. L’aggiornamento dei sette giorni su %#@intervals@ non è ancora iniziato."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die genehmigte Änderung ist Teil deines Plans. Die Aktualisierung der nächsten sieben Tage in %#@intervals@ wurde noch nicht gestartet."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De goedgekeurde wijziging maakt deel uit van je trainingsschema. Het bijwerken van zeven dagen in %#@intervals@ is nog niet gestart."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den godkendte ændring er en del af din træningsplan. Opdateringen af de syv dage i %#@intervals@ er endnu ikke startet."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den godkända ändringen ingår i din plan. Uppdateringen av sju dagar i %#@intervals@ har inte startat än."
