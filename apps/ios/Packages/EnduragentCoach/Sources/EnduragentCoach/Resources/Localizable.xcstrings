        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das heutige Training bleibt bestehen, während die Trainings ab morgen geprüft werden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vandaag blijft staan terwijl de schematrainingen vanaf morgen worden gecontroleerd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagens træning bliver bevaret, mens træningsplanens træninger fra i morgen og frem kontrolleres."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagens träningspass finns kvar medan planens träningspass från och med imorgon kontrolleras."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagens treningsøkt beholdes mens planens treningsøkter fra i morgen og fremover sjekkes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä päivä säilyy, kun suunnitelman harjoituksia huomisesta eteenpäin tarkistetaan."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O dia de hoje mantém-se enquanto os treinos do Plano a partir de amanhã são verificados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O treino de hoje permanece enquanto os treinos do plano a partir de amanhã são verificados."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzisiejszy trening pozostaje, a treningi planu od jutra są sprawdzane."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내일 이후의 계획 워크아웃을 확인하는 동안 오늘의 워크아웃은 유지됩니다."
