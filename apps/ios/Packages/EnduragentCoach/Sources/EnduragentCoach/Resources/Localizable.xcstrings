          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój bieżący plan pozostaje aktywny. Wersja robocza nowego planu otworzy się automatycznie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 계획은 계속 활성 상태로 유지됩니다. 대체 초안은 자동으로 열립니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のプランは引き続き有効です。置き換え用の下書きは自動的に開きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
