          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd exakt det ID som hör till de inloggningsuppgifter som redan är anslutna under Konfiguration."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk den nøyaktige identifikatoren som hører til tilgangsopplysningene som allerede er tilkoblet i Oppsett."
          }
        },
