        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "a gravação da memória não terminou antes de encerrar:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "a gravação da memória não terminou antes de encerrar:"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
