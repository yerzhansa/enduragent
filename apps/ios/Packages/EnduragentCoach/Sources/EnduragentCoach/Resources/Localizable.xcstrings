            "value": "Geen cachelezingen"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen læsninger fra cache"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga läsningar från cache"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen lesinger fra mellomlager"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei lukuja välimuistista"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem leituras da cache"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma leitura de cache"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak odczytów z pamięci podręcznej"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐시 읽기 없음"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュからの読み取りなし"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未读取缓存"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有快取讀取"
          }
        }
      }
    },
    "settings.spend.cache.providerDependent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provider-dependent caching; no explicit breakpoint on this route."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La caché depende del proveedor; no hay un punto de corte explícito en esta conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mise en cache selon le fournisseur ; aucun point de rupture explicite pour cette configuration."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cache dipende dal fornitore; nessun punto di interruzione esplicito per questa configurazione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anbieterabhängiges Caching; kein expliziter Cache-Haltepunkt für diese Verbindung."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Caching afhankelijk van de aanbieder, geen expliciet onderbrekingspunt op deze route."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udbyderafhængig caching. Intet eksplicit brudpunkt på denne rute."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Cachelagringen beror på leverantören. Ingen explicit brytpunkt har angetts för den här anslutningen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mellomlagring avhenger av leverandøren. Ingen eksplisitt grense for mellomlagring i dette treneroppsettet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Välimuistin käyttö riippuu palveluntarjoajasta. Tälle yhteydelle ei ole määritetty välimuistin katkaisukohtaa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache dependente do fornecedor, sem ponto de controlo explícito nesta ligação."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cache dependente do provedor; sem ponto de interrupção explícito nesta rota."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Buforowanie zależy od dostawcy; brak jawnego punktu podziału w tym połączeniu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐싱은 제공업체에 따라 다릅니다. 이 연결에는 명시적인 캐시 분할 지점이 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュはプロバイダーに依存します。この接続先には明示的な区切りを設定していません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缓存由服务商决定；此配置未设置显式缓存断点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快取取決於供應商；此教練連線未明確指定快取中斷點。"
          }
        }
      }
    },
