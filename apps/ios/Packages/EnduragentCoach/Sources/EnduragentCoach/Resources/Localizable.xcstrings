            }
          }
        },
        "nl": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%#@number@ van %#@total@ activiteiten is verborgen door %#@source@ en wordt daarom niet meegenomen. Door een API-beperking van %#@source@ kan %#@service@ activiteiten die van %#@source@ afkomstig zijn niet delen. Koppel voor toekomstige ritten je opnamebron rechtstreeks aan %#@service@ en houd %#@source@ gekoppeld. Gebruik voor eerdere ritten %#@importAction@ in de instellingen van %#@service@. Hiervoor is een supporterabonnement op %#@service@ nodig."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%#@number@ van %#@total@ activiteiten zijn verborgen door %#@source@ en worden daarom niet meegenomen. Door een API-beperking van %#@source@ kan %#@service@ activiteiten die van %#@source@ afkomstig zijn niet delen. Koppel voor toekomstige ritten je opnamebron rechtstreeks aan %#@service@ en houd %#@source@ gekoppeld. Gebruik voor eerdere ritten %#@importAction@ in de instellingen van %#@service@. Hiervoor is een supporterabonnement op %#@service@ nodig."
                }
              }
            }
          },
          "substitutions": {
