          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@reply@\n\nMin disk är full, så jag kunde inte spara det här i vår historik. Ditt meddelande kom fram. Frigör lite utrymme när du kan."
          },
          "substitutions": {
