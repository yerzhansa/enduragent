    "training.ride.effortsIntro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ranks measured five-minute power efforts from this ride only. It does not compare against other rides or all-history results."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clasifica los esfuerzos de potencia medidos de cinco minutos solo de esta salida. No los compara con otras salidas ni con los resultados de todo el historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Classe les efforts de puissance de cinq minutes mesurés uniquement sur cette sortie. Aucune comparaison avec d’autres sorties ni avec l’ensemble de l’historique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordina gli sforzi di potenza misurati su cinque minuti solo in questa uscita. Non li confronta con altre uscite o con i risultati dell’intera cronologia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordnet gemessene Fünf-Minuten-Leistungsbelastungen ausschließlich aus dieser Fahrt. Es erfolgt kein Vergleich mit anderen Fahrten oder Ergebnissen aus dem gesamten Verlauf."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rangschikt gemeten vermogensinspanningen van vijf minuten uit alleen deze rit. Er wordt niet vergeleken met andere ritten of resultaten uit de volledige geschiedenis."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Rangerer målte femminutters effektpræstationer kun fra denne tur. Der sammenlignes ikke med andre ture eller resultater fra hele historikken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rangordnar uppmätta femminutersinsatser efter effekt endast från den här cykelturen. Ingen jämförelse görs med andra cykelturer eller hela historiken."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rangerer målte femminutters wattprestasjoner bare fra denne turen. Sammenligner ikke med andre turer eller resultater fra hele historikken."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Asettaa mitatut viiden minuutin tehosuoritukset paremmuusjärjestykseen vain tältä lenkiltä. Niitä ei verrata muihin lenkkeihin tai koko historian tuloksiin."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordena os esforços de potência medidos de cinco minutos apenas desta volta. Não compara com outras voltas nem com resultados de todo o histórico."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Classifica os esforços de potência medidos de cinco minutos apenas desta pedalada. Não compara com outras pedaladas nem com os resultados de todo o histórico."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Porządkuje zmierzone pięciominutowe wysiłki mocy tylko z tego przejazdu. Nie porównuje ich z innymi przejazdami ani wynikami z całej historii."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 라이딩에서 측정한 5분 파워 기록만 순위를 매깁니다. 다른 라이딩이나 전체 기록과 비교하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このライドで測定した5分間のパワー記録のみを順位付けします。他のライドや全履歴の結果との比較は行いません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅对本次骑行中实测的五分钟功率表现排名。不会与其他骑行或全部历史结果对比。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅排列此騎乘中實測的五分鐘功率表現。不會與其他騎乘或全部歷史結果比較。"
          }
        }
      }
    },
