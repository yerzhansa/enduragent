    "telegram.sync.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorry, something went wrong syncing. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo siento, algo ha fallado al sincronizar. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désolé, une erreur s’est produite lors de la synchronisation. Réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi dispiace, qualcosa è andato storto nella sincronizzazione. Riprova."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entschuldige, beim Synchronisieren ist etwas schiefgelaufen. Versuche es bitte erneut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorry, er is iets misgegaan bij het synchroniseren. Probeer het opnieuw."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beklager, noget gik galt under synkroniseringen. Prøv igen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Något gick tyvärr fel vid synkroniseringen. Försök igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beklager, noe gikk galt under synkroniseringen. Prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pahoittelut, synkronoinnissa meni jokin pieleen. Yritä uudelleen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desculpa, algo correu mal ao sincronizar. Tenta novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desculpe, algo deu errado ao sincronizar. Tente novamente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przepraszam, coś poszło nie tak podczas synchronizacji. Spróbuj ponownie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "죄송합니다. 동기화 중 문제가 발생했습니다. 다시 시도해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すみません、同期中に問題が発生しました。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抱歉，同步时出了点问题。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "抱歉，同步時出了點問題。請重試。"
          }
        }
      }
    },
