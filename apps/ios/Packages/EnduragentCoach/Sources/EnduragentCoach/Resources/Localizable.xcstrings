    "settings.conversation.fields.idleMinutes.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whole minutes without a message before the conversation resets. Use 0 to turn this off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutos enteros sin mensajes antes de que se reinicie la conversación. Usa 0 para desactivarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre entier de minutes sans message avant la réinitialisation de la conversation. Utilise 0 pour désactiver cette option."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Minuti interi senza messaggi prima di reimpostare la conversazione. Usa 0 per disattivare questa funzione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganze Minuten ohne Nachricht, bevor das Gespräch zurückgesetzt wird. Mit 0 deaktivierst du diese Funktion."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aantal hele minuten zonder bericht voordat het gesprek opnieuw begint. Gebruik 0 om dit uit te schakelen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hele minutter uden en besked, før samtalen nulstilles. Brug 0 for at slå dette fra."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hela minuter utan meddelanden innan samtalet återställs. Ange 0 för att stänga av detta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hele minutter uten en melding før samtalen nullstilles. Bruk 0 for å slå dette av."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokonaiset minuutit ilman viestiä ennen keskustelun nollausta. Poista käytöstä arvolla 0."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutos inteiros sem mensagens até a conversa reiniciar. Usa 0 para desativar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutos inteiros sem mensagens até a conversa reiniciar. Use 0 para desativar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczba pełnych minut bez wiadomości, po której rozmowa jest resetowana. Wpisz 0, aby wyłączyć tę opcję."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지가 없는 상태에서 대화를 초기화하기까지 기다릴 시간을 분 단위 정수로 입력합니다. 0으로 설정하면 끕니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージがない状態が何分続くと会話をリセットするか、整数で指定します。0にすると無効になります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连续多久没有消息后重置对话，以整数分钟计。设为 0 可关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未傳送訊息達到此整數分鐘數後，即重設對話。設為 0 可關閉此功能。"
          }
        }
      }
    },
