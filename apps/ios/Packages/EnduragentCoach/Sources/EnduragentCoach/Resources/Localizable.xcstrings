    "chat.planCreation.discardDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your answers are discarded. Your active Plan, Schedule, restrictions, saved preferences, and history stay unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se descartan tus respuestas. Tu plan activo, calendario de entrenamiento, restricciones, preferencias guardadas e historial no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes réponses seront abandonnées. Ton plan actif, ton planning, tes restrictions, tes préférences enregistrées et ton historique resteront inchangés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue risposte verranno eliminate. Il piano attivo, la programmazione, le restrizioni, le preferenze salvate e la cronologia restano invariati."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Antworten werden verworfen. Dein aktiver Plan, Zeitplan, deine Einschränkungen, gespeicherten Einstellungen und dein Verlauf bleiben unverändert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je antwoorden worden verworpen. Je actieve trainingsschema, planning, beperkingen, opgeslagen voorkeuren en geschiedenis blijven ongewijzigd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine svar bliver kasseret. Din aktive træningsplan, tidsplan, begrænsninger, gemte præferencer og historik forbliver uændrede."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina svar kastas. Din aktiva plan, ditt schema, dina begränsningar, sparade inställningar och din historik är oförändrade."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svarene dine forkastes. Den aktive planen, timeplanen, begrensninger, lagrede innstillinger og historikken din forblir uendret."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastauksesi hylätään. Aktiivinen suunnitelmasi, aikataulusi, rajoituksesi, tallennetut asetuksesi ja historiasi säilyvät ennallaan."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As tuas respostas serão descartadas. O teu plano ativo, horário, restrições, preferências guardadas e histórico mantêm-se."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas respostas serão descartadas. Seu plano ativo, programação, restrições, preferências salvas e histórico permanecem inalterados."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje odpowiedzi zostaną odrzucone. Aktywny plan, harmonogram, ograniczenia, zapisane preferencje i historia pozostaną bez zmian."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변이 삭제됩니다. 활성 계획, 일정, 제한, 저장된 환경설정 및 기록은 변경되지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答を破棄します。有効なプラン、スケジュール、制限、保存済みの環境設定、履歴は変更されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回答将被丢弃。当前启用的计划、日程、限制、已保存的偏好和历史记录保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回答將被捨棄。目前啟用的計畫、日程、限制、已儲存的偏好與歷史記錄維持不變。"
          }
        }
      }
    },
