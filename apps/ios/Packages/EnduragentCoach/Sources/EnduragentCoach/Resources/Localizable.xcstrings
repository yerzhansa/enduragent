          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向 %#@botFather@ 申请机器人，复制其令牌后返回此处。%#@product@ 直接从剪贴板读取并验证令牌，不会显示令牌。"
          },
          "substitutions": {
            "botFather": {
              "argNum": 1,
              "formatSpecifier": "@"
