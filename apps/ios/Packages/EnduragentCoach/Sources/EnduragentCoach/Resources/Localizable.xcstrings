            "state": "translated",
            "value": "Limita tu solicitud de cambio a 500 caracteres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite ta demande de modification à 500 caractères."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita la richiesta di modifica a 500 caratteri."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
