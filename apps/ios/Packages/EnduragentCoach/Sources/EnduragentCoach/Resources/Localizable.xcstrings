    "plan.view.active.lifecycleActionsDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace or end future Plan management. Today's workout stays."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustituye el Plan o termina la gestión de sus entrenamientos futuros. El entrenamiento de hoy se conserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace le plan ou mets fin à la gestion des entraînements à venir. L’entraînement d’aujourd’hui est conservé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituisci o termina la gestione degli allenamenti futuri del piano. L’allenamento di oggi rimane."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetze oder beende die künftige Planverwaltung. Das heutige Training bleibt bestehen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vervang of beëindig het beheer van toekomstige trainingen in het schema. De training van vandaag blijft staan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstat eller afslut træningsplanens styring af fremtidig træning. Dagens træning bliver bevaret."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersätt eller avsluta hanteringen av framtida träning i planen. Dagens träningspass finns kvar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstatt eller avslutt videre styring av planen. Dagens treningsøkt beholdes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korvaa suunnitelma tai lopeta sen tulevan harjoittelun hallinta. Tämän päivän harjoitus säilyy."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitui ou termina a gestão futura do Plano. O treino de hoje mantém-se."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitua ou encerre o gerenciamento dos treinos futuros do plano. O treino de hoje permanece."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastąp plan lub zakończ zarządzanie przyszłymi treningami. Dzisiejszy trening pozostaje."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "향후 계획 관리를 새 계획으로 대체하거나 종료합니다. 오늘의 워크아웃은 유지됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後のプラン管理を置き換えるか終了します。今日のワークアウトは残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "替换或结束后续计划管理。今天的训练课程会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "替換或結束後續的計畫管理。今天的訓練課表會保留。"
          }
        }
      }
    },
    "plan.view.active.matchConfirmationDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The date, sport, and duration look similar. Confirm before it counts as the planned workout."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha, el deporte y la duración parecen similares. Confirma la correspondencia antes de que cuente como el entrenamiento planificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date, le sport et la durée semblent correspondre. Confirme pour que cette activité compte comme l’entraînement prévu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La data, lo sport e la durata sembrano corrispondere. Conferma prima che l’attività venga conteggiata come allenamento programmato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datum, Sportart und Dauer sind ähnlich. Bestätige die Zuordnung, bevor die Aktivität als geplantes Training zählt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De datum, sport en duur lijken overeen te komen. Bevestig de koppeling voordat deze activiteit als de geplande training telt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dato, sportsgren og varighed ligner hinanden. Bekræft, før aktiviteten tæller som den planlagte træning."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Datum, sport och varaktighet verkar stämma. Bekräfta innan aktiviteten räknas som det planerade träningspasset."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dato, idrett og varighet ser ut til å stemme. Bekreft før aktiviteten regnes som den planlagte treningsøkten."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivämäärä, laji ja kesto näyttävät vastaavan toisiaan. Vahvista vastaavuus, ennen kuin suoritus lasketaan suunnitelluksi harjoitukseksi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A data, o desporto e a duração parecem semelhantes. Confirma antes de contar como o treino planeado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A data, a modalidade e a duração parecem semelhantes. Confirme antes de contar esta atividade como o treino planejado."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Data, dyscyplina i czas trwania są podobne. Potwierdź dopasowanie, zanim aktywność zostanie zaliczona jako zaplanowany trening."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜, 종목 및 시간이 비슷합니다. 예정된 워크아웃으로 집계하기 전에 연결을 확인하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付、種目、時間が似ています。予定されたワークアウトとして扱う前に、一致を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日期、运动类型和时长相近。确认后，此活动才会计为已完成的计划训练课程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "日期、運動項目與時長相近。請先確認，才能將此活動計為已完成的計畫訓練課表。"
          }
        }
      }
    },
    "plan.view.active.matchesPending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Workout matches appear after activity sync."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las correspondencias entre entrenamientos y actividades aparecen tras sincronizar las actividades."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les correspondances avec les entraînements apparaissent après la synchronisation des activités."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli abbinamenti degli allenamenti compaiono dopo la sincronizzazione delle attività."
          }
        },
        "de": {
