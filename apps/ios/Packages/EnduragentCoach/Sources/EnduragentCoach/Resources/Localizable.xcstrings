    "training.response.scatterCaption": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retained power and heart-rate ride segments"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Segmentos conservados de potencia y frecuencia cardiaca de la salida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Segments de sortie retenus avec puissance et fréquence cardiaque"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segmenti dell’uscita mantenuti con potenza e frequenza cardiaca"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beibehaltene Fahrtabschnitte mit Leistung und Herzfrequenz"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Behouden ritsegmenten met vermogen en hartslag"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevarede tursegmenter med effekt og puls"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Behållna cykelsegment med effekt och puls"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beholdte tursegmenter med watt og puls"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Säilytetyt lenkin teho- ja sykejaksot"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Segmentos de potência e frequência cardíaca da volta mantidos"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segmentos de potência e frequência cardíaca mantidos da pedalada"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowane odcinki przejazdu z mocą i tętnem"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유지된 파워 및 심박수 라이딩 구간"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分析対象のライド区間のパワーと心拍数"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留的骑行功率和心率片段"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留的騎乘功率與心率區段"
          }
        }
      }
    },
    "training.response.scatterDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each dot is one retained server-cleaned ride segment: power is horizontal and lag-adjusted heart rate is vertical. No missing points or lines are interpolated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada punto es un segmento de la salida depurado por el servidor y conservado: la potencia se muestra en horizontal y la frecuencia cardiaca con el retraso ajustado, en vertical. No se interpolan los puntos ni las líneas que faltan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque point représente un segment de sortie retenu après nettoyage par le serveur : la puissance est en abscisse et la fréquence cardiaque corrigée du décalage en ordonnée. Aucun point ni aucune ligne manquante n’est interpolé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni punto è un segmento dell’uscita mantenuto dopo la pulizia dei dati sul server: la potenza è sull’asse orizzontale e la frequenza cardiaca corretta per il ritardo su quello verticale. Non vengono interpolati punti o linee mancanti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Punkt ist ein beibehaltener, vom Server bereinigter Fahrtabschnitt: Leistung auf der horizontalen Achse, verzögerungskorrigierte Herzfrequenz auf der vertikalen. Fehlende Punkte oder Linien werden nicht interpoliert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk punt is één behouden ritsegment dat door de server is opgeschoond. Vermogen staat horizontaal en de voor vertraging gecorrigeerde hartslag verticaal. Ontbrekende punten of lijnen worden niet geïnterpoleerd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver prik er ét tursegment bevaret efter serverens datarensning. Effekten vises vandret, og pulsen med justering for forsinkelse vises lodret. Manglende punkter eller linjer interpoleres ikke."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje punkt är ett behållet cykelsegment som servern har rensat: effekt visas vågrätt och puls justerad för fördröjning lodrätt. Inga saknade punkter eller linjer interpoleras."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert punkt er ett beholdt tursegment med data renset av serveren. Watt vises vannrett og puls justert for forsinkelse loddrett. Ingen manglende punkter eller linjer interpoleres."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen piste on yksi palvelimen puhdistama ja säilyttämä lenkin jakso. Teho on vaaka-akselilla ja viivekorjattu syke pystyakselilla. Puuttuvia pisteitä tai viivoja ei interpoloida."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ponto é um segmento da volta tratado pelo servidor e mantido: a potência está na horizontal e a frequência cardíaca ajustada ao atraso está na vertical. Não são interpolados pontos nem linhas em falta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ponto é um segmento da pedalada mantido após o tratamento dos dados pelo servidor: a potência está na horizontal e a frequência cardíaca com ajuste do atraso está na vertical. Nenhum ponto ou linha ausente é interpolado."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda kropka to jeden zachowany odcinek przejazdu po oczyszczeniu danych na serwerze. Moc jest na osi poziomej, a tętno po korekcie opóźnienia na pionowej. Brakujące punkty ani linie nie są interpolowane."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 점은 서버에서 정제한 후 유지된 라이딩 구간 하나입니다. 가로축은 파워, 세로축은 지연을 보정한 심박수입니다. 누락된 점이나 선은 보간하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各点は、サーバーでデータを整理した分析対象のライド区間1つを表します。横軸はパワー、縦軸は反応の遅れを補正した心拍数です。欠測点や線は補間しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个点代表一个经服务器清理后保留的骑行片段：横轴为功率，纵轴为滞后校正后的心率。不会插值补全缺失的点或线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個點代表伺服器清理資料後保留的一個騎乘區段：橫軸為功率，縱軸為延遲校正後的心率。不會以內插法補上缺少的點或線。"
          }
        }
      }
    },
