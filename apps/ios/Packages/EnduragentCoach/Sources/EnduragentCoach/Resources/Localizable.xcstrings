          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här stänger av %#@telegram@ och tar bort den krypterade token och behöriga användares åtkomst från %#@computer@. %#@telegram@-boten och chatten finns kvar i %#@telegram@."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "computer": {
              "argNum": 2,
