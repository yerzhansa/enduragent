          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięcie starego planu zweryfikowano przed zapisaniem kopii nowego planu w kalendarzu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
