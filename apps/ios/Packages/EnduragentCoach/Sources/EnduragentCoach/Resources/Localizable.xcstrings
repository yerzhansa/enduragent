    "settings.conversation.fields.historyTokenBudgetRatio.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share of the model context reserved for conversation history, above 0%% and up to 100%%."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Porcentaje del contexto del modelo reservado al historial de conversación, superior al 0 %% y hasta el 100 %%."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Part du contexte du modèle réservée à l’historique de conversation, supérieure à 0 %% et jusqu’à 100 %%."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quota del contesto del modello riservata alla cronologia della conversazione, superiore allo 0%% e fino al 100%%."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteil des Modellkontexts für den Gesprächsverlauf, mehr als 0 %% und bis zu 100 %%."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel van de modelcontext dat is gereserveerd voor de gespreksgeschiedenis, meer dan 0%% en maximaal 100%%."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Andel af modellens kontekst, der er reserveret til samtalehistorik, over 0 %% og op til 100 %%."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Andel av modellens kontext som reserveras för samtalshistorik, över 0 %% och upp till 100 %%."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Andel av modellens kontekst som er reservert for samtalehistorikk, over 0 %% og opptil 100 %%."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskusteluhistorialle varattu osuus mallin kontekstista, yli 0 %% ja enintään 100 %%."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Percentagem do contexto do modelo reservada ao histórico da conversa, superior a 0%% e até 100%%."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcela do contexto do modelo reservada ao histórico de conversa, acima de 0%% e até 100%%."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Część kontekstu modelu zarezerwowana na historię rozmowy, powyżej 0%% i do 100%%."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델이 처리할 수 있는 맥락 중 대화 기록에 할당할 비율로, 0%% 초과 100%% 이하입니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルが参照できる情報量のうち、会話履歴に割り当てる割合です。0%%より大きく、100%%以下で指定します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为历史对话预留的模型上下文比例，须大于 0%% 且不超过 100%%。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型上下文中保留給對話記錄的比例，須大於 0%% 且不超過 100%%。"
          }
        }
      }
    },
