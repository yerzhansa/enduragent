    "chat.attachment.documentDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach can read this file through managed attachment tools."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El entrenador puede leer este archivo con las herramientas de gestión de adjuntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le coach peut lire ce fichier avec les outils de gestion des pièces jointes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il coach può leggere questo file tramite gli strumenti di gestione degli allegati."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Coach kann diese Datei mit den verwalteten Anhangswerkzeugen lesen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De coach kan dit bestand lezen via de beheerde hulpmiddelen voor bijlagen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træneren kan læse denne fil via de administrerede værktøjer til vedhæftede filer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tränaren kan läsa filen med verktygen för bilagor."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Treneren kan lese denne filen med de innebygde verktøyene for vedlegg."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valmentaja voi lukea tämän tiedoston hallittujen liitetyökalujen avulla."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O treinador pode ler este ficheiro através das ferramentas de anexos geridas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O treinador pode ler este arquivo pelas ferramentas de anexos gerenciadas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trener może odczytać ten plik za pomocą zarządzanych narzędzi do załączników."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코치가 관리형 첨부 도구를 통해 이 파일을 읽을 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コーチは管理された添付ファイル用ツールを使ってこのファイルを読めます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "教练可通过受管理的附件工具读取此文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "教練可透過受管理的附件工具讀取此檔案。"
          }
        }
      }
    },
