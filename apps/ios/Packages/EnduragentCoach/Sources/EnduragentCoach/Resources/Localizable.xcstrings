    "desktop.lifecycle.restartExhaustedContent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The background service stopped repeatedly and %#@product@ could not restart it. Quit %#@product@ and reopen it. If that does not help, log out and back in."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio en segundo plano se detuvo varias veces y %#@product@ no pudo reiniciarlo. Cierra %#@product@ y vuelve a abrirlo. Si eso no ayuda, cierra sesión y vuelve a iniciarla."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service en arrière-plan s'est arrêté plusieurs fois et %#@product@ n'a pas pu le redémarrer. Quitte %#@product@ et rouvre-le. Si cela ne résout pas le problème, ferme ta session et reconnecte-toi."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio in background si è interrotto più volte e %#@product@ non è riuscito a riavviarlo. Chiudi %#@product@ e riaprilo. Se il problema persiste, esci dalla sessione e accedi di nuovo."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hintergrunddienst wurde wiederholt beendet und %#@product@ konnte ihn nicht neu starten. Beende %#@product@ und öffne es erneut. Wenn das nicht hilft, melde dich ab und wieder an."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De achtergrondservice is herhaaldelijk gestopt en %#@product@ kon deze niet opnieuw starten. Sluit %#@product@ af en open het opnieuw. Helpt dat niet, log dan uit en weer in."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Baggrundstjenesten stoppede gentagne gange, og %#@product@ kunne ikke genstarte den. Afslut %#@product@, og åbn det igen. Hvis det ikke hjælper, så log ud og ind igen."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakgrundstjänsten stannade upprepade gånger och %#@product@ kunde inte starta om den. Avsluta %#@product@ och öppna det igen. Om det inte hjälper, logga ut och in igen."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakgrunnstjenesten stoppet gjentatte ganger, og %#@product@ kunne ikke starte den på nytt. Avslutt %#@product@, og åpne det på nytt. Hvis det ikke hjelper, logger du ut og inn igjen."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Taustapalvelu pysähtyi toistuvasti, eikä %#@product@ voinut käynnistää sitä uudelleen. Lopeta %#@product@ ja avaa se uudelleen. Jos se ei auta, kirjaudu ulos ja takaisin sisään."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço em segundo plano parou repetidamente e %#@product@ não conseguiu reiniciá-lo. Encerra %#@product@ e volta a abri-lo. Se isso não ajudar, termina sessão e volta a iniciá-la."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço em segundo plano parou repetidamente e %#@product@ não conseguiu reiniciá-lo. Encerre %#@product@ e reabra o aplicativo. Se isso não ajudar, saia da sessão e entre novamente."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usługa w tle wielokrotnie się zatrzymała i %#@product@ nie zdołał jej ponownie uruchomić. Zamknij %#@product@ i otwórz go ponownie. Jeśli to nie pomoże, wyloguj się i zaloguj ponownie."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드 서비스가 반복해서 중지되어 %#@product@에서 다시 시작하지 못했습니다. %#@product@을(를) 종료하고 다시 여세요. 그래도 해결되지 않으면 로그아웃한 후 다시 로그인하세요."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドサービスが繰り返し停止し、%#@product@で再起動できませんでした。%#@product@を終了して開き直してください。解決しない場合は、ログアウトしてからログインし直してください。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台服务多次停止，%#@product@ 无法将其重启。请退出并重新打开 %#@product@。如果仍未解决，请注销后重新登录。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "背景服務反覆停止，%#@product@ 無法將其重新啟動。請結束並重新開啟 %#@product@。若仍未解決，請登出後重新登入。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        }
      }
    },
