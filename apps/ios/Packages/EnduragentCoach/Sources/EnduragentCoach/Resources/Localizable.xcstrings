            "value": "%#@operatingSystem@에서는 %#@codex@ 에이전트를 지원하지 않습니다. %#@claude@ 구독 또는 API 키 제공업체를 선택한 후 코치 연결을 저장하세요. 인증 정보, 선수 데이터, 대화 및 기타 설정은 그대로 유지됩니다."
          },
          "substitutions": {
            "codex": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "operatingSystem": {
              "argNum": 2,
              "formatSpecifier": "@"
            },
            "claude": {
              "argNum": 3,
              "formatSpecifier": "@"
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@codex@エージェントは%#@operatingSystem@に対応していません。%#@claude@サブスクリプションまたはAPIキーを使うプロバイダーを選び、コーチの接続先を保存してください。認証情報、アスリートデータ、会話、その他の設定は変更されません。"
          },
          "substitutions": {
            "codex": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "operatingSystem": {
              "argNum": 2,
              "formatSpecifier": "@"
            },
            "claude": {
              "argNum": 3,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@operatingSystem@ 不支持 %#@codex@ 智能体。请选择 %#@claude@ 订阅或使用 API 密钥的服务商，然后保存教练配置。凭据、运动员数据、对话及其他设置保持不变。"
          },
          "substitutions": {
            "codex": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "operatingSystem": {
              "argNum": 2,
              "formatSpecifier": "@"
            },
            "claude": {
              "argNum": 3,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@operatingSystem@ 不支援 %#@codex@ 代理程式。請選擇 %#@claude@ 訂閱或使用 API 金鑰的供應商，再儲存教練連線。憑證、運動員資料、對話及其他設定不會變更。"
          },
          "substitutions": {
            "codex": {
              "argNum": 1,
              "formatSpecifier": "@"
