          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu objetivo de evento continua sendo %#@value1@. Inicie um novo plano de preparação para o evento quando faltarem no máximo 24 semanas."
          },
          "substitutions": {
            "value1": {
