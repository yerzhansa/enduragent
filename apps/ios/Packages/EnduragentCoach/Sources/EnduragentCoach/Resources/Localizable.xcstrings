    "telegram.review.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorry, something went wrong reviewing your session. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo siento, algo ha fallado al revisar tu sesión. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désolé, une erreur s’est produite lors de l’analyse de ta séance. Réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mi dispiace, qualcosa è andato storto nell’analisi della tua sessione. Riprova."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entschuldige, bei der Auswertung deiner Einheit ist etwas schiefgelaufen. Versuche es bitte erneut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorry, er is iets misgegaan bij het bekijken van je training. Probeer het opnieuw."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Beklager, noget gik galt, da jeg gennemgik din træning. Prøv igen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Något gick tyvärr fel när jag gick igenom ditt träningspass. Försök igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Beklager, noe gikk galt da jeg gikk gjennom treningsøkten din. Prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pahoittelut, harjoituksesi tarkistamisessa meni jokin pieleen. Yritä uudelleen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desculpa, algo correu mal ao rever o teu treino. Tenta novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desculpe, algo deu errado ao revisar seu treino. Tente novamente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przepraszam, coś poszło nie tak podczas analizy treningu. Spróbuj ponownie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "죄송합니다. 훈련을 돌아보는 중 문제가 발생했습니다. 다시 시도해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すみません、トレーニングを振り返る途中で問題が発生しました。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抱歉，回顾训练时出了点问题。请重试。"
