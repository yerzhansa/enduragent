            "value": "Käytä täsmälleen sitä tunnusta, joka liittyy käyttöönotossa jo yhdistettyyn tunnistautumistietoon."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa o identificador exato associado à credencial já ligada em Configuração."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o identificador exato associado à credencial já conectada em Configuração."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj dokładnego identyfikatora powiązanego z danymi dostępowymi połączonymi już w Konfiguracji."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
