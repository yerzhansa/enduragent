    "settings.telegram.attention.unsafeBackend": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No secure credential backend is available, so %#@product@ refused to access the saved bot token without encryption. Quit and reopen %#@product@, then choose Check again."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay un sistema seguro de almacenamiento de credenciales disponible, por lo que %#@product@ ha rechazado acceder al token guardado del bot sin cifrado. Cierra y vuelve a abrir %#@product@ y elige Comprobar de nuevo."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun système de stockage sécurisé des données d’authentification n’est disponible. %#@product@ a donc refusé d’accéder au jeton du bot enregistré sans chiffrement. Quitte et rouvre %#@product@, puis choisis Vérifier à nouveau."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è disponibile un sistema sicuro per le credenziali, quindi %#@product@ ha rifiutato di accedere al token del bot salvato senza crittografia. Chiudi e riapri %#@product@, poi scegli Controlla di nuovo."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist kein sicherer Speicher für Zugangsdaten verfügbar. Daher hat %#@product@ den unverschlüsselten Zugriff auf das gespeicherte Bot-Token verweigert. Beende %#@product@, öffne es erneut und wähle dann „Erneut prüfen“."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen beveiligde opslag voor toegangsgegevens beschikbaar. Daarom heeft %#@product@ de toegang tot het opgeslagen bottoken zonder versleuteling geweigerd. Sluit %#@product@ af, open het opnieuw en kies Opnieuw controleren."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ingen sikker lagring af adgangsoplysninger tilgængelig, så %#@product@ afviste at tilgå det gemte bottoken uden kryptering. Luk og åbn %#@product@ igen, og vælg derefter Kontrollér igen."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen säker lagring av inloggningsuppgifter är tillgänglig, så %#@product@ vägrade komma åt botens sparade token utan kryptering. Avsluta och öppna %#@product@ igen och välj sedan Kontrollera igen."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen sikker lagring av tilgangsopplysninger er tilgjengelig, så %#@product@ nektet å åpne det lagrede bottokenet uten kryptering. Avslutt og åpne %#@product@ igjen, og velg Sjekk igjen."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suojattua tunnistautumistietojen tallennusjärjestelmää ei ole käytettävissä, joten %#@product@ kieltäytyi käyttämästä tallennettua botin tunnistetta ilman salausta. Sulje %#@product@ ja avaa se uudelleen. Valitse sitten Tarkista uudelleen."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há nenhum sistema seguro de armazenamento de credenciais disponível, pelo que %#@product@ recusou aceder ao token guardado do bot sem encriptação. Fecha e volta a abrir %#@product@ e escolhe Verificar novamente."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há um sistema seguro de armazenamento de credenciais disponível, então %#@product@ se recusou a acessar o token salvo do bot sem criptografia. Feche e reabra %#@product@ e selecione Verificar novamente."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak bezpiecznego magazynu danych dostępowych, więc %#@product@ odmówił dostępu do zapisanego tokena bota bez szyfrowania. Zamknij i otwórz ponownie %#@product@, a następnie wybierz Sprawdź ponownie."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 가능한 보안 인증 정보 저장소가 없어 %#@product@에서 암호화 없이 저장된 봇 토큰에 접근하는 것을 거부했습니다. %#@product@을(를) 종료하고 다시 연 후 다시 확인을 선택하세요."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全な認証情報ストレージを利用できないため、%#@product@は暗号化せずに保存済みのボットトークンにアクセスすることを拒否しました。%#@product@を終了して開き直し、「再確認」を選んでください。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可用的安全凭据存储后端，因此 %#@product@ 拒绝在未加密的情况下访问已保存的机器人令牌。请退出并重新打开 %#@product@，然后选择“重新检查”。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可用的安全憑證儲存後端，因此 %#@product@ 拒絕在未加密的情況下存取已儲存的機器人權杖。請結束並重新開啟 %#@product@，再選擇「再次檢查」。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        }
      }
    },
