    "setup.chatSubtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect what your coach needs. %#@telegram@ is optional and never blocks Chat."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta lo que necesita tu entrenador. %#@telegram@ es opcional y nunca bloquea el chat."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecte ce dont ton coach a besoin. %#@telegram@ est facultatif et ne bloque jamais la Discussion."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega ciò che serve al tuo coach. %#@telegram@ è facoltativo e non blocca mai la Chat."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde, was dein Coach benötigt. %#@telegram@ ist optional und blockiert den Chat nie."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppel wat je coach nodig heeft. %#@telegram@ is optioneel en blokkeert Chat nooit."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilknyt det, din træner har brug for. %#@telegram@ er valgfri og blokerer aldrig Chat."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut det din tränare behöver. %#@telegram@ är valfritt och blockerar aldrig chatten."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble til det treneren din trenger. %#@telegram@ er valgfritt og blokkerer aldri Chat."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistä valmentajasi tarvitsemat palvelut. %#@telegram@ on valinnainen eikä koskaan estä keskustelua."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Liga o que o teu treinador precisa. %#@telegram@ é opcional e nunca bloqueia a Conversa."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte o que seu treinador precisa. %#@telegram@ é opcional e nunca bloqueia o Chat."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz to, czego potrzebuje trener. %#@telegram@ jest opcjonalny i nigdy nie blokuje Czatu."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코치에 필요한 항목을 연결하세요. %#@telegram@은(는) 선택 사항이며 연결하지 않아도 채팅할 수 있습니다."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コーチに必要な接続を設定してください。%#@telegram@は任意で、未設定でもチャットを利用できます。"
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接教练所需的服务。%#@telegram@ 为可选项，不会阻止使用聊天。"
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連結教練需要的服務。%#@telegram@ 為選用項目，不會影響聊天功能。"
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        }
      }
    },
    "setup.chatgpt.activationFailure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signed in, but the coach could not be activated. Retry without signing in again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesión iniciada, pero no se ha podido activar el entrenador. Reintenta sin volver a iniciar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté, mais le coach n’a pas pu être activé. Réessaie sans te reconnecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso effettuato, ma impossibile attivare il coach. Riprova senza effettuare di nuovo l’accesso."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angemeldet, aber der Coach konnte nicht aktiviert werden. Versuche es erneut, ohne dich nochmals anzumelden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aangemeld, maar de coach kon niet worden geactiveerd. Probeer het opnieuw zonder je opnieuw aan te melden."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Logget ind, men træneren kunne ikke aktiveres. Prøv igen uden at logge ind igen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är inloggad, men tränaren kunde inte aktiveras. Försök igen utan att logga in på nytt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pålogget, men treneren kunne ikke aktiveres. Prøv igjen uten å logge på på nytt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjautuminen onnistui, mutta valmentajaa ei voitu ottaa käyttöön. Yritä uudelleen kirjautumatta uudelleen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessão iniciada, mas não foi possível ativar o treinador. Tenta novamente sem voltares a iniciar sessão."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessão iniciada, mas não foi possível ativar o treinador. Tente novamente sem entrar outra vez."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalogowano, ale nie udało się aktywować trenera. Spróbuj ponownie bez ponownego logowania."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인되었지만 코치를 활성화하지 못했습니다. 다시 로그인하지 않고 재시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインは完了しましたが、コーチを有効にできませんでした。サインインし直さずに再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已登录，但无法启用教练。可直接重试，无需重新登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已登入，但無法啟用教練。請重試，不必再次登入。"
          }
        }
      }
    },
