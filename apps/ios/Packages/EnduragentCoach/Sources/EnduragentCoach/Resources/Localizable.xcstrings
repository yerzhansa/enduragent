    "chat.planCreation.feedback.activationUncertain": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The activation result could not be confirmed. The Plan library will show the current state after refresh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar el resultado de la activación. La biblioteca de planes mostrará el estado actual al actualizarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat de l’activation n’a pas pu être confirmé. La bibliothèque de plans affichera l’état actuel après actualisation."
          }
        },
        "it": {
          "stringUnit": {
