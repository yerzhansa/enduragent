    "settings.telegram.webhook.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@telegram@ cannot deliver to a webhook and %#@computer@ at the same time. This explicit action keeps pending updates and lets Desktop begin polling."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "computer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@telegram@ no puede enviar a un webhook y a %#@computer@ al mismo tiempo. Esta acción explícita conserva las actualizaciones pendientes y permite que la aplicación de escritorio empiece a consultar."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "computer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@telegram@ ne peut pas transmettre à un webhook et à %#@computer@ en même temps. Cette action explicite conserve les mises à jour en attente et permet à l’application de bureau de commencer l’interrogation."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "computer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@telegram@ non può inviare a un webhook e a %#@computer@ contemporaneamente. Questa azione esplicita conserva gli aggiornamenti in attesa e consente all’app desktop di iniziare il polling."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "computer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@telegram@ kann nicht gleichzeitig an einen Webhook und %#@computer@ zustellen. Diese ausdrückliche Aktion behält ausstehende Updates bei und ermöglicht der Desktop-App, Nachrichten abzurufen."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "computer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@telegram@ kan niet tegelijk aan een webhook en %#@computer@ leveren. Deze expliciete actie behoudt wachtende updates en laat Desktop beginnen met het ophalen van updates."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "computer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@telegram@ kan ikke levere til en webhook og %#@computer@ samtidig. Denne udtrykkelige handling bevarer ventende opdateringer og lader Desktop begynde at hente opdateringer."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "computer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@telegram@ kan inte leverera till en webhook och %#@computer@ samtidigt. Den här åtgärden behåller väntande uppdateringar och låter datorappen börja hämta meddelanden."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "computer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@telegram@ kan ikke levere til en webhook og %#@computer@ samtidig. Denne handlingen beholder ventende oppdateringer og lar skrivebordsappen begynne å hente meldinger."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "computer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@telegram@ ei voi toimittaa viestejä webhookiin ja tietokoneelle %#@computer@ samanaikaisesti. Tämä toiminto säilyttää odottavat päivitykset ja antaa työpöytäsovelluksen aloittaa viestien haun."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "computer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@telegram@ não pode entregar mensagens a um webhook e a %#@computer@ ao mesmo tempo. Esta ação explícita mantém as atualizações pendentes e permite à aplicação de computador começar a consultar mensagens."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "computer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@telegram@ não pode entregar a um webhook e a %#@computer@ ao mesmo tempo. Esta ação explícita mantém as atualizações pendentes e permite que o aplicativo de computador comece a consultar o bot."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "computer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@telegram@ nie może dostarczać wiadomości do webhooka i %#@computer@ jednocześnie. Ta czynność zachowuje oczekujące aktualizacje i pozwala aplikacji komputerowej rozpocząć odpytywanie."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "computer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@telegram@은(는) 웹훅과 %#@computer@에 동시에 전달할 수 없습니다. 이 작업을 직접 실행하면 대기 중인 업데이트는 유지되고 데스크톱 앱에서 폴링을 시작할 수 있습니다."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "computer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@telegram@はWebhookと%#@computer@に同時に配信できません。この操作では保留中の更新を維持し、デスクトップアプリがポーリングを開始できるようにします。"
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "computer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@telegram@ 无法同时向 webhook 和 %#@computer@ 发送消息。此手动操作会保留待处理的更新，并让桌面应用开始轮询。"
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "computer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@telegram@ 無法同時傳送至 webhook 與 %#@computer@。此操作會保留待處理的更新，並讓桌面應用程式開始輪詢。"
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "computer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        }
      }
    },
