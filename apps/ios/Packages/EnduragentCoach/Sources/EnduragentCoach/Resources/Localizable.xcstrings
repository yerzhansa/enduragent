        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Cykelturens tidslinje innehåller ogiltiga tidsstämplar eller en lång lucka i registreringen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Turens tidslinje inneholder ugyldige tidsstempler eller et langt opphold i registreringen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lenkin aikajanassa on virheellisiä aikaleimoja tai pitkä tallennuskatko."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A cronologia da volta contém marcas temporais inválidas ou uma longa lacuna de registo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A linha do tempo da pedalada contém marcações de tempo inválidas ou uma longa lacuna na gravação."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oś czasu przejazdu zawiera nieprawidłowe znaczniki czasu lub długą przerwę w zapisie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이딩 시간축에 유효하지 않은 타임스탬프 또는 긴 기록 공백이 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライドの時系列に無効な時刻または長い記録の空白があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "骑行时间线包含无效时间戳或较长的记录空缺。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "騎乘時間軸包含無效的時間戳記，或有長時間的記錄缺口。"
          }
        }
      }
    },
