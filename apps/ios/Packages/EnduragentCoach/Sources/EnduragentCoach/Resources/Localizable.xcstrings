    "plan.view.discardDraft.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only this Draft is removed. Your Plan conversation and active Plan stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se elimina este borrador. La conversación del Plan y el Plan activo se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul ce brouillon est supprimé. Ta conversation sur le plan et ton plan actif sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene rimossa solo questa bozza. La conversazione sul piano e il piano attivo rimangono."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur dieser Entwurf wird entfernt. Dein Plangespräch und dein aktiver Plan bleiben erhalten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen dit concept wordt verwijderd. Je gesprek over het trainingsschema en je actieve trainingsschema blijven bewaard."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun denne kladde fjernes. Din samtale om træningsplanen og din aktive træningsplan bliver bevaret."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast det här utkastet tas bort. Ditt plansamtal och din aktiva plan finns kvar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare dette utkastet fjernes. Plansamtalen og den aktive planen din beholdes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain tämä luonnos poistetaan. Suunnitelmakeskustelusi ja aktiivinen suunnitelmasi säilyvät."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só este rascunho é removido. A tua conversa sobre o Plano e o Plano ativo mantêm-se."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas este rascunho será removido. Sua conversa no Plano e seu plano ativo permanecem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięta zostanie tylko ta wersja robocza. Rozmowa o planie i aktywny plan pozostają."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 초안만 삭제됩니다. 계획 대화와 활성 계획은 유지됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この下書きのみを削除します。プランの会話と有効なプランは残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅移除此草稿。计划对话和当前启用的计划会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會移除此草稿。計畫對話與進行中的計畫都會保留。"
          }
        }
      }
    },
