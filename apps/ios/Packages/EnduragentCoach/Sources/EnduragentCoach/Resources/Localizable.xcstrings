            "value": "接続中のトレーニングアカウントを確認できませんでした。再接続して再読み込みしてから、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证已连接的训练账号。请重新连接并加载后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證已連結的訓練帳號。請重新連線並重新載入後再試。"
          }
        }
      }
    },
    "settings.athlete.error.requestFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The athlete ID couldn’t be saved. Your edit is still here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar el ID de deportista. Tu cambio sigue aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’identifiant d’athlète n’a pas pu être enregistré. Ta modification est toujours ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare l’ID atleta. La tua modifica è ancora qui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
