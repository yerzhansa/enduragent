    "plan.view.readiness.missingEffortsDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A short and a long recorded effort are needed from the last 6 weeks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesitan un esfuerzo corto y uno largo registrados en las últimas 6 semanas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un effort court et un effort long enregistrés au cours des 6 dernières semaines sont nécessaires."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Servono uno sforzo breve e uno lungo registrati nelle ultime 6 settimane."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benötigt werden eine kurze und eine lange aufgezeichnete Belastung aus den letzten 6 Wochen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn een korte en een lange geregistreerde inspanning uit de afgelopen 6 weken nodig."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der kræves en kort og en lang registreret præstation fra de seneste 6 uger."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En kort och en lång registrerad insats från de senaste 6 veckorna behövs."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det trengs en kort og en lang registrert prestasjon fra de siste 6 ukene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeisten 6 viikon ajalta tarvitaan yksi lyhyt ja yksi pitkä tallennettu suoritus."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "São necessários um esforço curto e um longo registados nas últimas 6 semanas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "São necessários um esforço curto e um longo registrados nas últimas 6 semanas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrzebne są krótki i długi zarejestrowany wysiłek z ostatnich 6 tygodni."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 6주간 단시간 및 장시간 기록이 각각 하나씩 필요합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去6週間の短時間と長時間の記録が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要过去 6 周内记录的一次短时和一次长时功率表现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要過去 6 週內各一次短時間與長時間的表現記錄。"
          }
        }
      }
    },
