    "plan.view.draftFormation.replacementDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your current Plan stays active. The replacement Draft opens automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu Plan actual sigue activo. El borrador de sustitución se abrirá automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton plan actuel reste actif. Le brouillon de remplacement s’ouvre automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il piano attuale resta attivo. La bozza sostitutiva si apre automaticamente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein aktueller Plan bleibt aktiv. Der Ersatzentwurf öffnet sich automatisch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je huidige trainingsschema blijft actief. Het vervangende concept opent automatisch."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din aktuelle træningsplan forbliver aktiv. Erstatningskladden åbnes automatisk."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
