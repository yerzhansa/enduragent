    "chat.transcript.handoff.change": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review a structured Proposal in Plan. Nothing changes until you approve it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa una propuesta estructurada en Plan. Nada cambia hasta que la apruebes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie une proposition structurée dans Plan. Rien ne change avant ton approbation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla una proposta strutturata nel piano. Nulla cambia finché non l’approvi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe einen strukturierten Vorschlag im Plan. Es ändert sich nichts, bis du zustimmst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk een gestructureerd voorstel in Plan. Er verandert niets totdat je het goedkeurt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gennemgå et struktureret forslag i Plan. Intet ændres, før du godkender det."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Granska ett strukturerat förslag i Plan. Inget ändras förrän du godkänner det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se gjennom et strukturert forslag i Plan. Ingenting endres før du godkjenner det."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista jäsennelty ehdotus suunnitelmassa. Mikään ei muutu ennen hyväksyntääsi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Revê uma proposta estruturada no Plano. Nada muda até a aprovares."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise uma proposta estruturada no Plano. Nada muda até você aprová-la."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź uporządkowaną propozycję w planie. Nic się nie zmieni, dopóki jej nie zatwierdzisz."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계획에서 구체적인 제안을 검토하세요. 승인할 때까지 변경 사항은 적용되지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プランで整理された提案を確認してください。承認するまで何も変更されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在计划中查看结构化方案。批准前，不会发生任何更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在計畫中檢視結構化方案。核准前，不會發生任何變更。"
          }
        }
      }
    },
    "chat.transcript.handoff.creation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer the remaining details in Plan, then review the Draft before applying it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa los detalles pendientes en Plan y revisa el borrador antes de aplicarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fournis les détails restants dans Plan, puis vérifie le brouillon avant de l’appliquer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fornisci i dettagli rimanenti nel piano, poi controlla la bozza prima di applicarla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ergänze die fehlenden Angaben im Plan und prüfe dann den Entwurf, bevor du ihn anwendest."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vul de resterende gegevens in Plan in en bekijk daarna het concept voordat je het toepast."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Besvar de resterende detaljer i Plan, og gennemgå derefter kladden, før du anvender den."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fyll i de återstående uppgifterna i Plan och granska sedan utkastet innan du tillämpar det."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svar på de resterende detaljene i Plan, og se gjennom utkastet før du tar det i bruk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täydennä loput tiedot suunnitelmassa ja tarkista sitten luonnos ennen käyttöönottoa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde aos detalhes em falta no Plano e revê o rascunho antes de o aplicar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Responda aos detalhes restantes no Plano e revise o rascunho antes de aplicá-lo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzupełnij pozostałe szczegóły w planie, a potem sprawdź wersję roboczą przed jej zastosowaniem."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계획에서 나머지 세부 사항에 답변한 후 적용하기 전에 초안을 검토하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プランで残りの詳細を回答し、下書きを確認してから適用してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在计划中补充剩余信息，然后在应用前查看草稿。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在計畫中補充剩餘資訊，然後在套用前檢視草稿。"
          }
        }
      }
    },
