          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut träningskontot under Konfiguration innan du sparar dess idrotts-ID."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble til treningskontoen i Oppsett før du lagrer utøver-ID-en."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistä harjoittelutili käyttöönotossa ennen urheilijatunnuksen tallentamista."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Liga a conta de treino em Configuração antes de guardares o respetivo ID de atleta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte a conta de treinamento em Configuração antes de salvar seu ID de atleta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz konto treningowe w Konfiguracji przed zapisaniem identyfikatora sportowca."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선수 ID를 저장하기 전에 초기 설정에서 훈련 계정을 연결하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アスリートIDを保存する前に、セットアップでトレーニングアカウントを接続してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在初始设置中连接训练账号，再保存其运动员 ID。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在「初始設定」中連結訓練帳號，再儲存運動員 ID。"
          }
        }
      }
    },
