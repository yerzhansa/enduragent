          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korvaava suunnitelma on aktiivinen, kun sen jatkuvasti päivittyvää kalenterikopiota palvelussa %#@intervals@ tarkistetaan."
          },
          "substitutions": {
            "intervals": {
