          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bed %#@botFather@ om en bot, kopiér dens token, og vend tilbage hertil. %#@product@ læser og kontrollerer tokenet direkte fra udklipsholderen. Tokenet vises aldrig."
          },
          "substitutions": {
            "botFather": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "product": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Be %#@botFather@ om en bot, kopiera dess token och återvänd sedan hit. %#@product@ läser och verifierar token direkt från urklipp. Token visas aldrig."
          },
          "substitutions": {
            "botFather": {
              "argNum": 1,
