    "chat.planCreation.feedback.activationFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activation could not be saved locally. Your previous Plan is unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la activación localmente. Tu plan anterior no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’activation n’a pas pu être enregistrée localement. Ton plan précédent est inchangé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare l’attivazione localmente. Il piano precedente resta invariato."
          }
        },
        "de": {
          "stringUnit": {
