        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@reply@\n\n(Bemærk: Min disk er fuld, så jeg kunne ikke gemme dette i vores historik — men din besked kom igennem. Frigør lidt plads, når du kan.)"
          },
          "substitutions": {
