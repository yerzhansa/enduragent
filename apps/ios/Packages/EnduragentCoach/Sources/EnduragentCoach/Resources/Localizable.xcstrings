    "setup.import.unconfirmed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local library import failed. The result could not be confirmed; check the library before trying again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La importación a la biblioteca local ha fallado. No se ha podido confirmar el resultado; comprueba la biblioteca antes de intentarlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’import dans la bibliothèque locale a échoué. Le résultat n’a pas pu être confirmé ; vérifie la bibliothèque avant de réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importazione nella raccolta locale non riuscita. Impossibile confermare il risultato; controlla la raccolta prima di riprovare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Import in die lokale Bibliothek fehlgeschlagen. Das Ergebnis konnte nicht bestätigt werden; prüfe die Bibliothek, bevor du es noch einmal versuchst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Import in de lokale bibliotheek mislukt. Het resultaat kon niet worden bevestigd. Controleer de bibliotheek voordat je het opnieuw probeert."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Import til lokalt bibliotek mislykkedes. Resultatet kunne ikke bekræftes. Kontrollér biblioteket, før du prøver igen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Importen till det lokala biblioteket misslyckades. Resultatet kunde inte bekräftas. Kontrollera biblioteket innan du försöker igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Import til lokalt bibliotek mislyktes. Resultatet kunne ikke bekreftes. Sjekk biblioteket før du prøver igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuonti paikalliseen kirjastoon epäonnistui. Tulosta ei voitu vahvistaa. Tarkista kirjasto ennen uutta yritystä."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A importação da biblioteca local falhou. Não foi possível confirmar o resultado. Verifica a biblioteca antes de tentares novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha na importação da biblioteca local. Não foi possível confirmar o resultado; verifique a biblioteca antes de tentar novamente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Import do lokalnej biblioteki nie powiódł się. Nie udało się potwierdzić wyniku; sprawdź bibliotekę przed kolejną próbą."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 라이브러리 가져오기에 실패했습니다. 결과를 확인하지 못했습니다. 라이브러리를 확인한 후 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルライブラリへのインポートに失敗しました。結果を確認できませんでした。再試行する前にライブラリを確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地资料库导入失败。无法确认结果，请检查资料库后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機資料庫匯入失敗。無法確認結果；請先檢查資料庫再重試。"
          }
        }
      }
