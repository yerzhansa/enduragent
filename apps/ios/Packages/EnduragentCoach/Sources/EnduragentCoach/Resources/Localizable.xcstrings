            "operatingSystem": {
              "argNum": 2,
              "formatSpecifier": "@"
            },
            "claude": {
              "argNum": 3,
              "formatSpecifier": "@"
            }
          }
        }
      }
    },
    "settings.coach.validation.modelControlCharacters": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model names can’t contain control characters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres de modelo no pueden contener caracteres de control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms de modèles ne peuvent pas contenir de caractères de contrôle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nomi dei modelli non possono contenere caratteri di controllo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellnamen dürfen keine Steuerzeichen enthalten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelnamen mogen geen stuurtekens bevatten."
          }
        },
        "da": {
