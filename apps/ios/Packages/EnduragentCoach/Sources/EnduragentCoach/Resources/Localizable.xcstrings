    "telegram.security.serving": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "[security] Open DM policy: serving non-allowlisted sender %#@senderId@."
          },
          "substitutions": {
            "senderId": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "[security] Política abierta de mensajes privados: se atiende al remitente %#@senderId@, que no figura en la lista de usuarios autorizados."
          },
          "substitutions": {
            "senderId": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "[security] Politique ouverte des messages privés : réponse à l’expéditeur %#@senderId@, absent de la liste d’autorisation."
          },
          "substitutions": {
            "senderId": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "[security] Criterio aperto per i messaggi privati: risposta al mittente %#@senderId@, non presente nell’elenco autorizzati."
