    "plan.library.stop.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Final training stays readable. Calendar cleanup can finish later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrás seguir consultando el entrenamiento final. La limpieza del calendario puede terminar más adelante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’entraînement final reste consultable. Le nettoyage du calendrier peut se terminer plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riepilogo finale dell’allenamento resta consultabile. La pulizia del calendario può terminare in seguito."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die abschließenden Trainingsdaten bleiben lesbar. Die Kalenderbereinigung kann später abgeschlossen werden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De definitieve trainingen blijven leesbaar. Het opschonen van de agenda kan later worden voltooid."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den afsluttende træning kan stadig læses. Kalenderoprydning kan afsluttes senere."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den slutliga träningsöversikten finns kvar att läsa. Kalenderrensningen kan slutföras senare."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den endelige treningen kan fortsatt leses. Opprydding i kalenderen kan fullføres senere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lopulliset harjoitustiedot säilyvät luettavina. Kalenterin siivous voi valmistua myöhemmin."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O registo final do treino continua disponível para consulta. A limpeza do calendário pode terminar mais tarde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O treinamento final continua disponível para leitura. A limpeza do calendário pode terminar depois."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Końcowy zapis treningów pozostaje dostępny do odczytu. Czyszczenie kalendarza może zakończyć się później."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최종 훈련 내용은 계속 확인할 수 있습니다. 캘린더 정리는 나중에 완료할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最終的なトレーニング内容は引き続き確認できます。カレンダーの整理は後で完了できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍可查看最终训练记录。日历清理可稍后完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最終訓練記錄仍可閱讀。行事曆可稍後再完成清理。"
          }
        }
      }
    },
    "plan.library.stop.failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopping could not be saved locally. Your Plan is unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la detención en este dispositivo. Tu Plan no ha cambiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’arrêt n’a pas pu être enregistré localement. Ton plan reste inchangé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare l’interruzione localmente. Il tuo piano resta invariato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Stoppen konnte nicht lokal gespeichert werden. Dein Plan bleibt unverändert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het stoppen kon niet lokaal worden opgeslagen. Je trainingsschema is ongewijzigd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppet kunne ikke gemmes lokalt. Din træningsplan er uændret."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppet kunde inte sparas lokalt. Din plan är oförändrad."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppingen kunne ikke lagres lokalt. Planen din er uendret."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lopettamista ei voitu tallentaa paikallisesti. Suunnitelmasi säilyy ennallaan."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar a interrupção localmente. O teu Plano mantém-se."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar a interrupção localmente. Seu plano permanece inalterado."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać zatrzymania lokalnie. Twój plan pozostaje bez zmian."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중단 상태를 로컬에 저장하지 못했습니다. 계획은 변경되지 않았습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中止をこのコンピュータに保存できませんでした。プランは変更されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在本地保存停止结果。计划未改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法在本機儲存停止狀態。計畫未變更。"
          }
        }
      }
    },
    "plan.library.stop.stale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Plan changed. Review its current details before stopping."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Plan ha cambiado. Revisa sus detalles actuales antes de detenerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plan a changé. Vérifie ses détails actuels avant de l’arrêter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il piano è cambiato. Controlla i dettagli attuali prima di interromperlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Plan hat sich geändert. Prüfe vor dem Stoppen die aktuellen Details."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het trainingsschema is gewijzigd. Bekijk de huidige details voordat je het stopt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træningsplanen er ændret. Gennemgå dens aktuelle detaljer, før du stopper den."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Planen har ändrats. Granska dess aktuella detaljer innan du stoppar den."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Planen er endret. Se gjennom de nåværende detaljene før du stopper den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suunnitelma muuttui. Tarkista sen nykyiset tiedot ennen lopettamista."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Plano mudou. Revê os detalhes atuais antes de o interromperes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano mudou. Revise os detalhes atuais antes de interrompê-lo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan się zmienił. Sprawdź jego bieżące szczegóły przed zatrzymaniem."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계획이 변경되었습니다. 중단하기 전에 현재 세부 정보를 검토하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プランが変更されました。中止する前に現在の詳細を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计划已更改。停止前请查看当前详情。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計畫已變更。請先檢視目前的詳情，再停止計畫。"
          }
        }
      }
    },
