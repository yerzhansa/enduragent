    "chat.planCreation.feedback.buildFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build failed. Your answers and last complete Draft are preserved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo crear el borrador. Se conservan tus respuestas y el último borrador completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La création du brouillon a échoué. Tes réponses et ton dernier brouillon complet sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creazione della bozza non riuscita. Le tue risposte e l’ultima bozza completa sono conservate."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellung fehlgeschlagen. Deine Antworten und der letzte vollständige Entwurf bleiben erhalten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het concept kon niet worden gemaakt. Je antwoorden en het laatste volledige concept blijven bewaard."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kladden kunne ikke oprettes. Dine svar og den seneste fuldstændige kladde bliver bevaret."
