    "settings.telegram.pairing.instruction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send this code as a private message to @%#@username@. The first account to send it becomes the primary user, and the bot stays online."
          },
          "substitutions": {
            "username": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía este código en un mensaje privado a @%#@username@. La primera cuenta que lo envíe se convierte en el usuario principal y el bot permanece en línea."
          },
          "substitutions": {
            "username": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
