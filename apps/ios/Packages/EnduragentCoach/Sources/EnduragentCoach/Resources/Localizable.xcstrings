    "plan.view.replacementLifecycle.replacementCompleteDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The old cleanup verified before the replacement mirror was written."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se verificó la limpieza del Plan anterior antes de copiar el Plan de sustitución al calendario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nettoyage de l’ancien plan a été vérifié avant l’ajout de la copie du nouveau plan au calendrier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
