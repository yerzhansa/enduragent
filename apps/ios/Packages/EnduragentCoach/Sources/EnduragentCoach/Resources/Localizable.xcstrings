            "computer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会关闭 %#@telegram@，并从 %#@computer@ 删除加密令牌及已授权用户的访问权限。%#@telegram@ 机器人和聊天会保留在 %#@telegram@ 中。"
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "computer": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會關閉 %#@telegram@，並從 %#@computer@ 刪除加密權杖與允許使用者的存取權限。%#@telegram@ 機器人與聊天會保留在 %#@telegram@。"
          },
          "substitutions": {
