    "chat.attachment.importDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send confirms the import; Plan and Calendar stay unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar confirma la importación; Plan y Calendario no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’envoi confirme l’importation ; le plan et le calendrier restent inchangés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’invio conferma l’importazione. Il piano e il calendario restano invariati."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dem Senden bestätigst du den Import; Plan und Kalender bleiben unverändert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzenden bevestigt de import. Plan en Kalender blijven ongewijzigd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afsendelse bekræfter importen. Plan og Kalender forbliver uændrede."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du skickar bekräftas importen. Plan och Kalender ändras inte."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du sender, bekrefter du importen. Planen og kalenderen forblir uendret."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähettäminen vahvistaa tuonnin. Suunnitelma ja kalenteri säilyvät ennallaan."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar confirma a importação; o Plano e o Calendário mantêm-se."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar confirma a importação; o Plano e o Calendário permanecem inalterados."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysłanie potwierdza import. Plan i kalendarz pozostają bez zmian."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송하면 가져오기가 확정됩니다. 계획과 캘린더는 변경되지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信するとインポートが確定します。プランとカレンダーは変更されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送即确认导入，计划和日历保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送即確認匯入，計畫與行事曆維持不變。"
          }
        }
      }
    },
