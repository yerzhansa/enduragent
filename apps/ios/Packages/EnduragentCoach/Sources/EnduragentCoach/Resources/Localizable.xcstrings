    "plan.view.readiness.cpDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on your best short and long power efforts from the last 6 weeks. This does not change your FTP, zones, workouts, or Plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se basa en tus mejores esfuerzos de potencia cortos y largos de las últimas 6 semanas. No cambia tu FTP, tus zonas, tus entrenamientos ni tu Plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basé sur tes meilleurs efforts de puissance courts et longs des 6 dernières semaines. Cela ne modifie ni ta FTP, ni tes zones, ni tes entraînements, ni ton plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Basata sui tuoi migliori sforzi di potenza brevi e lunghi delle ultime 6 settimane. Non modifica la FTP, le zone, gli allenamenti o il piano."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Basiert auf deinen besten kurzen und langen Leistungswerten der letzten 6 Wochen. Dein FTP-Wert, deine Zonen, Trainings und dein Plan ändern sich dadurch nicht."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebaseerd op je beste korte en lange vermogensinspanningen van de afgelopen 6 weken. Dit verandert je FTP, zones, trainingen of trainingsschema niet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Baseret på dine bedste korte og lange effektpræstationer fra de seneste 6 uger. Dette ændrer ikke din FTP, dine zoner, træninger eller din træningsplan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Baserat på dina bästa korta och långa effektinsatser under de senaste 6 veckorna. Det ändrar inte ditt FTP, dina zoner, träningspass eller din plan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Basert på dine beste korte og lange wattprestasjoner de siste 6 ukene. Dette endrer ikke FTP, soner, treningsøkter eller planen din."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Perustuu parhaisiin lyhyisiin ja pitkiin tehosuorituksiisi viimeisten 6 viikon ajalta. Tämä ei muuta FTP-arvoasi, alueitasi, harjoituksiasi tai suunnitelmaasi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Com base nos teus melhores esforços de potência curtos e longos das últimas 6 semanas. Isto não altera o teu FTP, zonas, treinos ou Plano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com base nos seus melhores esforços curtos e longos de potência das últimas 6 semanas. Isso não altera seu FTP, suas zonas, seus treinos nem seu plano."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na podstawie twoich najlepszych krótkich i długich wysiłków z pomiarem mocy z ostatnich 6 tygodni. Nie zmienia to twojego FTP, stref, treningów ani planu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 6주간 단시간 및 장시간 최고 파워 기록을 기준으로 합니다. FTP, 훈련존, 워크아웃 또는 계획은 변경되지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去6週間の短時間と長時間の最高パワー記録に基づきます。FTP、ゾーン、ワークアウト、プランは変更されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基于过去 6 周最佳的短时和长时功率表现。不会更改 FTP、区间、训练课程或计划。"
          }
        },
