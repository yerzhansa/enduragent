    "settings.credentials.feedback.delete.keyUnverified": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The credential was retained because secure storage could not confirm its encryption key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La credencial se ha conservado porque el almacenamiento seguro no ha podido confirmar su clave de cifrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La donnée d’authentification a été conservée, car le stockage sécurisé n’a pas pu confirmer sa clé de chiffrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La credenziale è stata conservata perché l’archivio sicuro non ha potuto confermare la sua chiave di crittografia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zugangsdaten wurden beibehalten, weil der sichere Speicher ihren Verschlüsselungsschlüssel nicht bestätigen konnte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De toegangsgegevens zijn behouden omdat de beveiligde opslag de versleutelingssleutel niet kon bevestigen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgangsoplysningerne blev bevaret, fordi den sikre lagring ikke kunne bekræfte krypteringsnøglen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggningsuppgifterna behölls eftersom den säkra lagringen inte kunde bekräfta sin krypteringsnyckel."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilgangsopplysningene ble beholdt fordi sikker lagring ikke kunne bekrefte krypteringsnøkkelen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunnistautumistieto säilytettiin, koska suojattu tallennustila ei voinut vahvistaa salausavaintaan."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A credencial foi mantida porque o armazenamento seguro não conseguiu confirmar a respetiva chave de encriptação."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A credencial foi mantida porque o armazenamento seguro não pôde confirmar sua chave de criptografia."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane dostępowe zachowano, ponieważ bezpieczny magazyn nie mógł potwierdzić ich klucza szyfrowania."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안 저장소에서 암호화 키를 확인하지 못해 인증 정보를 유지했습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全なストレージで暗号化キーを確認できなかったため、認証情報は保持されています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全存储无法确认此凭据的加密密钥，因此已保留凭据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安全儲存空間無法確認加密金鑰，因此已保留憑證。"
          }
        }
      }
    },
    "settings.credentials.feedback.delete.managed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This credential is managed outside Settings and can’t be deleted here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta credencial se gestiona fuera de Ajustes y no se puede eliminar aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette donnée d’authentification est gérée en dehors des Paramètres et ne peut pas être supprimée ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa credenziale è gestita al di fuori delle Impostazioni e non può essere eliminata qui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Zugangsdaten werden außerhalb der Einstellungen verwaltet und können hier nicht gelöscht werden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze toegangsgegevens worden buiten Instellingen beheerd en kunnen hier niet worden verwijderd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse adgangsoplysninger administreres uden for Indstillinger og kan ikke slettes her."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De här inloggningsuppgifterna hanteras utanför Inställningar och kan inte tas bort här."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse tilgangsopplysningene administreres utenfor Innstillinger og kan ikke slettes her."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä tunnistautumistietoa hallitaan asetusten ulkopuolella, eikä sitä voi poistaa täällä."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta credencial é gerida fora das Definições e não pode ser eliminada aqui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta credencial é gerenciada fora de Configurações e não pode ser excluída aqui."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te dane dostępowe są zarządzane poza Ustawieniami i nie można ich tutaj usunąć."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 인증 정보는 설정 외부에서 관리하므로 여기에서 삭제할 수 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この認証情報は設定の外部で管理されているため、ここでは削除できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此凭据由设置之外的方式管理，无法在此删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此憑證由「設定」之外的方式管理，無法在這裡刪除。"
          }
        }
      }
    },
    "settings.credentials.feedback.delete.notStored": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That credential is no longer stored. Reload to refresh the list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa credencial ya no está guardada. Recarga para actualizar la lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette donnée d’authentification n’est plus enregistrée. Recharge pour actualiser la liste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa credenziale non è più memorizzata. Ricarica per aggiornare l’elenco."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Zugangsdaten sind nicht mehr gespeichert. Lade neu, um die Liste zu aktualisieren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die toegangsgegevens zijn niet meer opgeslagen. Laad opnieuw om de lijst te vernieuwen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse adgangsoplysninger er ikke længere gemt. Genindlæs for at opdatere listen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De inloggningsuppgifterna är inte längre lagrade. Läs in igen för att uppdatera listan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse tilgangsopplysningene er ikke lenger lagret. Last inn på nytt for å oppdatere listen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä tunnistautumistietoa ei enää ole tallennettuna. Päivitä luettelo lataamalla uudelleen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa credencial já não está guardada. Recarrega para atualizares a lista."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa credencial não está mais armazenada. Recarregue para atualizar a lista."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te dane dostępowe nie są już przechowywane. Wczytaj ponownie, aby odświeżyć listę."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 인증 정보는 더 이상 저장되어 있지 않습니다. 새로고침하여 목록을 갱신하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その認証情報はすでに保存されていません。再読み込みして一覧を更新してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此凭据已不再存储。请重新加载以刷新列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此憑證已不存在。請重新載入以更新清單。"
          }
        }
      }
    },
    "settings.credentials.feedback.delete.reconcileFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved and active credential states could not be reconciled. Reconnect and reload before trying again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido conciliar los estados de la credencial guardada y la activa. Vuelve a conectar y recarga antes de intentarlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données d’authentification enregistrées et actives n’ont pas pu être mises en cohérence. Reconnecte et recharge avant de réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile allineare lo stato della credenziale salvata con quello della credenziale attiva. Riconnetti e ricarica prima di riprovare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherten und aktiven Zugangsdaten konnten nicht abgeglichen werden. Verbinde dich erneut und lade neu, bevor du es noch einmal versuchst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opgeslagen en actieve status van de toegangsgegevens konden niet op elkaar worden afgestemd. Maak opnieuw verbinding en laad opnieuw voordat je het nogmaals probeert."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De gemte og aktive adgangsoplysningers tilstand kunne ikke afstemmes. Opret forbindelse igen, og genindlæs, før du prøver igen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De sparade och aktiva inloggningsuppgifterna kunde inte samordnas. Anslut på nytt och läs in igen innan du försöker på nytt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De lagrede og aktive tilgangsopplysningene kunne ikke samordnes. Koble til og last inn på nytt før du prøver igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennetun ja käytössä olevan tunnistautumistiedon tiloja ei voitu sovittaa yhteen. Yhdistä ja lataa uudelleen ennen uutta yritystä."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível conciliar os estados da credencial guardada e da ativa. Volta a ligar e a carregar antes de tentares novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível conciliar os estados salvo e ativo da credencial. Reconecte e recarregue antes de tentar novamente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się uzgodnić stanu zapisanych i aktywnych danych dostępowych. Połącz ponownie i odśwież dane przed kolejną próbą."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 인증 정보와 활성 인증 정보의 상태를 일치시키지 못했습니다. 다시 연결하고 새로고침한 후 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みの認証情報と使用中の認証情報の状態を一致させられませんでした。再接続して再読み込みしてから、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法使已保存凭据与当前使用的凭据状态保持一致。请重新连接并加载后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法協調已儲存與已啟用憑證的狀態。請重新連線並重新載入後再試。"
          }
        }
      }
    },
    "settings.credentials.feedback.delete.refreshFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Credential deleted locally. Current credential status couldn’t be refreshed."
          }
        },
        "es": {
