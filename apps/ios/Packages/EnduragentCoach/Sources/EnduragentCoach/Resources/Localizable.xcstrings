    "setup.error.storageFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app could not confirm that key was saved securely. Check that secure storage is available and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación no ha podido confirmar que la clave se haya guardado de forma segura. Comprueba que el almacenamiento seguro esté disponible e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’application n’a pas pu confirmer que cette clé a été enregistrée en toute sécurité. Vérifie que le stockage sécurisé est disponible et réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app non ha potuto confermare che la chiave sia stata salvata in sicurezza. Verifica che l’archivio sicuro sia disponibile e riprova."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App konnte nicht bestätigen, dass der Schlüssel sicher gespeichert wurde. Prüfe, ob der sichere Speicher verfügbar ist, und versuche es erneut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app kon niet bevestigen dat die sleutel veilig is opgeslagen. Controleer of beveiligde opslag beschikbaar is en probeer het opnieuw."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen kunne ikke bekræfte, at nøglen blev gemt sikkert. Kontrollér, at sikker lagring er tilgængelig, og prøv igen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen kunde inte bekräfta att nyckeln sparades säkert. Kontrollera att säker lagring är tillgänglig och försök igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen kunne ikke bekrefte at nøkkelen ble lagret sikkert. Sjekk at sikker lagring er tilgjengelig og prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellus ei voinut vahvistaa, että avain tallennettiin turvallisesti. Tarkista, että suojattu tallennustila on käytettävissä, ja yritä uudelleen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A aplicação não conseguiu confirmar que essa chave foi guardada em segurança. Verifica se o armazenamento seguro está disponível e tenta novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O aplicativo não conseguiu confirmar se essa chave foi salva com segurança. Verifique se o armazenamento seguro está disponível e tente novamente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja nie mogła potwierdzić, że klucz został bezpiecznie zapisany. Sprawdź dostępność bezpiecznego magazynu i spróbuj ponownie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에서 키가 안전하게 저장되었는지 확인하지 못했습니다. 보안 저장소를 사용할 수 있는지 확인하고 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリはキーが安全に保存されたか確認できませんでした。安全なストレージを利用できるか確認して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用无法确认该密钥是否已安全保存。请检查安全存储是否可用后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式無法確認此金鑰是否已安全儲存。請確認安全儲存空間可用後重試。"
          }
        }
      }
    },
    "setup.error.storageUncertain": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app could not prove which saved key will survive a restart. Re-enter the key before continuing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación no ha podido determinar qué clave guardada se conservará tras un reinicio. Vuelve a introducir la clave antes de continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’application n’a pas pu déterminer quelle clé enregistrée sera conservée après un redémarrage. Saisis à nouveau la clé avant de continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app non ha potuto determinare quale chiave salvata rimarrà disponibile dopo un riavvio. Inserisci di nuovo la chiave prima di continuare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App konnte nicht feststellen, welcher gespeicherte Schlüssel nach einem Neustart erhalten bleibt. Gib den Schlüssel erneut ein, bevor du fortfährst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app kon niet vaststellen welke opgeslagen sleutel na opnieuw opstarten behouden blijft. Voer de sleutel opnieuw in voordat je doorgaat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen kunne ikke fastslå, hvilken gemt nøgle der bevares efter en genstart. Indtast nøglen igen, før du fortsætter."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen kunde inte säkerställa vilken sparad nyckel som kommer att finnas kvar efter en omstart. Ange nyckeln igen innan du fortsätter."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen kunne ikke fastslå hvilken lagret nøkkel som vil beholdes etter en omstart. Skriv inn nøkkelen på nytt før du fortsetter."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellus ei voinut varmistaa, mikä tallennettu avain säilyy uudelleenkäynnistyksen jälkeen. Anna avain uudelleen ennen jatkamista."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A aplicação não conseguiu confirmar qual das chaves guardadas será mantida após um reinício. Introduz a chave novamente antes de continuares."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O aplicativo não conseguiu comprovar qual chave salva será mantida após uma reinicialização. Insira a chave novamente antes de continuar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja nie mogła ustalić, który zapisany klucz przetrwa ponowne uruchomienie. Wpisz klucz ponownie przed kontynuowaniem."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에서 다시 시작한 후 어떤 저장된 키가 유지될지 확인하지 못했습니다. 계속하기 전에 키를 다시 입력하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリは、どの保存済みキーが再起動後も残るか確認できませんでした。続ける前にキーを再入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用无法确认哪个已保存的密钥会在重启后保留。请重新输入密钥后继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式無法確認哪組已儲存的金鑰會在重新啟動後保留。請重新輸入金鑰後再繼續。"
          }
        }
      }
    },
