          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De primaire %#@telegram@-gebruiker kon niet worden opgeslagen. Controleer de toegang tot de lokale schijf en probeer opnieuw te koppelen."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den primære %#@telegram@-bruger kunne ikke gemmes. Kontrollér adgang til den lokale disk, og prøv at parre igen."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den primära %#@telegram@-användaren kunde inte sparas. Kontrollera åtkomsten till den lokala disken och försök parkoppla igen."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hovedbrukeren i %#@telegram@ kunne ikke lagres. Sjekk tilgangen til den lokale disken og prøv sammenkoblingen igjen."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
