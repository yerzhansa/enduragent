              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@reply@\n\n(Hinweis: Meine Festplatte ist voll, deshalb konnte ich das nicht in unserem Verlauf speichern. Deine Nachricht ist aber angekommen. Gib bitte etwas Speicherplatz frei, wenn du kannst.)"
          },
          "substitutions": {
