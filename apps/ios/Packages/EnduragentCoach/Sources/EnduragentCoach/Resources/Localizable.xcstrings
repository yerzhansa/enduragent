    "chat.planCreation.commitmentsHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give the weekday and exact limit, or the exact time-off dates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica el día de la semana y el límite exacto, o las fechas exactas de los días libres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique le jour de la semaine et la limite exacte, ou les dates exactes d’indisponibilité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica il giorno della settimana e il limite esatto, oppure le date esatte del periodo di pausa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den Wochentag und das genaue Limit oder die genauen Daten der Auszeit an."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef de dag van de week en de exacte limiet op, of de exacte datums waarop je afwezig bent."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiv ugedagen og den præcise grænse eller de præcise datoer for fravær."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange veckodag och exakt gräns, eller exakta datum för ledigheten."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppgi ukedag og nøyaktig grense, eller de nøyaktige datoene for fravær."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna viikonpäivä ja tarkka raja tai tauon tarkat päivämäärät."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica o dia da semana e o limite exato, ou as datas exatas de ausência."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique o dia da semana e o limite exato, ou as datas exatas de ausência."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj dzień tygodnia i dokładny limit lub dokładne daty przerwy."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요일과 정확한 제한 또는 정확한 훈련 중단 날짜를 알려 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曜日と具体的な上限、または休む期間の正確な日付を入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请说明星期几及具体限制，或确切的休假日期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
