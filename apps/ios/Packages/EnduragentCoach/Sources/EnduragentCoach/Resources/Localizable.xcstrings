    "telegram.sync.restricted": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%#@number@ of %#@total@ activities are hidden by %#@source@, so they aren’t included. A %#@source@ API restriction prevents %#@service@ from sharing activities that came from %#@source@. For future rides, connect your recording source directly to %#@service@ and keep %#@source@ connected. For past rides, use %#@importAction@ in %#@service@ settings; it requires an %#@service@ supporter subscription."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%#@number@ of %#@total@ activities are hidden by %#@source@, so they aren’t included. A %#@source@ API restriction prevents %#@service@ from sharing activities that came from %#@source@. For future rides, connect your recording source directly to %#@service@ and keep %#@source@ connected. For past rides, use %#@importAction@ in %#@service@ settings; it requires an %#@service@ supporter subscription."
                }
              }
            }
          },
          "substitutions": {
            "number": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "total": {
              "argNum": 2,
              "formatSpecifier": "@"
            },
            "source": {
              "argNum": 3,
              "formatSpecifier": "@"
            },
            "service": {
              "argNum": 4,
              "formatSpecifier": "@"
            },
            "importAction": {
              "argNum": 5,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%#@source@ oculta %#@number@ actividad de un total de %#@total@, por lo que no se incluye. Una restricción de la API de %#@source@ impide que %#@service@ comparta actividades procedentes de %#@source@. Para futuras salidas, conecta tu fuente de registro directamente a %#@service@ y mantén %#@source@ conectado. Para salidas anteriores, usa %#@importAction@ en los ajustes de %#@service@; requiere una suscripción de colaborador de %#@service@."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%#@source@ oculta %#@number@ actividades de un total de %#@total@, por lo que no se incluyen. Una restricción de la API de %#@source@ impide que %#@service@ comparta actividades procedentes de %#@source@. Para futuras salidas, conecta tu fuente de registro directamente a %#@service@ y mantén %#@source@ conectado. Para salidas anteriores, usa %#@importAction@ en los ajustes de %#@service@; requiere una suscripción de colaborador de %#@service@."
                }
              }
            }
          },
          "substitutions": {
            "number": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "total": {
              "argNum": 2,
              "formatSpecifier": "@"
            },
            "source": {
              "argNum": 3,
              "formatSpecifier": "@"
            },
            "service": {
              "argNum": 4,
              "formatSpecifier": "@"
            },
            "importAction": {
              "argNum": 5,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%#@number@ activité sur %#@total@ est masquée par %#@source@ et n’est donc pas incluse. Une restriction de l’API %#@source@ empêche %#@service@ de partager les activités provenant de %#@source@. Pour les sorties à venir, connecte directement la source qui enregistre tes sorties à %#@service@ et garde %#@source@ connecté. Pour les sorties passées, utilise %#@importAction@ dans les paramètres de %#@service@ ; un abonnement de soutien à %#@service@ est nécessaire."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%#@number@ activités sur %#@total@ sont masquées par %#@source@ et ne sont donc pas incluses. Une restriction de l’API %#@source@ empêche %#@service@ de partager les activités provenant de %#@source@. Pour les sorties à venir, connecte directement la source qui enregistre tes sorties à %#@service@ et garde %#@source@ connecté. Pour les sorties passées, utilise %#@importAction@ dans les paramètres de %#@service@ ; un abonnement de soutien à %#@service@ est nécessaire."
                }
              }
            }
          },
          "substitutions": {
            "number": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "total": {
              "argNum": 2,
              "formatSpecifier": "@"
            },
            "source": {
              "argNum": 3,
              "formatSpecifier": "@"
            },
            "service": {
              "argNum": 4,
              "formatSpecifier": "@"
            },
            "importAction": {
              "argNum": 5,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%#@number@ attività su %#@total@ è nascosta da %#@source@, quindi non è inclusa. Una restrizione dell’API di %#@source@ impedisce a %#@service@ di condividere le attività provenienti da %#@source@. Per le prossime uscite, collega la fonte di registrazione direttamente a %#@service@ e mantieni %#@source@ collegato. Per le uscite passate, usa %#@importAction@ nelle impostazioni di %#@service@; richiede un abbonamento sostenitore di %#@service@."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%#@number@ attività su %#@total@ sono nascoste da %#@source@, quindi non sono incluse. Una restrizione dell’API di %#@source@ impedisce a %#@service@ di condividere le attività provenienti da %#@source@. Per le prossime uscite, collega la fonte di registrazione direttamente a %#@service@ e mantieni %#@source@ collegato. Per le uscite passate, usa %#@importAction@ nelle impostazioni di %#@service@; richiede un abbonamento sostenitore di %#@service@."
                }
              }
            }
          },
          "substitutions": {
            "number": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "total": {
              "argNum": 2,
              "formatSpecifier": "@"
