    "archive.delete.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently removes this past conversation and its original attachments from this computer. Imported activities in Training and work in Plan stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente esta conversación anterior y sus archivos adjuntos originales de este ordenador. Las actividades importadas en Entrenamiento y el trabajo en Plan se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprime définitivement cette conversation passée et ses pièces jointes d’origine de cet ordinateur. Les activités importées dans Entraînement et le travail dans Plan sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione elimina definitivamente da questo computer la conversazione passata e i suoi allegati originali. Le attività importate in Allenamento e il lavoro in Piano rimangono."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit werden dieses frühere Gespräch und seine ursprünglichen Anhänge dauerhaft von diesem Computer entfernt. Importierte Aktivitäten unter Training und deine Arbeit unter Plan bleiben erhalten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verwijdert dit eerdere gesprek en de oorspronkelijke bijlagen definitief van deze computer. Geïmporteerde activiteiten in Training en werk in Plan blijven bewaard."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner denne tidligere samtale og dens oprindelige vedhæftede filer permanent fra denne computer. Importerede aktiviteter i Træning og arbejde i Plan bliver bevaret."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här tar permanent bort det tidigare samtalet och dess ursprungliga bilagor från den här datorn. Importerade aktiviteter i Träning och arbete i Plan finns kvar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner denne tidligere samtalen og de opprinnelige vedleggene permanent fra denne datamaskinen. Importerte aktiviteter i Trening og arbeid i Plan beholdes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa tämän aiemman keskustelun ja sen alkuperäiset liitteet pysyvästi tältä tietokoneelta. Harjoittelu-näkymään tuodut suoritukset ja Suunnitelma-näkymässä tehty työ säilyvät."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto remove permanentemente esta conversa anterior e os seus anexos originais deste computador. As atividades importadas em Treino e o trabalho em Plano mantêm-se."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação remove permanentemente esta conversa anterior e seus anexos originais deste computador. As atividades importadas em Treinamento e o trabalho em Plano permanecem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to trwałe usunięcie tej wcześniejszej rozmowy i jej oryginalnych załączników z tego komputera. Zaimportowane aktywności w Treningu i praca w Planie pozostaną."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 컴퓨터에서 이 이전 대화와 원본 첨부 파일을 영구적으로 삭제합니다. 훈련에 가져온 활동과 계획에서 진행한 작업은 유지됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この過去の会話と元の添付ファイルを、このコンピュータから完全に削除します。「トレーニング」にインポートしたアクティビティと「プラン」の内容は残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会从此电脑永久删除这段历史对话及其原始附件。“训练”中已导入的活动和“计划”中的内容会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會從此電腦永久移除此過往對話及其原始附件。「訓練」中已匯入的活動與「計畫」中的內容會保留。"
          }
        }
      }
    },
    "archive.delete.failure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletion could not finish. Try again to complete it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar la eliminación. Inténtalo de nuevo para terminarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression n’a pas pu se terminer. Réessaie pour la terminer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile completare l’eliminazione. Riprova per completarla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Löschen konnte nicht abgeschlossen werden. Versuche es erneut, um es abzuschließen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het verwijderen is niet voltooid. Probeer het opnieuw om het af te ronden."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletningen kunne ikke fuldføres. Prøv igen for at afslutte den."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Borttagningen kunde inte slutföras. Försök igen för att slutföra den."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slettingen kunne ikke fullføres. Prøv igjen for å fullføre den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistoa ei voitu suorittaa loppuun. Viimeistele se yrittämällä uudelleen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível concluir a eliminação. Tenta novamente para a concluir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível concluir a exclusão. Tente novamente para concluí-la."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się dokończyć usuwania. Spróbuj ponownie, aby je ukończyć."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제를 완료하지 못했습니다. 다시 시도해 완료하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除を完了できませんでした。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能完成删除。请重试以完成删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未能完成刪除。請重試以完成刪除。"
          }
        }
      }
    },
