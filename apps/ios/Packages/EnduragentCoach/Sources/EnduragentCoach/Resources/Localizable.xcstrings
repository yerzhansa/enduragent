    "plan.details.planFinalDetails.distantEventDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Event Goal is still %#@value1@. Start a new Plan for event preparation when it is within 24 weeks."
          },
          "substitutions": {
            "value1": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu objetivo de evento sigue siendo %#@value1@. Inicia un nuevo Plan de preparación cuando falten 24 semanas o menos."
          },
          "substitutions": {
            "value1": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton objectif d’événement reste %#@value1@. Commence un nouveau plan pour préparer l’événement lorsqu’il sera à moins de 24 semaines."
          },
          "substitutions": {
            "value1": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo evento obiettivo resta %#@value1@. Avvia un nuovo piano di preparazione quando mancano al massimo 24 settimane."
          },
          "substitutions": {
            "value1": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Veranstaltungsziel bleibt %#@value1@. Starte einen neuen Plan zur Veranstaltungsvorbereitung, sobald sie innerhalb der nächsten 24 Wochen liegt."
          },
          "substitutions": {
            "value1": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je evenementdoel blijft %#@value1@. Start een nieuw trainingsschema ter voorbereiding zodra het evenement binnen 24 weken plaatsvindt."
          },
          "substitutions": {
            "value1": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit mål for begivenheden er stadig %#@value1@. Start en ny træningsplan som forberedelse, når der er højst 24 uger til begivenheden."
          },
          "substitutions": {
            "value1": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt evenemangsmål är fortfarande %#@value1@. Starta en ny plan för att förbereda dig när det är högst 24 veckor kvar till evenemanget."
          },
          "substitutions": {
            "value1": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrangementsmålet ditt er fortsatt %#@value1@. Start en ny plan for å forberede deg til arrangementet når det er høyst 24 uker igjen."
          },
          "substitutions": {
            "value1": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tavoitetapahtumasi on edelleen %#@value1@. Aloita uusi suunnitelma tapahtumaan valmistautumista varten, kun siihen on enintään 24 viikkoa."
          },
          "substitutions": {
            "value1": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu objetivo de prova continua a ser %#@value1@. Inicia um novo Plano de preparação quando faltarem 24 semanas ou menos para a prova."
          },
          "substitutions": {
            "value1": {
              "argNum": 1,
