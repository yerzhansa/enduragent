    "settings.telegram.attention.storageFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The encrypted bot credential could not be saved. Check local disk access and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar la credencial cifrada del bot. Comprueba el acceso al disco local e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La donnée d’authentification chiffrée du bot n’a pas pu être enregistrée. Vérifie l’accès au disque local et réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare la credenziale crittografata del bot. Controlla l’accesso al disco locale e riprova."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die verschlüsselten Bot-Zugangsdaten konnten nicht gespeichert werden. Prüfe den Zugriff auf den lokalen Datenträger und versuche es erneut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De versleutelde toegangsgegevens van de bot konden niet worden opgeslagen. Controleer de toegang tot de lokale schijf en probeer het opnieuw."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De krypterede adgangsoplysninger til botten kunne ikke gemmes. Kontrollér adgang til den lokale disk, og prøv igen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Botens krypterade inloggningsuppgifter kunde inte sparas. Kontrollera åtkomsten till den lokala disken och försök igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De krypterte tilgangsopplysningene for boten kunne ikke lagres. Sjekk tilgangen til den lokale disken og prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Botin salattua tunnistautumistietoa ei voitu tallentaa. Tarkista paikallisen levyn käyttöoikeudet ja yritä uudelleen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar a credencial encriptada do bot. Verifica o acesso ao disco local e tenta novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar a credencial criptografada do bot. Verifique o acesso ao disco local e tente novamente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać zaszyfrowanych danych dostępowych bota. Sprawdź dostęp do lokalnego dysku i spróbuj ponownie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호화된 봇 인증 정보를 저장하지 못했습니다. 로컬 디스크 접근 권한을 확인하고 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗号化したボットの認証情報を保存できませんでした。このコンピュータのディスクへのアクセスを確認して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存加密的机器人凭据。请检查本地磁盘访问权限后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存加密的機器人憑證。請檢查本機磁碟存取權限後重試。"
          }
        }
      }
    },
