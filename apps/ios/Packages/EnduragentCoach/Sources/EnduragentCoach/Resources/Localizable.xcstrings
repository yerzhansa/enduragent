            "state": "translated",
            "value": "Esta vista previa ya no está pendiente. El entrenamiento no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet aperçu n’est plus en attente. L’entraînement est inchangé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa anteprima non è più in attesa. Gli allenamenti restano invariati."
          }
        },
