              "argNum": 11,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Te doy la bienvenida a %#@product@!\n\nSoy tu entrenador de ciclismo con IA. Puedo crear planes de entrenamiento, sugerir entrenamientos y seguir tu condición física con los datos de %#@service@.\n\nComandos:\n%#@plan@: generar un plan de entrenamiento\n%#@workout@: consultar el entrenamiento de hoy\n%#@status@: consultar tu condición física, fatiga y forma actuales\n%#@review@: revisar tu última sesión\n%#@sync@: forzar la actualización de los datos de entrenamiento de %#@service@\n%#@version@: mostrar la versión actual\n%#@whatsnew@: ver las novedades de la última versión\n%#@update@: %#@updateDescription@\n\n¡También puedes hablar conmigo sobre tu entrenamiento!"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "service": {
