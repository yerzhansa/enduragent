      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach can inspect visual PDF pages when image input is available; OCR is not used."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El entrenador puede examinar las páginas del PDF como imágenes si la entrada de imágenes está disponible; no se usa OCR."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le coach peut examiner les pages du PDF sous forme d’images si la lecture d’images est disponible ; l’OCR n’est pas utilisé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il coach può esaminare le pagine del PDF come immagini se il modello le supporta. Non viene usato l’OCR."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Coach kann PDF-Seiten als Bilder prüfen, wenn Bildeingabe verfügbar ist; OCR wird nicht verwendet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De coach kan PDF-pagina's als afbeelding bekijken wanneer afbeeldingsinvoer beschikbaar is. OCR wordt niet gebruikt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træneren kan se PDF-sider som billeder, når billedinput er tilgængeligt. OCR bruges ikke."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tränaren kan granska PDF-sidor som bilder när bildinmatning är tillgänglig. OCR används inte."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Treneren kan se på PDF-sidene som bilder når bilder støttes. OCR brukes ikke."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valmentaja voi tarkastella PDF-sivuja kuvina, kun kuvien käsittely on käytettävissä. Tekstintunnistusta ei käytetä."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O treinador pode examinar as páginas visuais do PDF quando a entrada de imagens está disponível; não é utilizado OCR."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O treinador pode examinar as páginas visuais do PDF quando a entrada de imagens está disponível; OCR não é usado."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trener może oglądać strony PDF jako obrazy, gdy obsługa obrazów jest dostępna. OCR nie jest używany."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지 입력이 가능하면 코치가 PDF 페이지를 이미지로 확인할 수 있습니다. OCR은 사용하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像入力が利用できる場合、コーチはPDFのページを画像として確認できます。OCRは使用しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持图片输入时，教练可查看 PDF 页面图像，不使用 OCR。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援圖片輸入時，教練可檢視 PDF 頁面影像，不使用 OCR。"
          }
        }
      }
    },
