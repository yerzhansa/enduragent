    "cli.startup.botPollingConflict": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@telegram@ reported a conflict (%#@code@) — another instance is already polling this bot token. Stop the other instance, then restart."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "code": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@telegram@ ha informado de un conflicto (%#@code@). Otra instancia ya está consultando mensajes con este token de bot. Detén la otra instancia y reinicia."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "code": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@telegram@ a signalé un conflit (%#@code@) — une autre instance récupère déjà les messages avec ce jeton de bot. Arrête l’autre instance, puis redémarre."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "code": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@telegram@ ha segnalato un conflitto (%#@code@). Un’altra istanza sta già interrogando il bot con questo token. Arresta l’altra istanza, poi riavvia."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "code": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@telegram@ hat einen Konflikt gemeldet (%#@code@). Eine andere Instanz fragt dieses Bot-Token bereits ab. Beende die andere Instanz und starte dann neu."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "code": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@telegram@ meldde een conflict (%#@code@). Een andere instantie vraagt al berichten op met dit bottoken. Stop de andere instantie en start opnieuw."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "code": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@telegram@ rapporterede en konflikt (%#@code@) — en anden instans henter allerede beskeder med dette bot-token. Stop den anden instans, og genstart derefter."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "code": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@telegram@ rapporterade en konflikt (%#@code@). En annan instans hämtar redan meddelanden med denna bot-token. Stoppa den andra instansen och starta sedan om."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "code": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
