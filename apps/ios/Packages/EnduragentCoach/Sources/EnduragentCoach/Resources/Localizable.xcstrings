          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De atleet-ID kon niet worden opgeslagen. Je wijziging staat er nog."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Atlet-ID'et kunne ikke gemmes. Din ændring er her stadig."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Idrotts-ID:t kunde inte sparas. Din ändring finns kvar här."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utøver-ID-en kunne ikke lagres. Endringen din er fortsatt her."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Urheilijatunnusta ei voitu tallentaa. Muutoksesi on yhä tässä."
