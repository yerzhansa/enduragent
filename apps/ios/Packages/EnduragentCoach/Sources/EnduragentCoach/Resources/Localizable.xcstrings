    "training.power.powerCaption": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Power curve for the current 28 days compared with the previous 28 days"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Curva de potencia de los últimos 28 días comparada con los 28 días anteriores"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Courbe de puissance des 28 jours actuels comparée aux 28 jours précédents"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Curva di potenza degli ultimi 28 giorni rispetto ai 28 giorni precedenti"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leistungskurve der aktuellen 28 Tage im Vergleich zu den vorherigen 28 Tagen"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermogenscurve van de huidige 28 dagen vergeleken met de voorgaande 28 dagen"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Effektkurve for de seneste 28 dage sammenlignet med de foregående 28 dage"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Effektkurva för de senaste 28 dagarna jämfört med de föregående 28 dagarna"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Wattkurve for de nåværende 28 dagene sammenlignet med de foregående 28 dagene"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeisten 28 päivän tehokäyrä verrattuna edeltäviin 28 päivään"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Curva de potência dos últimos 28 dias comparada com a dos 28 dias anteriores"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Curva de potência dos 28 dias atuais em comparação com os 28 dias anteriores"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krzywa mocy z ostatnich 28 dni w porównaniu z poprzednimi 28 dniami"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 28일과 이전 28일의 파워 곡선 비교"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近28日間とその前の28日間のパワーカーブの比較"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近 28 天与此前 28 天的功率曲线对比"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最近 28 天與前 28 天的功率曲線比較"
          }
