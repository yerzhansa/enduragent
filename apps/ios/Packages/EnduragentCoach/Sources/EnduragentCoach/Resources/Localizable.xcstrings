    "coach.history.unsavedStepLimit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I ran out of steps gathering data — ask me to continue and I'll pick up where I left off.\n\n(Heads up: my disk is full, so I couldn't save this to our history — but your message went through. Please free up some space when you can.)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "He alcanzado el límite de pasos al recopilar datos. Pídeme que continúe y retomaré donde lo dejé.\n\n(Aviso: el disco está lleno y no he podido guardar esto en nuestro historial, pero tu mensaje sí ha llegado. Libera algo de espacio cuando puedas.)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’ai atteint ma limite d’étapes en recueillant les données — demande-moi de continuer et je reprendrai là où je me suis arrêté.\n\n(À noter : mon disque est plein, je n’ai donc pas pu enregistrer cet échange dans notre historique — mais ton message est bien passé. Libère de l’espace quand tu peux.)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho raggiunto il limite di passaggi durante la raccolta dei dati. Chiedimi di continuare e riprenderò da dove mi sono fermato.\n\n(Attenzione: il disco è pieno, quindi non ho potuto salvare questo scambio nella cronologia. Il tuo messaggio è comunque arrivato. Libera un po’ di spazio quando puoi.)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Sammeln der Daten habe ich mein Schrittlimit erreicht. Bitte mich weiterzumachen, dann mache ich dort weiter, wo ich aufgehört habe.\n\n(Hinweis: Meine Festplatte ist voll, deshalb konnte ich das nicht in unserem Verlauf speichern. Deine Nachricht ist aber angekommen. Gib bitte etwas Speicherplatz frei, wenn du kannst.)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik heb het maximale aantal stappen bereikt bij het verzamelen van gegevens. Vraag me om door te gaan, dan pak ik het op waar ik gebleven was.\n\n(Let op: mijn schijf is vol, dus ik kon dit niet opslaan in onze geschiedenis. Je bericht is wel aangekomen. Maak ruimte vrij zodra je kunt.)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg nåede grænsen for antal trin, mens jeg hentede data — bed mig om at fortsætte, så tager jeg fat, hvor jeg slap.\n\n(Bemærk: Min disk er fuld, så jeg kunne ikke gemme dette i vores historik — men din besked kom igennem. Frigør lidt plads, når du kan.)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag nådde gränsen för antal steg när jag samlade in data. Be mig fortsätta så tar jag vid där jag slutade.\n\nMin disk är full, så jag kunde inte spara det här i vår historik. Ditt meddelande kom fram. Frigör lite utrymme när du kan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg nådde grensen for antall steg mens jeg samlet data — be meg fortsette, så tar jeg opp tråden der jeg slapp.\n\n(Merk: Disken min er full, så jeg kunne ikke lagre dette i historikken vår — men meldingen din kom frem. Frigjør litt plass når du kan.)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tietojen keräämiseen varatut vaiheet loppuivat. Pyydä minua jatkamaan, niin jatkan siitä, mihin jäin.\n\nHuomaa: levytilani on täynnä, joten en voinut tallentaa tätä keskusteluhistoriaamme. Viestisi tuli silti perille. Vapauta tilaa, kun voit."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingi o limite de passos ao reunir os dados. Pede-me para continuar e retomo de onde fiquei.\n\n(Atenção: o meu disco está cheio, por isso não consegui guardar isto no nosso histórico, mas recebi a tua mensagem. Liberta algum espaço quando puderes.)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingi o limite de etapas ao reunir os dados. Peça para eu continuar e retomo de onde parei.\n\n(Atenção: meu disco está cheio, então não consegui salvar isto no nosso histórico, mas recebi sua mensagem. Libere algum espaço quando puder.)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas zbierania danych zabrakło mi kroków — poproś mnie o kontynuację, a wrócę do miejsca, w którym przerwałem.\n\n(Uwaga: mój dysk jest pełny, więc nie udało mi się zapisać tego w historii naszej rozmowy — ale twoja wiadomość dotarła. Zwolnij trochę miejsca, gdy będziesz mieć chwilę.)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터를 모으다가 처리 단계 한도에 도달했습니다. 계속해 달라고 말씀하시면 멈춘 곳부터 이어가겠습니다.\n\n(디스크가 가득 차서 이 내용을 대화 기록에 저장하지 못했습니다. 메시지는 정상적으로 처리했습니다. 가능할 때 저장 공간을 확보해 주세요.)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データを集めている途中で処理ステップの上限に達しました。続けてほしいと伝えてもらえれば、中断したところから再開します。\n\n（ディスクがいっぱいのため、今回の内容を会話履歴に保存できませんでした。メッセージは処理できています。時間のあるときに空き容量を確保してください。）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收集数据时已达到步骤上限。告诉我继续，我就会接着处理。\n\n（提醒一下：磁盘已满，无法将这次交流保存到历史记录中，但消息已收到。方便时请清理一些空间。）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收集資料時已達到步驟上限。告訴我繼續，我就會接著處理。\n\n（提醒一下：磁碟已滿，無法將這次交流儲存到歷史記錄中，但訊息已收到。方便時請清出一些空間。）"
          }
        }
      }
    },
