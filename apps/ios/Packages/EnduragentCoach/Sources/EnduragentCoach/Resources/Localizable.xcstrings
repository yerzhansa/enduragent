    "settings.credentials.feedback.recovery.missing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The credential encryption key is missing. Restore it if possible, then Retry, or remove all credentials and start again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta la clave de cifrado de las credenciales. Restáurala si es posible y pulsa Reintentar, o elimina todas las credenciales y empieza de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé de chiffrement des données d’authentification est absente. Restaure-la si possible, puis choisis Réessayer, ou supprime toutes les données d’authentification et recommence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Manca la chiave di crittografia delle credenziali. Ripristinala se possibile e scegli Riprova, oppure rimuovi tutte le credenziali e ricomincia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verschlüsselungsschlüssel für die Zugangsdaten fehlt. Stelle ihn nach Möglichkeit wieder her und wähle „Erneut versuchen“ oder entferne alle Zugangsdaten und beginne von vorn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De versleutelingssleutel voor toegangsgegevens ontbreekt. Herstel deze indien mogelijk en kies Opnieuw proberen, of verwijder alle toegangsgegevens en begin opnieuw."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Krypteringsnøglen til adgangsoplysninger mangler. Gendan den, hvis det er muligt, og vælg Prøv igen, eller fjern alle adgangsoplysninger, og start forfra."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Krypteringsnyckeln för inloggningsuppgifterna saknas. Återställ den om möjligt och välj sedan Försök igen, eller ta bort alla inloggningsuppgifter och börja om."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Krypteringsnøkkelen for tilgangsopplysninger mangler. Gjenopprett den om mulig og velg Prøv igjen, eller fjern alle tilgangsopplysninger og start på nytt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunnistautumistietojen salausavain puuttuu. Palauta se, jos mahdollista, ja valitse Yritä uudelleen, tai poista kaikki tunnistautumistiedot ja aloita alusta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de encriptação das credenciais está em falta. Restaura-a, se possível, e escolhe Tentar novamente, ou remove todas as credenciais e recomeça."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de criptografia das credenciais está ausente. Restaure-a, se possível, e selecione Tentar novamente, ou remova todas as credenciais e recomece."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brakuje klucza szyfrowania danych dostępowych. Jeśli to możliwe, przywróć go i spróbuj ponownie lub usuń wszystkie dane dostępowe i zacznij od nowa."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증 정보 암호화 키가 없습니다. 가능하면 복원한 후 다시 시도하거나, 모든 인증 정보를 삭제하고 다시 시작하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証情報の暗号化キーが見つかりません。可能であれば復元して「再試行」を選ぶか、すべての認証情報を削除して設定し直してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "凭据加密密钥缺失。请尽可能恢复密钥后重试，或移除所有凭据并重新设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少憑證加密金鑰。若可還原，請還原後重試；也可以移除所有憑證並重新設定。"
          }
        }
      }
    },
    "settings.credentials.feedback.recovery.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure credential storage is unavailable. Retry, or remove all credentials and start again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacenamiento seguro de credenciales no está disponible. Reintenta o elimina todas las credenciales y empieza de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stockage sécurisé des données d’authentification est indisponible. Réessaie, ou supprime toutes les données d’authentification et recommence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’archivio sicuro delle credenziali non è disponibile. Riprova oppure rimuovi tutte le credenziali e ricomincia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der sichere Speicher für Zugangsdaten ist nicht verfügbar. Versuche es erneut oder entferne alle Zugangsdaten und beginne von vorn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beveiligde opslag van toegangsgegevens is niet beschikbaar. Probeer het opnieuw, of verwijder alle toegangsgegevens en begin opnieuw."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikker lagring af adgangsoplysninger er utilgængelig. Prøv igen, eller fjern alle adgangsoplysninger, og start forfra."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Säker lagring av inloggningsuppgifter är inte tillgänglig. Försök igen eller ta bort alla inloggningsuppgifter och börja om."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikker lagring av tilgangsopplysninger er utilgjengelig. Prøv igjen, eller fjern alle tilgangsopplysninger og start på nytt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunnistautumistietojen suojattu tallennustila ei ole käytettävissä. Yritä uudelleen tai poista kaikki tunnistautumistiedot ja aloita alusta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento seguro de credenciais está indisponível. Tenta novamente ou remove todas as credenciais e recomeça."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento seguro de credenciais está indisponível. Tente novamente ou remova todas as credenciais e recomece."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpieczny magazyn danych dostępowych jest niedostępny. Spróbuj ponownie lub usuń wszystkie dane dostępowe i zacznij od nowa."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안 인증 정보 저장소를 사용할 수 없습니다. 다시 시도하거나 모든 인증 정보를 삭제하고 다시 시작하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証情報の安全なストレージを利用できません。再試行するか、すべての認証情報を削除して設定し直してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "凭据安全存储不可用。请重试，或移除所有凭据并重新设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法使用憑證安全儲存空間。請重試，或移除所有憑證並重新設定。"
          }
        }
      }
    },
    "settings.credentials.feedback.recovery.unverified": {
      "localizations": {
        "en": {
