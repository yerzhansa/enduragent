    "chat.planCreation.discardConsequence": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Plan was created. Your active Plan, Schedule, training restrictions, saved preferences, and chat history are unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha creado ningún plan. Tu plan activo, calendario de entrenamiento, restricciones de entrenamiento, preferencias guardadas e historial de chat no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun plan n’a été créé. Ton plan actif, ton planning, tes restrictions d’entraînement, tes préférences enregistrées et ton historique de conversation sont inchangés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun piano è stato creato. Il piano attivo, la programmazione, le restrizioni di allenamento, le preferenze salvate e la cronologia della chat restano invariati."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde kein Plan erstellt. Dein aktiver Plan, Zeitplan, deine Trainingseinschränkungen, gespeicherten Einstellungen und dein Chatverlauf bleiben unverändert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen trainingsschema gemaakt. Je actieve trainingsschema, planning, trainingsbeperkingen, opgeslagen voorkeuren en chatgeschiedenis blijven ongewijzigd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen træningsplan blev oprettet. Din aktive træningsplan, tidsplan, træningsbegrænsninger, gemte præferencer og chathistorik er uændrede."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen plan skapades. Din aktiva plan, ditt schema, dina träningsbegränsningar, sparade inställningar och din chatthistorik är oförändrade."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen plan ble opprettet. Den aktive planen, timeplanen, treningsbegrensninger, lagrede innstillinger og chatthistorikken din er uendret."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suunnitelmaa ei luotu. Aktiivinen suunnitelmasi, aikataulusi, harjoitusrajoituksesi, tallennetut asetuksesi ja keskusteluhistoriasi säilyvät ennallaan."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi criado nenhum plano. O teu plano ativo, horário, restrições de treino, preferências guardadas e histórico do chat mantêm-se."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum plano foi criado. Seu plano ativo, programação, restrições de treinamento, preferências salvas e histórico do chat permanecem inalterados."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie utworzono planu. Twój aktywny plan, harmonogram, ograniczenia treningowe, zapisane preferencje i historia czatu pozostają bez zmian."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계획이 생성되지 않았습니다. 활성 계획, 일정, 훈련 제한, 저장된 환경설정 및 채팅 기록은 변경되지 않았습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プランは作成されませんでした。有効なプラン、スケジュール、トレーニングの制限、保存済みの環境設定、チャット履歴は変更されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未创建计划。当前启用的计划、日程、训练限制、已保存的偏好和聊天历史均未改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未建立計畫。目前啟用的計畫、日程、訓練限制、已儲存的偏好與聊天記錄均未變更。"
          }
        }
      }
    },
