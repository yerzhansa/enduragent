    "training.response.responseIntro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows %#@provider@'s cleaned, lag-adjusted relationship for this ride. It is separate from the local aerobic drift estimate and does not prescribe training on its own."
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra la relación de esta salida calculada por %#@provider@, con los datos depurados y el retraso ajustado. Es independiente de la estimación local de deriva aeróbica y no prescribe entrenamiento por sí sola."
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche la relation calculée par %#@provider@ pour cette sortie, après nettoyage des données et correction du décalage. Elle est distincte de l’estimation locale de dérive aérobie et ne suffit pas à elle seule pour prescrire un entraînement."
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra la relazione elaborata da %#@provider@ per questa uscita, con dati ripuliti e ritardo corretto. È distinta dalla stima locale della deriva aerobica e da sola non determina indicazioni di allenamento."
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt den von %#@provider@ bereinigten und um die Verzögerung korrigierten Zusammenhang für diese Fahrt. Er ist von der lokalen Schätzung der aeroben Entkopplung getrennt und gibt allein keine Trainingsvorgaben vor."
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont het door %#@provider@ opgeschoonde verband voor deze rit, gecorrigeerd voor hartslagvertraging. Dit staat los van de lokale schatting van aerobe drift en bepaalt op zichzelf geen trainingsadvies."
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser den rensede sammenhæng med justering for forsinkelse fra %#@provider@ for denne tur. Den er adskilt fra det lokale estimat for aerob drift og fastlægger ikke træning i sig selv."
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar sambandet för den här cykelturen efter att %#@provider@ har rensat data och justerat för fördröjning. Det är skilt från den lokala uppskattningen av aerob drift och ger inte i sig träningsråd."
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser sammenhengen for denne turen etter at %#@provider@ har renset dataene og justert for forsinkelse. Dette er atskilt fra det lokale estimatet for aerob drift og gir ikke alene grunnlag for å foreskrive trening."
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää palvelun %#@provider@ puhdistaman ja viivekorjaaman yhteyden tältä lenkiltä. Se on erillinen paikallisesta aerobisen ajautuman arviosta eikä yksinään määritä harjoittelua."
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra a relação tratada e ajustada ao atraso por %#@provider@ para esta volta. É independente da estimativa local da deriva aeróbica e, por si só, não prescreve treino."
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra a relação de %#@provider@ para esta pedalada, com dados tratados e ajuste do atraso. Ela é separada da estimativa local de deriva aeróbica e não prescreve treinamento por si só."
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje zależność dla tego przejazdu obliczoną przez %#@provider@ po oczyszczeniu danych i korekcie opóźnienia. Jest oddzielna od lokalnego szacunku dryfu tlenowego i sama nie stanowi zalecenia treningowego."
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@provider@에서 정제하고 지연을 보정한 이 라이딩의 관계를 표시합니다. 로컬 유산소 드리프트 추정값과는 별개이며, 이 값만으로 훈련을 처방하지 않습니다."
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このライドについて、%#@provider@がデータを整理し、心拍反応の遅れを補正した関係を表示します。このコンピュータで算出する有酸素ドリフトの推定とは別のもので、これだけでトレーニングを指定することはありません。"
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示 %#@provider@ 对此骑行数据清理并校正滞后后得到的关系。此结果独立于本地有氧漂移估算，不能单独用于制定训练。"
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示 %#@provider@ 為此騎乘清理資料並校正延遲後的關係分析。此分析與本機有氧漂移估算不同，不會單獨用來安排訓練。"
          },
          "substitutions": {
            "provider": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        }
      }
    },
