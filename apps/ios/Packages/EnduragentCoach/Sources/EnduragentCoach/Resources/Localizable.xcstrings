    "plan.view.replacementLifecycle.cleanupBlockedDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The replacement stays active locally. Calendar writing is blocked until old cleanup is verified."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Plan de sustitución sigue activo en este dispositivo. No se añadirán datos al calendario hasta que se verifique la limpieza del anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le remplacement reste actif localement. L’ajout au calendrier est bloqué jusqu’à la vérification du nettoyage de l’ancien plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il piano sostitutivo resta attivo localmente. L’inserimento nel calendario è bloccato fino alla verifica della pulizia del vecchio piano."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ersatzplan bleibt lokal aktiv. Kalendereinträge sind gesperrt, bis die Bereinigung des alten Plans bestätigt ist."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vervanging blijft lokaal actief. Schrijven naar de agenda is geblokkeerd totdat het opschonen van het oude schema is gecontroleerd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstatningen forbliver aktiv lokalt. Kalenderopdatering er blokeret, indtil oprydningen af den gamle træningsplan er bekræftet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersättningsplanen förblir aktiv lokalt. Kalenderposter kan inte skrivas förrän rensningen av den gamla planen har verifierats."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstatningen forblir aktiv lokalt. Nye kalenderoppføringer er blokkert til oppryddingen etter den gamle planen er bekreftet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korvaava suunnitelma pysyy aktiivisena paikallisesti. Kalenterin kirjoittaminen on estetty, kunnes vanhan kalenterin siivous on vahvistettu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O novo Plano mantém-se ativo localmente. A escrita no calendário está bloqueada até a limpeza do anterior ser verificada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano substituto continua ativo localmente. A inclusão no calendário fica bloqueada até a limpeza do plano anterior ser verificada."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowy plan pozostaje aktywny lokalnie. Zapis w kalendarzu jest zablokowany do zweryfikowania usunięcia starego planu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대체 계획은 로컬에서 활성 상태로 유지됩니다. 이전 일정 정리가 확인될 때까지 캘린더 일정 추가가 차단됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "置き換えたプランは、このコンピュータ上で引き続き有効です。以前の予定の削除を確認するまで、カレンダーへの書き込みは保留されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "替代计划在本地保持启用。确认旧计划清理完成前，无法写入日历。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新計畫在本機繼續進行。驗證舊計畫清理完成前，無法寫入行事曆。"
          }
        }
      }
    },
    "plan.view.replacementLifecycle.cleanupPendingDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The old Plan ended. Today stays while tomorrow-onward old workouts are removed and verified."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Plan anterior ha terminado. El entrenamiento de hoy se conserva mientras se eliminan y comprueban los entrenamientos anteriores a partir de mañana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ancien plan est terminé. L’entraînement d’aujourd’hui est conservé pendant la suppression et la vérification des anciens entraînements prévus à partir de demain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il vecchio piano è terminato. L’allenamento di oggi rimane mentre i vecchi allenamenti da domani in poi vengono rimossi e verificati."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der alte Plan wurde beendet. Das heutige Training bleibt bestehen, während die alten Trainings ab morgen entfernt und die Entfernung geprüft werden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het oude trainingsschema is beëindigd. Vandaag blijft staan terwijl de oude trainingen vanaf morgen worden verwijderd en gecontroleerd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den gamle træningsplan er afsluttet. Dagens træning bliver bevaret, mens gamle træninger fra i morgen og frem fjernes og kontrolleres."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den gamla planen har avslutats. Dagens träningspass finns kvar medan gamla träningspass från och med imorgon tas bort och borttagningen verifieras."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den gamle planen er avsluttet. Dagens treningsøkt beholdes mens gamle treningsøkter fra i morgen og fremover fjernes og kontrolleres."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanha suunnitelma päättyi. Tämä päivä säilyy, kun vanhat harjoitukset huomisesta eteenpäin poistetaan ja poisto vahvistetaan."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Plano anterior terminou. O dia de hoje mantém-se enquanto os treinos anteriores a partir de amanhã são removidos e verificados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano anterior foi encerrado. O treino de hoje permanece enquanto os treinos antigos a partir de amanhã são removidos e verificados."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stary plan zakończył się. Dzisiejszy trening pozostaje, a stare treningi od jutra są usuwane i sprawdzane."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 계획이 종료되었습니다. 내일 이후의 이전 워크아웃을 삭제하고 확인하는 동안 오늘의 워크아웃은 유지됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前のプランは終了しました。明日以降の古いワークアウトを削除して確認している間、今日のワークアウトは残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧计划已结束。移除并验证从明天起的旧训练课程期间，今天的训练课程会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舊計畫已結束。移除並驗證明天起的舊訓練課表期間，今天的訓練課表會保留。"
          }
        }
      }
    },
    "plan.view.replacementLifecycle.cleanupResult": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today preserved; tomorrow-onward old workouts removed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrenamiento de hoy conservado; entrenamientos anteriores a partir de mañana eliminados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entraînement d’aujourd’hui conservé ; anciens entraînements prévus à partir de demain supprimés"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allenamento di oggi conservato; vecchi allenamenti da domani in poi rimossi"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heutiges Training beibehalten; alte Trainings ab morgen entfernt"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vandaag behouden. Oude trainingen vanaf morgen verwijderd"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagens træning bevaret. Gamle træninger fra i morgen og frem fjernet"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagens träningspass behölls. Gamla träningspass från och med imorgon togs bort"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagens treningsøkt beholdt. Gamle treningsøkter fra i morgen og fremover fjernet"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä päivä säilytetty. Vanhat harjoitukset huomisesta eteenpäin poistettu"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Dia de hoje preservado; treinos anteriores a partir de amanhã removidos"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Treino de hoje preservado; treinos antigos a partir de amanhã removidos"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzisiejszy trening zachowany. Stare treningi od jutra usunięte"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 일정 유지됨 · 내일 이후의 이전 워크아웃 삭제됨"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のワークアウトは保持し、明日以降の古いワークアウトを削除しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的训练课程已保留；从明天起的旧训练课程已移除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已保留今天的訓練課表；已移除明天起的舊訓練課表"
          }
        }
      }
    },
