    "training.ride.groupsIntro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provider summary metrics for related ordered segments."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Métricas resumidas del proveedor para segmentos ordenados relacionados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesures récapitulatives du fournisseur pour des segments associés, dans leur ordre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metriche riepilogative del fornitore per segmenti correlati in ordine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammengefasste Kennzahlen des Anbieters für zusammengehörige, geordnete Abschnitte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samenvattende meetwaarden van de aanbieder voor samenhangende segmenten in volgorde."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udbyderens opsummerede målinger for beslægtede segmenter i rækkefølge."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Leverantörens sammanfattande mått för relaterade segment i ordning."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Leverandørens oppsummerte måleverdier for sammenhørende segmenter i rekkefølge."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palveluntarjoajan yhteenvetomittarit toisiinsa liittyvistä, järjestetyistä jaksoista."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Métricas de resumo do fornecedor para segmentos relacionados e ordenados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Métricas resumidas do provedor para segmentos relacionados em ordem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsumowanie wskaźników dostawcy dla powiązanych odcinków w kolejności."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서로 관련된 순차 구간에 대해 제공업체가 제공한 요약 지표입니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "順番に並んだ関連区間について、プロバイダーの集計指標を表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据提供方对相关有序片段的汇总指标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務供應商針對相關連續區段提供的彙整指標。"
          }
        }
      }
    },
