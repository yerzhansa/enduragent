    "setup.telegram.createAfterBotFather": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "for a bot, copy its token, then return here. %#@product@ reads and verifies the token directly from the clipboard; the token is never shown."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "que cree un bot, copia su token y vuelve aquí. %#@product@ lee y verifica el token directamente del portapapeles; el token nunca se muestra."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "de créer un bot, copie son jeton, puis reviens ici. %#@product@ lit et vérifie le jeton directement dans le presse-papiers ; le jeton n’est jamais affiché."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "un bot, copia il suo token, poi torna qui. %#@product@ legge e verifica il token direttamente dagli appunti; il token non viene mai mostrato."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "um einen Bot, kopiere sein Token und kehre dann hierher zurück. %#@product@ liest und überprüft das Token direkt aus der Zwischenablage; das Token wird nie angezeigt."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "om een bot, kopieer het token en keer hier terug. %#@product@ leest en verifieert het token rechtstreeks van het klembord. Het token wordt nooit getoond."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "om en bot, kopiér dens token, og vend tilbage hertil. %#@product@ læser og kontrollerer tokenet direkte fra udklipsholderen. Tokenet vises aldrig."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "om en bot, kopiera dess token och återvänd sedan hit. %#@product@ läser och verifierar token direkt från urklipp. Token visas aldrig."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "om en bot, kopier tokenet og kom tilbake hit. %#@product@ leser og bekrefter tokenet direkte fra utklippstavlen. Tokenet vises aldri."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "luomaan botti, kopioi sen tunniste ja palaa sitten tänne. %#@product@ lukee ja vahvistaa tunnisteen suoraan leikepöydältä. Tunnistetta ei koskaan näytetä."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "que crie um bot, copia o respetivo token e volta aqui. %#@product@ lê e verifica o token diretamente da área de transferência. O token nunca é mostrado."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "um bot, copie seu token e volte aqui. %#@product@ lê e verifica o token diretamente da área de transferência; o token nunca é exibido."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "o bota, skopiuj jego token i wróć tutaj. %#@product@ odczytuje i weryfikuje token bezpośrednio ze schowka; token nigdy nie jest wyświetlany."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에게 봇을 요청하고 토큰을 복사한 후 여기로 돌아오세요. %#@product@에서 클립보드의 토큰을 직접 읽고 확인하며, 토큰은 표시되지 않습니다."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "にボットの作成を依頼し、トークンをコピーしてここに戻ってください。%#@product@はクリップボードからトークンを直接読み取って確認します。トークンは表示されません。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申请机器人，复制其令牌后返回此处。%#@product@ 直接从剪贴板读取并验证令牌，不会显示令牌。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立機器人，複製其權杖後返回這裡。%#@product@ 會直接從剪貼簿讀取並驗證權杖，全程不會顯示權杖。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        }
      }
    },
