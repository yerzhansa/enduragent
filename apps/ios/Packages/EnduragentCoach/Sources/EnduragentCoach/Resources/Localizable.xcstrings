        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane dostępowe usunięto lokalnie. Nie udało się odświeżyć ich bieżącego statusu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 인증 정보가 삭제되었습니다. 현재 인증 정보 상태를 갱신하지 못했습니다."
          }
        },
        "ja": {
          "stringUnit": {
