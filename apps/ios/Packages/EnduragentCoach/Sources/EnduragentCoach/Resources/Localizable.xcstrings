        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成に失敗しました。回答と最後に完成した下書きは残っています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿生成失败。回答和上次完整的草稿已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿產生失敗。回答與上次完整的草稿已保留。"
          }
        }
      }
    },
    "chat.planCreation.feedback.planChanged": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Plan changed. Read the Plan library and confirm again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan ha cambiado. Consulta la biblioteca de planes y vuelve a confirmar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plan a changé. Consulte la bibliothèque de plans et confirme à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il piano è cambiato. Consulta la raccolta dei piani e conferma di nuovo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Plan hat sich geändert. Sieh in der Planbibliothek nach und bestätige erneut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het trainingsschema is gewijzigd. Bekijk de bibliotheek in Plan en bevestig opnieuw."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træningsplanen er ændret. Gennemse biblioteket i Plan, og bekræft igen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Planen har ändrats. Läs planbiblioteket och bekräfta igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Planen er endret. Les planbiblioteket og bekreft igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suunnitelma muuttui. Tarkista suunnitelmakirjasto ja vahvista uudelleen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano mudou. Consulta a biblioteca de planos e confirma novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano mudou. Consulte a biblioteca de planos e confirme novamente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan się zmienił. Sprawdź bibliotekę planów i potwierdź ponownie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계획이 변경되었습니다. 계획 라이브러리를 확인하고 다시 확정하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プランが変更されました。プランライブラリを確認してから、再度確定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计划已更改。请查看计划库后再次确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計畫已變更。請檢視計畫庫後再次確認。"
          }
        }
      }
    },
    "chat.planCreation.feedback.planReadFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current Plan could not be read. Refresh the Plan library before activating."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el plan actual. Actualiza la biblioteca de planes antes de activar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plan actuel n’a pas pu être lu. Actualise la bibliothèque de plans avant d’activer le plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere il piano attuale. Aggiorna la raccolta dei piani prima dell’attivazione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktuelle Plan konnte nicht gelesen werden. Aktualisiere die Planbibliothek vor dem Aktivieren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het huidige trainingsschema kon niet worden gelezen. Vernieuw de bibliotheek in Plan voordat je activeert."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den aktuelle træningsplan kunne ikke læses. Genindlæs biblioteket i Plan, før du aktiverer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den aktuella planen kunde inte läsas in. Uppdatera planbiblioteket innan du aktiverar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den nåværende planen kunne ikke leses. Oppdater planbiblioteket før du aktiverer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nykyistä suunnitelmaa ei voitu lukea. Päivitä suunnitelmakirjasto ennen aktivointia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o plano atual. Atualiza a biblioteca de planos antes de ativar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o plano atual. Atualize a biblioteca de planos antes de ativar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać bieżącego planu. Odśwież bibliotekę planów przed aktywacją."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 계획을 읽지 못했습니다. 활성화하기 전에 계획 라이브러리를 새로고침하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のプランを読み込めませんでした。有効にする前にプランライブラリを更新してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
