    "settings.units.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Distance and body mass follow this setting. Cycling power-to-weight remains W/kg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La distancia y la masa corporal siguen este ajuste. La relación potencia-peso en ciclismo se mantiene en W/kg."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La distance et la masse corporelle suivent ce réglage. Le rapport puissance-poids en cyclisme reste en W/kg."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La distanza e la massa corporea seguono questa impostazione. Il rapporto potenza-peso nel ciclismo resta in W/kg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Distanz und Körpergewicht richten sich nach dieser Einstellung. Das Leistungsgewicht beim Radfahren bleibt in W/kg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afstand en lichaamsgewicht volgen deze instelling. De verhouding tussen vermogen en gewicht bij het fietsen blijft in W/kg."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Distance og kropsvægt følger denne indstilling. Forholdet mellem effekt og vægt i cykling vises fortsat i W/kg."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Distans och kroppsvikt följer den här inställningen. Förhållandet mellan effekt och vikt vid cykling visas fortfarande i W/kg."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Distanse og kroppsvekt følger denne innstillingen. Forholdet mellom effekt og vekt i sykling vises fortsatt i W/kg."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Matka ja kehonpaino noudattavat tätä asetusta. Pyöräilyn teho-painosuhteen yksikkö on edelleen W/kg."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A distância e a massa corporal seguem esta definição. A relação potência-peso no ciclismo mantém-se em W/kg."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A distância e a massa corporal seguem esta configuração. A relação potência-peso no ciclismo continua em W/kg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dystans i masa ciała są wyświetlane zgodnie z tym ustawieniem. Stosunek mocy do masy w kolarstwie pozostaje w W/kg."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거리와 체중은 이 설정을 따릅니다. 사이클링의 체중 대비 파워는 W/kg으로 유지됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "距離と体重はこの設定に従います。サイクリングのパワーウェイトレシオはW/kgのままです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "距离和体重会遵循此设置。骑行功率体重比仍使用W/kg。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "距離和體重會遵循此設定。自行車功率體重比仍使用W/kg。"
          }
        }
      }
    },
