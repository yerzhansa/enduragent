    "sidebar.sync.message.protocol": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@product@ couldn’t verify the sync result. Quit and reopen %#@product@."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
