        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’annulation est possible tant qu’il s’agit de la modification la plus récente et que son entraînement est à venir et géré par le coach."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi annullare questa modifica finché è la più recente e l’allenamento è futuro e gestito dal coach."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst diese Änderung rückgängig machen, solange sie die neueste ist und das Training noch bevorsteht und vom Coach verwaltet wird."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongedaan maken is beschikbaar zolang dit de nieuwste wijziging is en de bijbehorende training nog in de toekomst ligt en door de coach wordt beheerd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan fortryde, så længe dette er den seneste ændring, og træningen ligger i fremtiden og styres af træneren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan ångra så länge det här är den senaste ändringen och träningspasset ligger i framtiden och hanteras av tränaren."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan angre så lenge dette er den nyeste endringen og treningsøkten ligger frem i tid og styres av treneren."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit kumota muutoksen, kun se on uusin muutos ja sen harjoitus on tulevaisuudessa sekä valmentajan hallinnassa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes anular enquanto esta for a alteração mais recente e o respetivo treino estiver no futuro e for gerido pelo treinador."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É possível desfazer enquanto esta for a alteração mais recente e o treino for futuro e gerenciado pelo treinador."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cofnięcie jest dostępne, dopóki jest to najnowsza zmiana, a jej trening jest w przyszłości i zarządza nim trener."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 최근 변경이며 해당 워크아웃이 향후 일정이고 코치가 관리하는 동안 실행 취소할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この変更が最新で、対象のワークアウトが今後の予定かつコーチ管理である間は、元に戻せます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若这是最近一次更改，且对应训练课程尚未开始、仍由教练管理，则可以撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只要這仍是最新變更，且其訓練課表尚未開始並由教練管理，即可復原。"
          }
        }
      }
    },
