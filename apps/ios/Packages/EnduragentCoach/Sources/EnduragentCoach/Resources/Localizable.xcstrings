            },
            "product": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@botFather@にボットの作成を依頼し、トークンをコピーしてここに戻ってください。%#@product@はクリップボードからトークンを直接読み取って確認します。トークンは表示されません。"
