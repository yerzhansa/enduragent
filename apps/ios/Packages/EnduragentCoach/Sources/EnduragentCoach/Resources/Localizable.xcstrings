    "cli.update.managedDeployment": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deployment updates through its container image. If %#@railway@ image auto-updates are enabled, %#@railway@ redeploys the latest %#@registry@ image during the configured maintenance window; otherwise redeploy the service from the latest image in %#@railway@."
          },
          "substitutions": {
            "railway": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "registry": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este despliegue se actualiza mediante su imagen de contenedor. Si las actualizaciones automáticas de imagen de %#@railway@ están activadas, %#@railway@ vuelve a desplegar la última imagen de %#@registry@ durante el periodo de mantenimiento configurado; si no, vuelve a desplegar el servicio desde la última imagen en %#@railway@."
          },
          "substitutions": {
            "railway": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "registry": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce déploiement se met à jour via son image de conteneur. Si les mises à jour automatiques des images sont activées dans %#@railway@, %#@railway@ redéploie la dernière image %#@registry@ pendant le créneau de maintenance configuré ; sinon, redéploie le service depuis la dernière image dans %#@railway@."
          },
          "substitutions": {
            "railway": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "registry": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa distribuzione si aggiorna tramite l’immagine del container. Se gli aggiornamenti automatici dell’immagine su %#@railway@ sono attivi, %#@railway@ distribuisce l’ultima immagine di %#@registry@ nella finestra di manutenzione configurata; altrimenti ridistribuisci il servizio dall’ultima immagine su %#@railway@."
          },
          "substitutions": {
            "railway": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "registry": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Bereitstellung wird über ihr Container-Image aktualisiert. Wenn automatische Image-Updates in %#@railway@ aktiviert sind, stellt %#@railway@ das neueste %#@registry@-Image im festgelegten Wartungsfenster bereit. Andernfalls stelle den Dienst in %#@railway@ mit dem neuesten Image erneut bereit."
          },
          "substitutions": {
            "railway": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "registry": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze installatie wordt bijgewerkt via de containerimage. Als automatische image-updates in %#@railway@ zijn ingeschakeld, implementeert %#@railway@ de nieuwste %#@registry@-image tijdens het ingestelde onderhoudsvenster. Implementeer de service anders opnieuw vanuit de nieuwste image in %#@railway@."
          },
          "substitutions": {
            "railway": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "registry": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne installation opdateres via sit containerimage. Hvis automatiske imageopdateringer er aktiveret i %#@railway@, udruller %#@railway@ det nyeste %#@registry@-image igen i det konfigurerede vedligeholdelsesvindue; ellers skal du udrulle tjenesten igen fra det nyeste image i %#@railway@."
          },
          "substitutions": {
            "railway": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "registry": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här installationen uppdateras via sin containeravbildning. Om automatiska avbildningsuppdateringar är aktiverade i %#@railway@ distribuerar %#@railway@ den senaste %#@registry@-avbildningen under det inställda underhållsfönstret. Annars behöver du distribuera tjänsten på nytt från den senaste avbildningen i %#@railway@."
          },
          "substitutions": {
            "railway": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "registry": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne installasjonen oppdateres via container-imaget. Hvis automatiske image-oppdateringer er aktivert i %#@railway@, distribuerer %#@railway@ det nyeste %#@registry@-imaget på nytt i det angitte vedlikeholdsvinduet. Ellers må du distribuere tjenesten på nytt fra det nyeste imaget i %#@railway@."
          },
          "substitutions": {
            "railway": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "registry": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä asennus päivittyy konttikuvan kautta. Jos %#@railway@-kuvan automaattiset päivitykset ovat käytössä, %#@railway@ ottaa uusimman %#@registry@-kuvan käyttöön määritetyn huoltoikkunan aikana. Muussa tapauksessa ota palvelu uudelleen käyttöön uusimmasta kuvasta palvelussa %#@railway@."
          },
          "substitutions": {
            "railway": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "registry": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta instalação é atualizada através da imagem de contentor. Se as atualizações automáticas de imagens de %#@railway@ estiverem ativas, %#@railway@ volta a implementar a imagem mais recente de %#@registry@ durante a janela de manutenção configurada; caso contrário, volta a implementar o serviço com a imagem mais recente em %#@railway@."
          },
          "substitutions": {
            "railway": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "registry": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta implantação é atualizada pela imagem de contêiner. Se as atualizações automáticas de imagens de %#@railway@ estiverem ativas, %#@railway@ reimplanta a imagem mais recente de %#@registry@ durante a janela de manutenção configurada; caso contrário, reimplante o serviço com a imagem mais recente em %#@railway@."
          },
          "substitutions": {
            "railway": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "registry": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To wdrożenie jest aktualizowane przez obraz kontenera. Jeśli automatyczne aktualizacje obrazu w %#@railway@ są włączone, %#@railway@ wdroży najnowszy obraz %#@registry@ w ustawionym oknie konserwacji; w przeciwnym razie wdróż usługę ponownie z najnowszego obrazu w %#@railway@."
          },
          "substitutions": {
            "railway": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "registry": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 배포는 컨테이너 이미지를 통해 업데이트됩니다. %#@railway@ 이미지 자동 업데이트가 켜져 있으면 설정된 유지 관리 시간에 %#@railway@에서 최신 %#@registry@ 이미지를 다시 배포합니다. 그렇지 않으면 %#@railway@에서 최신 이미지로 서비스를 다시 배포하세요."
          },
          "substitutions": {
            "railway": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "registry": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この環境はコンテナイメージを通じて更新されます。%#@railway@のイメージ自動更新が有効なら、設定されたメンテナンス時間帯に%#@railway@が最新の%#@registry@イメージを再デプロイします。それ以外の場合は、%#@railway@で最新のイメージからサービスを再デプロイしてください。"
          },
          "substitutions": {
            "railway": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "registry": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此部署通过容器镜像更新。如果已启用 %#@railway@ 镜像自动更新，%#@railway@ 会在配置的维护时段内重新部署最新的 %#@registry@ 镜像；否则，请在 %#@railway@ 中使用最新镜像重新部署服务。"
          },
          "substitutions": {
            "railway": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "registry": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此部署透過容器映像檔更新。如果已啟用 %#@railway@ 映像檔自動更新，%#@railway@ 會在設定的維護時段內重新部署最新的 %#@registry@ 映像檔；否則，請在 %#@railway@ 中使用最新映像檔重新部署服務。"
          },
          "substitutions": {
            "railway": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "registry": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        }
      }
    },
