    "training.power.rotation.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough comparable efforts to identify a power shift."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficientes esfuerzos comparables para identificar un cambio de potencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas assez d’efforts comparables pour identifier une évolution du profil de puissance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono abbastanza sforzi confrontabili per individuare una variazione del profilo di potenza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genügend vergleichbare Belastungen, um eine Leistungsverschiebung zu erkennen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn onvoldoende vergelijkbare inspanningen om een verschuiving in vermogen vast te stellen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ikke nok sammenlignelige præstationer til at påvise en ændring i effektprofilen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns inte tillräckligt med jämförbara insatser för att urskilja en förändring i effektprofilen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke nok sammenlignbare prestasjoner til å påvise en endring i wattprofilen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertailukelpoisia suorituksia ei ole riittävästi tehon painopisteen muutoksen tunnistamiseen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há esforços comparáveis suficientes para identificar uma mudança na potência."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há esforços comparáveis suficientes para identificar uma mudança na potência."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za mało porównywalnych wysiłków, aby określić zmianę profilu mocy."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파워 변화를 파악하기에 비교 가능한 기록이 부족합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パワーの傾向の変化を判断するには、比較可能な記録が足りません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可比的功率表现记录不足，无法判断功率变化倾向。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可比較的表現記錄不足，無法判定功率變化趨勢。"
          }
        }
      }
    },
