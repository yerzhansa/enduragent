          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@botFather@에게 봇을 요청하고 토큰을 복사한 후 여기로 돌아오세요. %#@product@에서 클립보드의 토큰을 직접 읽고 확인하며, 토큰은 표시되지 않습니다."
