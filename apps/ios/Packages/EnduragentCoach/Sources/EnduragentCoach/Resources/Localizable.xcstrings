          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No había datos del estado de movimiento, por lo que puede incluirse el tiempo sin movimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune série de données sur l’état de mouvement n’était disponible ; les temps d’arrêt peuvent donc être inclus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati sullo stato di movimento non erano disponibili, quindi potrebbe essere incluso il tempo di sosta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es waren keine Bewegungsstatusdaten verfügbar. Daher können Standzeiten enthalten sein."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er waren geen gegevens over de bewegingsstatus beschikbaar, waardoor stilstandtijd kan zijn meegenomen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen dataserie for bevægelsesstatus var tilgængelig, så stilstand kan være medregnet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Data om rörelsestatus saknades, så tid då du stod stilla kan ingå."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen dataserie for bevegelsesstatus var tilgjengelig, så tid i ro kan være inkludert."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liikkumistietojen aikasarjaa ei ollut saatavilla, joten pysähdysaika voi sisältyä analyysiin."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não havia dados de estado de movimento disponíveis, pelo que o tempo parado pode estar incluído."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não havia uma série de dados de movimento disponível, por isso o tempo parado pode estar incluído."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak danych o ruchu, więc czas postoju może być uwzględniony."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이동 상태 데이터가 없어 정지 시간이 포함되었을 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動状態の時系列データがないため、停止時間が含まれている可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有移动状态数据流，因此可能包含停车时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有移動狀態資料串流，因此可能包含停止時間。"
          }
        }
      }
    },
    "training.ride.limitationVariable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Power varied substantially across the ride."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La potencia varió mucho durante la salida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La puissance a beaucoup varié au cours de la sortie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La potenza è variata molto durante l’uscita."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Leistung schwankte während der Fahrt stark."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het vermogen varieerde sterk tijdens de rit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Effekten varierede meget under turen."
          }
        },
        "sv": {
