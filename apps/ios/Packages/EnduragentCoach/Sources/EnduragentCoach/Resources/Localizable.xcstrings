    "settings.conversation.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set when conversations renew and how much recent context your coach carries forward."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define cuándo se renuevan las conversaciones y cuánto contexto reciente conserva tu entrenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définis quand les conversations se renouvellent et quelle quantité de contexte récent ton coach conserve."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta quando iniziare nuove conversazioni e quanto contesto recente conserva il coach."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege fest, wann neue Gespräche beginnen und wie viel vom letzten Gespräch dein Coach übernimmt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel in wanneer gesprekken opnieuw beginnen en hoeveel recente context je coach meeneemt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indstil, hvornår samtaler starter forfra, og hvor meget nylig kontekst din træner tager med videre."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange när ett nytt samtal börjar och hur mycket av det senaste sammanhanget tränaren tar med sig."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Angi når samtaler fornyes, og hvor mye av den siste konteksten treneren din tar med videre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Määritä, milloin keskustelut alkavat alusta ja kuinka paljon viimeaikaista keskustelua valmentajasi muistaa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Define quando as conversas se renovam e quanto contexto recente o teu treinador mantém."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina quando as conversas são renovadas e quanto do contexto recente o treinador mantém."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw, kiedy rozmowy zaczynają się od nowa i ile kontekstu z ostatnich rozmów zachowuje trener."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화를 새로 시작하는 시점과 코치가 이어서 참고할 최근 대화의 양을 설정합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話を新しくするタイミングと、コーチが引き継ぐ最近の会話の量を設定します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置何时开始新对话，以及教练保留多少近期对话内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定對話何時重新開始，以及教練延續多少近期對話內容。"
          }
        }
      }
    },
    "settings.conversation.error.notApplied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversation settings weren’t applied. Reconnect and reload before trying again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han aplicado los ajustes de conversación. Vuelve a conectar y recarga antes de intentarlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paramètres de conversation n’ont pas été appliqués. Reconnecte et recharge avant de réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni della conversazione non sono state applicate. Riconnetti e ricarica prima di riprovare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gesprächseinstellungen wurden nicht übernommen. Verbinde dich erneut und lade neu, bevor du es noch einmal versuchst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespreksinstellingen zijn niet toegepast. Maak opnieuw verbinding en laad opnieuw voordat je het nogmaals probeert."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Samtaleindstillingerne blev ikke anvendt. Opret forbindelse igen, og genindlæs, før du prøver igen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Samtalsinställningarna tillämpades inte. Anslut på nytt och läs in igen innan du försöker på nytt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Samtaleinnstillingene ble ikke tatt i bruk. Koble til og last inn på nytt før du prøver igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskusteluasetuksia ei otettu käyttöön. Yhdistä ja lataa uudelleen ennen uutta yritystä."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As definições de conversa não foram aplicadas. Volta a ligar e a carregar antes de tentares novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As configurações de conversa não foram aplicadas. Reconecte e recarregue antes de tentar novamente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zastosowano ustawień rozmowy. Połącz ponownie i odśwież dane przed kolejną próbą."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화 설정이 적용되지 않았습니다. 다시 연결하고 새로고침한 후 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話設定を適用できませんでした。再接続して再読み込みしてから、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话设置未生效。请重新连接并加载后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未套用對話設定。請重新連線並重新載入後再試。"
          }
        }
      }
    },
    "settings.conversation.error.requestFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversation settings couldn’t be saved. Your edits are still here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido guardar los ajustes de conversación. Tus cambios siguen aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paramètres de conversation n’ont pas pu être enregistrés. Tes modifications sont toujours ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare le impostazioni della conversazione. Le tue modifiche sono ancora qui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
