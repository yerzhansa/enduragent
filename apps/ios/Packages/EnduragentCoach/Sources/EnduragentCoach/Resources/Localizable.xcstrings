    "telegram.confirmation.expired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That proposal expired — ask me again and I'll re-propose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa propuesta ha caducado. Pídemela otra vez y volveré a proponerla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette proposition a expiré — redemande-moi et je te la proposerai à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La proposta è scaduta. Chiedimelo di nuovo e la riproporrò."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Vorschlag ist abgelaufen. Frag mich noch einmal, dann schlage ich es erneut vor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat voorstel is verlopen. Vraag het me opnieuw, dan doe ik een nieuw voorstel."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forslaget er udløbet — spørg mig igen, så foreslår jeg det på ny."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det förslaget har gått ut. Fråga mig igen så lägger jag fram det på nytt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forslaget har utløpt — spør meg igjen, så lager jeg et nytt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehdotus vanheni. Pyydä uudelleen, niin teen uuden ehdotuksen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa proposta expirou. Pede-me novamente e volto a propô-la."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa proposta expirou. Peça de novo e volto a propô-la."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta propozycja wygasła — poproś ponownie, a przygotuję ją jeszcze raz."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제안이 만료되었습니다. 다시 요청하시면 새로 제안하겠습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その提案は期限切れです。もう一度頼んでもらえれば、改めて提案します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这项提议已过期。再告诉我一次，我会重新提出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這項提議已過期。再告訴我一次，我會重新提出。"
          }
        }
      }
    },
