    "plan.view.ended.outcomeDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This records the race outcome. The ended Plan and its history stay unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto registra el resultado de la carrera. El Plan terminado y su historial no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela enregistre le résultat de la course. Le plan terminé et son historique restent inchangés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra l’esito della gara. Il piano terminato e la sua cronologia restano invariati."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermit wird das Rennergebnis erfasst. Der beendete Plan und sein Verlauf bleiben unverändert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit legt de afloop van de wedstrijd vast. Het beëindigde trainingsschema en de geschiedenis blijven ongewijzigd."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette registrerer konkurrencens udfald. Den afsluttede træningsplan og dens historik forbliver uændrede."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta registrerar tävlingsutfallet. Den avslutade planen och dess historik förblir oförändrade."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette registrerer konkurransens utfall. Den avsluttede planen og historikken forblir uendret."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä kirjaa kilpailun lopputuloksen. Päättynyt suunnitelma ja sen historia säilyvät ennallaan."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto regista o desfecho da prova. O Plano terminado e o seu histórico mantêm-se."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação registra o desfecho da prova. O plano encerrado e seu histórico permanecem inalterados."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zapisuje rezultat wyścigu. Zakończony plan i jego historia pozostają bez zmian."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대회 결과를 기록합니다. 종료된 계획과 그 기록은 변경되지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レースの結果を記録します。終了したプランとその履歴は変更されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作记录比赛完成情况。已结束的计划及其历史记录保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會記錄比賽成果。已結束的計畫及其記錄維持不變。"
          }
        }
      }
    },
