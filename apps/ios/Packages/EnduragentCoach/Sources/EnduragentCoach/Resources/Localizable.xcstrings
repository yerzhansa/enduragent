          "stringUnit": {
            "state": "translated",
            "value": "Dette slår %#@telegram@ fra og sletter det krypterede token og tilladte brugeres adgang fra %#@computer@. %#@telegram@-botten og chatten bliver i %#@telegram@."
          },
