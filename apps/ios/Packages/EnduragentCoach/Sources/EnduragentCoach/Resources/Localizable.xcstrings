    "plan.view.active.revisionDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The active Plan stays unchanged while the coach revises this Proposal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Plan activo no cambia mientras el entrenador revisa esta propuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plan actif reste inchangé pendant que le coach révise cette proposition."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il piano attivo resta invariato mentre il coach rivede questa proposta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktive Plan bleibt unverändert, während der Coach diesen Vorschlag überarbeitet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het actieve trainingsschema blijft ongewijzigd terwijl de coach dit voorstel herziet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den aktive træningsplan er uændret, mens træneren redigerer dette forslag."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den aktiva planen förblir oförändrad medan tränaren ändrar det här förslaget."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den aktive planen forblir uendret mens treneren reviderer dette forslaget."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiivinen suunnitelma säilyy ennallaan, kun valmentaja muokkaa tätä ehdotusta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Plano ativo mantém-se enquanto o treinador revê esta proposta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano ativo permanece inalterado enquanto o treinador revisa esta proposta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktywny plan pozostaje bez zmian, gdy trener poprawia tę propozycję."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코치가 이 제안을 수정하는 동안 활성 계획은 변경되지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コーチがこの提案を修正している間、有効なプランは変更されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "教练修改此方案期间，当前启用的计划保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "教練修改此提案期間，進行中的計畫維持不變。"
          }
        }
      }
    },
