    "training.export.status.ambiguousSource": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This ride could not be matched safely. Sync and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo identificar esta salida con seguridad. Sincroniza e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sortie n’a pas pu être identifiée avec certitude. Synchronise et réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile abbinare questa uscita con certezza. Sincronizza e riprova."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Fahrt konnte nicht sicher zugeordnet werden. Synchronisiere und versuche es erneut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze rit kon niet betrouwbaar worden gekoppeld. Synchroniseer en probeer het opnieuw."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne tur kunne ikke matches sikkert. Synkronisér, og prøv igen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här cykelturen kunde inte matchas säkert. Synkronisera och försök igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne turen kunne ikke kobles på en trygg måte. Synkroniser og prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä lenkkiä ei voitu yhdistää lähteeseen turvallisesti. Synkronoi ja yritä uudelleen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível associar esta volta com segurança. Sincroniza e tenta novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível identificar a correspondência desta pedalada com segurança. Sincronize e tente novamente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się bezpiecznie dopasować tego przejazdu. Zsynchronizuj dane i spróbuj ponownie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 라이딩을 안전하게 연결하지 못했습니다. 동기화한 후 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このライドとの一致を確実に確認できませんでした。同期してからもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法可靠地匹配此骑行。请同步后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法可靠地配對此騎乘。請同步後重試。"
          }
        }
      }
    },
