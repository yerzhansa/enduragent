    "chat.planCreation.feedback.workoutsUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Workouts fit anywhere in this Plan under your confirmed limits. Edit those limits to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún entrenamiento encaja en este plan con los límites que has confirmado. Edita esos límites para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun entraînement ne peut être intégré à ce plan avec les limites que tu as confirmées. Modifie ces limites pour continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun allenamento può essere inserito in questo piano con i limiti confermati. Modifica i limiti per continuare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter deinen bestätigten Limits passt kein Training in diesen Plan. Bearbeite die Limits, um fortzufahren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Binnen je bevestigde limieten past er nergens in dit trainingsschema een training. Pas die limieten aan om door te gaan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen træninger passer ind nogen steder i denne træningsplan med dine bekræftede grænser. Redigér grænserne for at fortsætte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga träningspass får plats i planen med de gränser du har bekräftat. Ändra gränserna för att fortsätta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen treningsøkter passer inn noe sted i denne planen med grensene du har bekreftet. Rediger grensene for å fortsette."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksikään harjoitus ei mahdu tähän suunnitelmaan vahvistamillasi rajoilla. Muokkaa rajoja jatkaaksesi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum treino cabe neste plano com os limites que confirmaste. Edita esses limites para continuar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum treino cabe neste plano com os limites que você confirmou. Edite esses limites para continuar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żaden trening nie mieści się w tym planie przy potwierdzonych limitach. Edytuj limity, aby kontynuować."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인한 제한을 적용하면 이 계획 어디에도 워크아웃을 배치할 수 없습니다. 계속하려면 제한을 수정하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確定した制限では、このプランのどの期間にもワークアウトを組み込めません。続けるには制限を編集してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按已确认的限制，此计划无法安排任何训练课程。请编辑限制以继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依已確認的限制，此計畫無法安排任何訓練課表。請編輯限制以繼續。"
          }
        }
      }
    },
