    "settings.spend.notice.incomplete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some provider costs are unavailable, so today’s total is a known minimum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos costes de proveedores no están disponibles, por lo que el total de hoy es el mínimo conocido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains coûts des fournisseurs sont indisponibles. Le total du jour est donc un minimum connu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni costi dei fornitori non sono disponibili, quindi il totale di oggi è il minimo noto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Anbieterkosten sind nicht verfügbar. Die heutige Summe ist daher nur der bekannte Mindestbetrag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige kosten van aanbieders zijn niet beschikbaar. Het totaal van vandaag is daarom een bekend minimum."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nogle udbyderomkostninger er utilgængelige, så dagens samlede beløb er et kendt minimum."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vissa leverantörskostnader är inte tillgängliga, så dagens totalsumma är ett känt minimibelopp."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
