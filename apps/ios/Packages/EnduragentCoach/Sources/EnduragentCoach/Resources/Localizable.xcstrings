    "settings.credentials.feedback.delete.stopFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The coach could not stop using this credential safely. It was not deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El entrenador no ha podido dejar de usar esta credencial de forma segura. No se ha eliminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le coach n’a pas pu cesser d’utiliser cette donnée d’authentification en toute sécurité. Elle n’a pas été supprimée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il coach non ha potuto interrompere l’uso di questa credenziale in sicurezza. Non è stata eliminata."
