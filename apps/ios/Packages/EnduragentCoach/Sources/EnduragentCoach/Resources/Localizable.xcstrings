    "chat.planCreation.confirmLimitHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I understood your note as this limit. Confirm it and your other confirmed limits stay as they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entendí tu nota como este límite. Confírmalo y los demás límites confirmados siguen igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’ai compris ta note comme cette limite. Confirme-la ; tes autres limites confirmées restent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho capito la tua nota come questo limite. Confermalo e gli altri limiti confermati restano."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe deine Notiz als dieses Limit verstanden. Bestätige es; deine anderen bestätigten Limits bleiben."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik heb je opmerking als deze limiet begrepen. Bevestig hem; je andere bevestigde limieten blijven."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg forstod din note som denne grænse. Bekræft den, så forbliver dine øvrige bekræftede grænser."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag tolkade din anteckning som den här gränsen. Bekräfta den så behålls dina övriga bekräftade gränser."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg forsto notatet ditt som denne grensen. Bekreft den, så blir de andre bekreftede grensene stående."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ymmärsin merkintäsi tänä rajoituksena. Vahvista se, niin muut vahvistetut rajoitukset säilyvät."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Entendi a tua nota como este limite. Confirma-o e os outros limites confirmados mantêm-se."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entendi seu recado como este limite. Confirme e os outros limites confirmados continuam valendo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odczytałem twoją notatkę jako ten limit. Potwierdź go, a pozostałe potwierdzone limity zostaną."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모를 이 제한으로 이해했습니다. 확인하면 이미 확인한 다른 제한은 그대로입니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモをこの制限として理解しました。確定すれば、ほかの確定済みの制限はそのままです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我把你的说明理解成这项限制。确认后，其他已确认的限制保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我把你的說明理解成這項限制。確認後，其他已確認的限制維持不變。"
          }
        }
      }
    },
