    "settings.athlete.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the exact identifier associated with the credential already connected in Setup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el identificador exacto asociado a la credencial ya conectada en Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise l’identifiant exact associé à la donnée d’authentification déjà connectée dans Configuration."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa l’identificativo esatto associato alla credenziale già collegata in Configurazione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende die genaue Kennung, die zu den unter Einrichtung bereits verbundenen Zugangsdaten gehört."
