    "plan.view.appliedHistory.automaticDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-apply reduced one future Workout after every safety rule passed. The seven-day %#@intervals@ update has not started yet."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación automática redujo un entrenamiento futuro tras cumplir todas las reglas de seguridad. La actualización de los siete días en %#@intervals@ aún no ha empezado."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’application automatique a allégé un entraînement à venir après validation de toutes les règles de sécurité. La mise à jour des sept jours dans %#@intervals@ n’a pas encore commencé."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’applicazione automatica ha ridotto un allenamento futuro dopo il superamento di tutte le verifiche di sicurezza. L’aggiornamento dei sette giorni su %#@intervals@ non è ancora iniziato."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die automatische Anwendung hat ein künftiges Training reduziert, nachdem alle Sicherheitsregeln erfüllt waren. Die Aktualisierung der nächsten sieben Tage in %#@intervals@ wurde noch nicht gestartet."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch toepassen heeft één toekomstige training verlicht nadat alle veiligheidscontroles waren geslaagd. Het bijwerken van zeven dagen in %#@intervals@ is nog niet gestart."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisk anvendelse reducerede én fremtidig træning, efter at alle sikkerhedsregler var opfyldt. Opdateringen af de syv dage i %#@intervals@ er endnu ikke startet."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den automatiska tillämpningen minskade ett framtida träningspass efter att alla säkerhetsregler hade uppfyllts. Uppdateringen av sju dagar i %#@intervals@ har inte startat än."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisk bruk reduserte én fremtidig treningsøkt etter at alle sikkerhetsreglene var oppfylt. Oppdateringen av de sju dagene i %#@intervals@ har ikke startet ennå."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaattinen käyttöönotto kevensi yhtä tulevaa harjoitusta, kun kaikki turvasäännöt täyttyivät. Seitsemän päivän päivitystä palveluun %#@intervals@ ei ole vielä aloitettu."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A aplicação automática reduziu um treino futuro depois de todas as regras de segurança terem sido cumpridas. A atualização dos sete dias em %#@intervals@ ainda não começou."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A aplicação automática reduziu um treino futuro após todas as regras de segurança serem atendidas. A atualização dos sete dias em %#@intervals@ ainda não começou."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatyczne stosowanie zmniejszyło jeden przyszły trening po spełnieniu wszystkich zasad bezpieczeństwa. Aktualizacja siedmiu dni w %#@intervals@ jeszcze się nie rozpoczęła."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 안전 규칙을 충족하여 자동 적용으로 향후 워크아웃 하나의 훈련량을 줄였습니다. %#@intervals@의 7일 일정 업데이트는 아직 시작되지 않았습니다."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての安全ルールを満たしたため、自動適用で今後のワークアウト1件の負荷を軽減しました。%#@intervals@の7日分の更新はまだ始まっていません。"
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有安全规则均通过后，自动应用功能减少了一次未来训练课程的训练量。%#@intervals@ 的七天日程更新尚未开始。"
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有安全規則皆通過後，自動套用功能已調降一份未來訓練課表。尚未開始更新 %#@intervals@ 的七天行事曆。"
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        }
      }
    },
