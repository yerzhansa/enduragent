    "sidebar.sync.message.indeterminate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection interrupted. The sync may still be finishing. %#@product@ won’t retry it automatically."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexión interrumpida. Puede que la sincronización aún esté terminando. %#@product@ no la reintentará automáticamente."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion interrompue. La synchronisation est peut-être encore en cours. %#@product@ ne la relancera pas automatiquement."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connessione interrotta. La sincronizzazione potrebbe essere ancora in fase di completamento. %#@product@ non la ritenterà automaticamente."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung unterbrochen. Die Synchronisierung wird möglicherweise noch abgeschlossen. %#@product@ versucht sie nicht automatisch erneut."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinding onderbroken. De synchronisatie wordt mogelijk nog afgerond. %#@product@ probeert het niet automatisch opnieuw."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbindelsen blev afbrudt. Synkroniseringen er muligvis stadig ved at blive afsluttet. %#@product@ prøver ikke automatisk igen."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslutningen avbröts. Synkroniseringen kanske fortfarande håller på att slutföras. %#@product@ försöker inte igen automatiskt."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilkoblingen ble avbrutt. Synkroniseringen kan fortsatt være i ferd med å fullføres. %#@product@ prøver ikke igjen automatisk."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhteys katkesi. Synkronointi saattaa vielä olla valmistumassa. %#@product@ ei yritä sitä uudelleen automaattisesti."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligação interrompida. A sincronização pode ainda estar a terminar. %#@product@ não voltará a tentá-la automaticamente."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexão interrompida. A sincronização ainda pode estar sendo concluída. %#@product@ não tentará novamente automaticamente."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie przerwane. Synchronizacja może jeszcze dobiegać końca. %#@product@ nie ponowi jej automatycznie."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결이 중단되었습니다. 동기화가 아직 마무리 중일 수 있습니다. %#@product@에서 자동으로 다시 시도하지 않습니다."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続が中断されました。同期はまだ完了処理中の可能性があります。%#@product@は自動で再試行しません。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接中断。同步可能仍在完成中。%#@product@ 不会自动重试。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線已中斷。同步可能仍在完成中。%#@product@ 不會自動重試。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        }
      }
    },
