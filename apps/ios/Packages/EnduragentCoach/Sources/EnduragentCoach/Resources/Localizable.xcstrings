            "value": "Atleet-ID's mogen maximaal 512 tekens bevatten."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Atlet-ID'er må højst indeholde 512 tegn."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Idrotts-ID får innehålla högst 512 tecken."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utøver-ID-er må være på 512 tegn eller færre."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Urheilijatunnuksessa saa olla enintään 512 merkkiä."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os IDs de atleta têm de ter, no máximo, 512 carateres."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "IDs de atleta devem ter no máximo 512 caracteres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Identyfikatory sportowca mogą mieć najwyżej 512 znaków."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선수 ID는 512자 이하여야 합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アスリートIDは512文字以内で入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
