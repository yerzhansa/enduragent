    "sidebar.sync.message.operationFailure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn’t complete the training-data check. Your existing data is still available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hemos podido completar la comprobación de los datos de entrenamiento. Tus datos existentes siguen disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification des données d’entraînement n’a pas pu être terminée. Tes données existantes sont toujours disponibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile completare la verifica dei dati di allenamento. I dati esistenti sono ancora disponibili."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Prüfung der Trainingsdaten konnte nicht abgeschlossen werden. Deine vorhandenen Daten sind weiterhin verfügbar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We konden de controle van trainingsgegevens niet voltooien. Je bestaande gegevens zijn nog beschikbaar."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke fuldføre kontrollen af træningsdata. Dine eksisterende data er stadig tilgængelige."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunde inte slutföra kontrollen av träningsdata. Dina befintliga data är fortfarande tillgängliga."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke fullføre sjekken av treningsdata. De eksisterende dataene dine er fortsatt tilgjengelige."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Harjoitustietojen tarkistusta ei voitu suorittaa loppuun. Nykyiset tietosi ovat yhä käytettävissä."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível concluir a verificação dos dados de treino. Os teus dados existentes continuam disponíveis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível concluir a verificação dos dados de treinamento. Seus dados existentes continuam disponíveis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się ukończyć sprawdzania danych treningowych. Twoje istniejące dane są nadal dostępne."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "훈련 데이터 확인을 완료하지 못했습니다. 기존 데이터는 계속 사용할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トレーニングデータの確認を完了できませんでした。既存のデータは引き続き利用できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法完成训练数据检查。现有数据仍可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法完成訓練資料檢查。既有資料仍可使用。"
          }
        }
      }
    },
