    "desktop.lifecycle.contentionContent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another %#@product@ process is already running or stuck. Quit that process, then reopen %#@product@. If you can’t find it, log out and back in."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro proceso de %#@product@ ya está en ejecución o se ha bloqueado. Cierra ese proceso y vuelve a abrir %#@product@. Si no lo encuentras, cierra sesión y vuelve a iniciarla."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre processus %#@product@ est déjà en cours d'exécution ou bloqué. Arrête ce processus, puis rouvre %#@product@. Si tu ne le trouves pas, ferme ta session et reconnecte-toi."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro processo di %#@product@ è già in esecuzione o si è bloccato. Termina quel processo, poi riapri %#@product@. Se non lo trovi, esci dalla sessione e accedi di nuovo."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Prozess von %#@product@ läuft bereits oder reagiert nicht mehr. Beende diesen Prozess und öffne %#@product@ erneut. Wenn du ihn nicht findest, melde dich ab und wieder an."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een ander proces van %#@product@ is al actief of loopt vast. Sluit dat proces af en open %#@product@ opnieuw. Kun je het niet vinden, log dan uit en weer in."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En anden %#@product@-proces kører allerede eller er gået i stå. Afslut den proces, og åbn derefter %#@product@ igen. Hvis du ikke kan finde den, så log ud og ind igen."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En annan %#@product@-process körs redan eller har fastnat. Avsluta den processen och öppna sedan %#@product@ igen. Om du inte hittar den, logga ut och in igen."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En annen %#@product@-prosess kjører allerede eller har låst seg. Avslutt den prosessen, og åpne deretter %#@product@ på nytt. Hvis du ikke finner den, logger du ut og inn igjen."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toinen %#@product@-prosessi on jo käynnissä tai jumissa. Lopeta kyseinen prosessi ja avaa sitten %#@product@ uudelleen. Jos et löydä sitä, kirjaudu ulos ja takaisin sisään."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro processo de %#@product@ já está em execução ou ficou bloqueado. Termina esse processo e volta a abrir %#@product@. Se não o encontrares, termina sessão e volta a iniciá-la."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro processo de %#@product@ já está em execução ou travou. Encerre esse processo e reabra %#@product@. Se não conseguir encontrá-lo, saia da sessão e entre novamente."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inny proces %#@product@ już działa lub się zawiesił. Zakończ ten proces, a następnie otwórz ponownie %#@product@. Jeśli nie możesz go znaleźć, wyloguj się i zaloguj ponownie."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 %#@product@ 프로세스가 이미 실행 중이거나 멈춰 있습니다. 해당 프로세스를 종료한 후 %#@product@을(를) 다시 여세요. 찾을 수 없으면 로그아웃한 후 다시 로그인하세요."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の%#@product@プロセスがすでに実行中か、応答しなくなっています。そのプロセスを終了してから、%#@product@を開き直してください。見つからない場合は、ログアウトしてからログインし直してください。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个 %#@product@ 进程已在运行或已卡住。请退出该进程，再重新打开 %#@product@。如果找不到该进程，请注销后重新登录。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一個 %#@product@ 程序已在執行或已停止回應。請結束該程序，再重新開啟 %#@product@。若找不到該程序，請登出後重新登入。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        }
      }
    },
    "desktop.lifecycle.contentionTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@product@ couldn’t connect to its background service"
