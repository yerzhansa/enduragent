          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@reply@\n\n(Let op: mijn schijf is vol, dus ik kon dit niet opslaan in onze geschiedenis. Je bericht is wel aangekomen. Maak ruimte vrij zodra je kunt.)"
          },
          "substitutions": {
