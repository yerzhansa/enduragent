    "telegram.snapshot.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@raw@    — dump pre-curation %#@file@ (or one section)\n%#@help@             — show this list\n\nFuture variants of %#@command@ will surface metrics, activities, wellness,\nintervals, routes, history, FTP, and validation cuts. For now, only\n%#@rawCommand@ is wired."
          },
