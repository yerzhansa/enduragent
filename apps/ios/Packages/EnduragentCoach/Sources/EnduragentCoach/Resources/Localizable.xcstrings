    "plan.view.historyResult.restoredWorkoutDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@value1@ · %#@value2@ is restored. The seven-day %#@intervals@ window will reconcile next."
          },
          "substitutions": {
            "value1": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "value2": {
              "argNum": 2,
              "formatSpecifier": "@"
            },
            "intervals": {
              "argNum": 3,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
