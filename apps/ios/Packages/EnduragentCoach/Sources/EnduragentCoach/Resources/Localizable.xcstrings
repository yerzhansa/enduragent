            "value": "No training account credential is connected. Use the setup area above to connect one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna credencial de cuenta de entrenamiento conectada. Usa el área de configuración de arriba para conectar una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune donnée d’authentification de compte d’entraînement n’est connectée. Utilise la zone de configuration ci-dessus pour en connecter une."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna credenziale di un account di allenamento è collegata. Usa l’area di configurazione qui sopra per collegarne una."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es sind keine Zugangsdaten für ein Trainingskonto verbunden. Verbinde ein Konto im Einrichtungsbereich oben."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen toegangsgegevens voor een trainingsaccount gekoppeld. Gebruik het configuratiegedeelte hierboven om ze te koppelen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ikke tilknyttet adgangsoplysninger til en træningskonto. Brug opsætningsområdet ovenfor til at tilknytte dem."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga inloggningsuppgifter för ett träningskonto är anslutna. Använd konfigurationen ovan för att ansluta ett konto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen tilgangsopplysninger for en treningskonto er tilkoblet. Bruk oppsettområdet ovenfor for å koble til."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Harjoittelutilin tunnistautumistietoa ei ole yhdistetty. Yhdistä se yllä olevassa käyttöönotto-osiossa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há nenhuma credencial de conta de treino ligada. Usa a área de configuração acima para ligares uma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma credencial de conta de treinamento está conectada. Use a área de configuração acima para conectar uma."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie połączono danych dostępowych konta treningowego. Połącz je w sekcji konfiguracji powyżej."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 훈련 계정의 인증 정보가 없습니다. 위의 설정 영역에서 연결하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トレーニングアカウントの認証情報が接続されていません。上のセットアップ欄で接続してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未连接训练账号凭据。请在上方的设置区域连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未連結訓練帳號憑證。請在上方的初始設定區連結。"
          }
        }
      }
    },
    "settings.athlete.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This may only identify the currently connected training account. It cannot switch accounts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo permite identificar la cuenta de entrenamiento conectada actualmente. No permite cambiar de cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce champ peut uniquement identifier le compte d’entraînement actuellement connecté. Il ne permet pas de changer de compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo campo può solo identificare l’account di allenamento attualmente collegato. Non consente di cambiare account."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermit lässt sich nur das aktuell verbundene Trainingskonto identifizieren. Ein Kontowechsel ist nicht möglich."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee kun je alleen het momenteel gekoppelde trainingsaccount identificeren. Je kunt er niet mee van account wisselen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette kan kun identificere den aktuelt tilknyttede træningskonto. Det kan ikke skifte konto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här får bara identifiera det träningskonto som är anslutet nu. Det går inte att byta konto här."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette kan bare identifisere treningskontoen som er tilkoblet nå. Det kan ikke bytte konto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tällä voi vain tunnistaa tällä hetkellä yhdistetyn harjoittelutilin. Tiliä ei voi vaihtaa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto só permite identificar a conta de treino atualmente ligada. Não permite mudar de conta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este campo só pode identificar a conta de treinamento conectada atualmente. Ele não permite trocar de conta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz tu wskazać tylko obecnie połączone konto treningowe. Nie możesz przełączać kont."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 연결된 훈련 계정을 식별하는 용도로만 사용할 수 있습니다. 계정을 전환할 수는 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在接続中のトレーニングアカウントの識別にのみ使用できます。アカウントは切り替えられません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处只能填写当前已连接训练账号的标识，不能切换账号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此欄位只能識別目前連結的訓練帳號，無法切換帳號。"
          }
        }
      }
    },
    "settings.athlete.error.credentialRequired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect the training account in Setup before saving its athlete ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta la cuenta de entrenamiento en Configuración antes de guardar su ID de deportista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecte le compte d’entraînement dans Configuration avant d’enregistrer son identifiant d’athlète."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
