    "setup.training.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In %#@intervals@, open Settings → Developer Settings, copy the API key, then return here. %#@product@ reads it without showing it."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "product": {
              "argNum": 2,
              "formatSpecifier": "@"
