    "plan.library.stop.unconfirmed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopping could not be confirmed. The library will show the current state after refresh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar la detención. La biblioteca mostrará el estado actual al actualizarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’arrêt n’a pas pu être confirmé. La bibliothèque affichera l’état actuel après actualisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile confermare l’interruzione. La raccolta mostrerà lo stato attuale dopo l’aggiornamento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Stoppen konnte nicht bestätigt werden. Die Bibliothek zeigt nach dem Aktualisieren den aktuellen Stand."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het stoppen kon niet worden bevestigd. Na het vernieuwen toont de bibliotheek de huidige status."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppet kunne ikke bekræftes. Biblioteket viser den aktuelle status efter genindlæsning."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppet kunde inte bekräftas. Biblioteket visar det aktuella läget efter uppdatering."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppingen kunne ikke bekreftes. Biblioteket viser gjeldende status etter oppdatering."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lopettamista ei voitu vahvistaa. Kirjasto näyttää nykyisen tilan päivityksen jälkeen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar a interrupção. A biblioteca mostrará o estado atual após a atualização."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar a interrupção. A biblioteca mostrará o estado atual após a atualização."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się potwierdzić zatrzymania. Biblioteka pokaże bieżący stan po odświeżeniu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중단 결과를 확인하지 못했습니다. 새로고침하면 라이브러리에 현재 상태가 표시됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中止を確認できませんでした。ライブラリを更新すると現在の状態が表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认停止结果。刷新后，计划库将显示当前状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認計畫是否已停止。重新整理後，計畫庫將顯示目前狀態。"
          }
        }
      }
    },
