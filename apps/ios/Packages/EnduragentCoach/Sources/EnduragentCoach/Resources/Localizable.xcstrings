    "plan.view.planHistory.endDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End this Plan. Today’s workout stays; tomorrow-onward %#@product@ workouts are removed."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina este Plan. El entrenamiento de hoy se conserva; los entrenamientos de %#@product@ a partir de mañana se eliminan."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mets fin à ce plan. L’entraînement d’aujourd’hui est conservé ; les entraînements %#@product@ prévus à partir de demain sont supprimés."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina questo piano. L’allenamento di oggi rimane; gli allenamenti di %#@product@ da domani in poi vengono rimossi."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende diesen Plan. Das heutige Training bleibt bestehen. Ab morgen geplante Trainings von %#@product@ werden entfernt."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beëindig dit trainingsschema. De training van vandaag blijft staan. Trainingen van %#@product@ vanaf morgen worden verwijderd."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afslut denne træningsplan. Dagens træning bliver bevaret. %#@product@-træninger fra i morgen og frem fjernes."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avsluta den här planen. Dagens träningspass finns kvar. Träningspass från %#@product@ från och med imorgon tas bort."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avslutt denne planen. Dagens treningsøkt beholdes. %#@product@-treningsøkter fra i morgen og fremover fjernes."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päätä tämä suunnitelma. Tämän päivän harjoitus säilyy. Sovelluksen %#@product@ harjoitukset huomisesta eteenpäin poistetaan."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina este Plano. O treino de hoje mantém-se; os treinos de %#@product@ a partir de amanhã são removidos."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerre este plano. O treino de hoje permanece; os treinos de %#@product@ a partir de amanhã são removidos."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakończ ten plan. Dzisiejszy trening pozostaje. Treningi %#@product@ od jutra zostaną usunięte."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계획을 종료합니다. 오늘의 워크아웃은 유지되며, 내일 이후의 %#@product@ 워크아웃은 삭제됩니다."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプランを終了します。今日のワークアウトは残り、明日以降の%#@product@のワークアウトは削除されます。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束此计划。今天的训练课程会保留；从明天起的 %#@product@ 训练课程将被移除。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束此計畫。今天的訓練課表會保留；明天起的 %#@product@ 訓練課表會移除。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        }
      }
    },
