    "cli.startup.memoryFlushDidNotFinishBefore": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "memory flush did not finish before shutdown:"
          }
        },
        "es": {
          "stringUnit": {
