    "telegram.snapshot.operatorOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raw snapshots are available only to the primary operator."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las instantáneas sin procesar solo están disponibles para el operador principal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les instantanés bruts sont réservés à l’opérateur principal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le istantanee dei dati grezzi sono disponibili solo all’operatore principale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unverarbeitete Momentaufnahmen sind nur für den Hauptbetreiber verfügbar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onbewerkte momentopnamen zijn alleen beschikbaar voor de primaire beheerder."
          }
        },
        "da": {
          "stringUnit": {
