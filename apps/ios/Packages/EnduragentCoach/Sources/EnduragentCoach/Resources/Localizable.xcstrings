          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den nåværende planen din forblir aktiv. Erstatningsutkastet åpnes automatisk."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nykyinen suunnitelmasi pysyy aktiivisena. Korvaava luonnos avautuu automaattisesti."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu Plano atual mantém-se ativo. O rascunho de substituição abre automaticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
