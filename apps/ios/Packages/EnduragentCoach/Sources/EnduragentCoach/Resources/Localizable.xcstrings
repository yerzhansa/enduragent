        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać ustawień rozmowy. Twoje zmiany nadal tu są."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화 설정을 저장하지 못했습니다. 입력한 내용은 유지됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話設定を保存できませんでした。入力内容は残っています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存对话设置。编辑内容仍保留在此处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存對話設定。編輯內容仍保留在這裡。"
          }
        }
      }
    },
    "settings.conversation.error.runtimeUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current conversation settings couldn’t be reloaded. Your edits are still here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido volver a cargar los ajustes de conversación actuales. Tus cambios siguen aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paramètres de conversation actuels n’ont pas pu être rechargés. Tes modifications sont toujours ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile ricaricare le impostazioni attuali della conversazione. Le tue modifiche sono ancora qui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktuellen Gesprächseinstellungen konnten nicht neu geladen werden. Deine Änderungen sind noch vorhanden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De huidige gespreksinstellingen konden niet opnieuw worden geladen. Je wijzigingen staan er nog."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De aktuelle samtaleindstillinger kunne ikke genindlæses. Dine ændringer er her stadig."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De aktuella samtalsinställningarna kunde inte läsas in igen. Dina ändringar finns kvar här."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De nåværende samtaleinnstillingene kunne ikke lastes inn på nytt. Endringene dine er fortsatt her."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nykyisiä keskusteluasetuksia ei voitu ladata uudelleen. Muutoksesi ovat yhä tässä."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível recarregar as definições de conversa atuais. As tuas alterações continuam aqui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível recarregar as configurações de conversa atuais. Suas edições continuam aqui."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się ponownie wczytać bieżących ustawień rozmowy. Twoje zmiany nadal tu są."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 대화 설정을 다시 불러오지 못했습니다. 입력한 내용은 유지됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の会話設定を再読み込みできませんでした。入力内容は残っています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法重新加载当前对话设置。编辑内容仍保留在此处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法重新載入目前的對話設定。編輯內容仍保留在這裡。"
          }
        }
      }
    },
