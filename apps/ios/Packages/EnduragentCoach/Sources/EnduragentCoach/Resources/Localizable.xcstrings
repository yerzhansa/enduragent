    "settings.athlete.error.notApplied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The athlete ID wasn’t applied. Reconnect and reload before trying again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha aplicado el ID de deportista. Vuelve a conectar y recarga antes de intentarlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’identifiant d’athlète n’a pas été appliqué. Reconnecte et recharge avant de réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ID atleta non è stato applicato. Riconnetti e ricarica prima di riprovare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Athleten-ID wurde nicht übernommen. Verbinde dich erneut und lade neu, bevor du es noch einmal versuchst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De atleet-ID is niet toegepast. Maak opnieuw verbinding en laad opnieuw voordat je het nogmaals probeert."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Atlet-ID'et blev ikke anvendt. Opret forbindelse igen, og genindlæs, før du prøver igen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Idrotts-ID:t tillämpades inte. Anslut på nytt och läs in igen innan du försöker på nytt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utøver-ID-en ble ikke tatt i bruk. Koble til og last inn på nytt før du prøver igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Urheilijatunnusta ei otettu käyttöön. Yhdistä ja lataa uudelleen ennen uutta yritystä."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O ID de atleta não foi aplicado. Volta a ligar e a carregar antes de tentares novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ID de atleta não foi aplicado. Reconecte e recarregue antes de tentar novamente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zastosowano identyfikatora sportowca. Połącz ponownie i odśwież dane przed kolejną próbą."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선수 ID가 적용되지 않았습니다. 다시 연결하고 새로고침한 후 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アスリートIDを適用できませんでした。再接続して再読み込みしてから、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运动员 ID 未生效。请重新连接并加载后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未套用運動員 ID。請重新連線並重新載入後再試。"
          }
        }
      }
    },
    "settings.athlete.error.ownershipUnavailable": {
      "localizations": {
