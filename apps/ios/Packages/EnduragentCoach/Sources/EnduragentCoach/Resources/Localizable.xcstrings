        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyydä palvelua %#@botFather@ luomaan botti, kopioi sen tunniste ja palaa sitten tänne. %#@product@ lukee ja vahvistaa tunnisteen suoraan leikepöydältä. Tunnistetta ei koskaan näytetä."
          },
          "substitutions": {
            "botFather": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "product": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pede a %#@botFather@ que crie um bot, copia o respetivo token e volta aqui. %#@product@ lê e verifica o token diretamente da área de transferência. O token nunca é mostrado."
          },
          "substitutions": {
            "botFather": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "product": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Peça a %#@botFather@ um bot, copie seu token e volte aqui. %#@product@ lê e verifica o token diretamente da área de transferência; o token nunca é exibido."
          },
          "substitutions": {
            "botFather": {
