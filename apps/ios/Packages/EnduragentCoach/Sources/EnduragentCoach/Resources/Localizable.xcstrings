          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ændringen blev ikke anvendt, fordi lagringen ikke kunne kontrolleres. Genstart %#@product@, og kontrollér denne indstilling, før du prøver igen."
          },
          "substitutions": {
