          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As credenciais salvas não estão disponíveis. Reconecte e recarregue."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisane dane dostępowe są niedostępne. Połącz ponownie i odśwież dane."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 인증 정보를 사용할 수 없습니다. 다시 연결하고 새로고침하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みの認証情報を利用できません。再接続して再読み込みしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的凭据不可用。请重新连接并加载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法使用已儲存的憑證。請重新連線並重新載入。"
          }
        }
      }
