    "setup.error.endpointInvalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid HTTPS endpoint, or a loopback HTTP endpoint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce una dirección de servicio HTTPS válida o una dirección HTTP de bucle local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisis un point de terminaison HTTPS valide, ou un point de terminaison HTTP de bouclage local."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un endpoint HTTPS valido o un endpoint HTTP di loopback."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen gültigen HTTPS-Endpunkt oder einen HTTP-Endpunkt mit Loopback-Adresse ein."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een geldig HTTPS-eindpunt of een HTTP-loopbackeindpunt in."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast et gyldigt HTTPS-slutpunkt eller et HTTP-loopbackslutpunkt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange en giltig HTTPS-slutpunkt eller en HTTP-slutpunkt med loopback-adress."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn et gyldig HTTPS-endepunkt eller et lokalt HTTP-endepunkt med loopback-adresse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna kelvollinen HTTPS-yhteysosoite tai loopback-osoitetta käyttävä HTTP-yhteysosoite."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduz um endpoint HTTPS válido ou um endpoint HTTP de loopback."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira um endpoint HTTPS válido ou um endpoint HTTP de loopback."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz prawidłowy punkt końcowy HTTPS lub punkt końcowy HTTP na adresie pętli zwrotnej."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유효한 HTTPS 엔드포인트 또는 루프백 HTTP 엔드포인트를 입력하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なHTTPSエンドポイント、またはループバックHTTPエンドポイントを入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入有效的 HTTPS 端点，或使用回环地址的 HTTP 端点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入有效的 HTTPS 端點，或本機回環 HTTP 端點。"
          }
        }
      }
    },
    "setup.error.intakeIncomplete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer the required safety questions to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde a las preguntas de seguridad obligatorias para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réponds aux questions de sécurité obligatoires pour continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispondi alle domande obbligatorie sulla sicurezza per continuare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantworte die erforderlichen Sicherheitsfragen, um fortzufahren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beantwoord de verplichte veiligheidsvragen om door te gaan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Besvar de obligatoriske sikkerhedsspørgsmål for at fortsætte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
