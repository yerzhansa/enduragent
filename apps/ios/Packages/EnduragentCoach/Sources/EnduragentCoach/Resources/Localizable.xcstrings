    "plan.view.raceWeek.syncFailureDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some race-week workouts may be missing in %#@intervals@; the Plan below is authoritative."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que falten entrenamientos de la semana de la carrera en %#@intervals@; el Plan que aparece a continuación es la referencia."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains entraînements de la semaine de course peuvent manquer dans %#@intervals@ ; le plan ci-dessous fait référence."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni allenamenti della settimana di gara potrebbero mancare in %#@intervals@; il piano qui sotto fa fede."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Trainings der Rennwoche fehlen möglicherweise in %#@intervals@. Maßgeblich ist der unten gezeigte Plan."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige trainingen in de wedstrijdweek kunnen ontbreken in %#@intervals@. Het onderstaande trainingsschema is leidend."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nogle træninger i konkurrenceugen kan mangle i %#@intervals@. Træningsplanen nedenfor er den gældende."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vissa träningspass under tävlingsveckan kan saknas i %#@intervals@. Planen nedan gäller."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noen treningsøkter i konkurranseuken kan mangle i %#@intervals@. Planen nedenfor er gjeldende."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Joitakin kilpailuviikon harjoituksia saattaa puuttua palvelusta %#@intervals@. Alla oleva suunnitelma on ensisijainen."
