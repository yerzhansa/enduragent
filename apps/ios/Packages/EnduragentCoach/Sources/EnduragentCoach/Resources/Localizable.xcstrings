    "settings.telegram.pairing.expired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pairing code expired before it was used. Create a new code when you are ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código de vinculación ha caducado antes de usarse. Crea un nuevo código cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code d’association a expiré avant d’être utilisé. Crée un nouveau code quand tu le souhaites."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice di abbinamento è scaduto prima dell’uso. Crea un nuovo codice quando vuoi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kopplungscode ist vor seiner Verwendung abgelaufen. Erstelle einen neuen Code, wenn du bereit bist."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De koppelcode is verlopen voordat deze werd gebruikt. Maak een nieuwe code wanneer je zover bent."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Parringskoden udløb, før den blev brugt. Opret en ny kode, når du er klar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Parkopplingskoden gick ut innan den användes. Skapa en ny kod när du är redo."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammenkoblingskoden utløp før den ble brukt. Opprett en ny kode når du er klar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pariliitoskoodi vanheni ennen käyttöä. Luo uusi koodi, kun olet valmis."
