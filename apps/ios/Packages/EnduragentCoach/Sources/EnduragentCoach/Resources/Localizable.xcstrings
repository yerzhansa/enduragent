            "intervals": {
              "argNum": 2,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计划将立即结束。今天的训练课程会保留，%#@intervals@ 中从明天起的 %#@product@ 训练课程将被移除。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
