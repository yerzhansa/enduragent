    "archive.truncated": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the most recent past conversations are listed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se muestran las conversaciones anteriores más recientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les conversations passées les plus récentes sont affichées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono elencate solo le conversazioni passate più recenti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden nur die neuesten früheren Gespräche angezeigt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de meest recente eerdere gesprekken worden weergegeven."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun de seneste tidligere samtaler vises."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast de senaste tidigare samtalen visas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare de nyeste tidligere samtalene vises."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luettelossa näkyvät vain uusimmat aiemmat keskustelut."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Só são apresentadas as conversas anteriores mais recentes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas as conversas anteriores mais recentes são listadas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista zawiera tylko najnowsze wcześniejsze rozmowy."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 최근의 이전 대화만 표시됩니다."
          }
        },
        "ja": {
