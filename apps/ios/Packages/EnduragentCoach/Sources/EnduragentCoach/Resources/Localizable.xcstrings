    "setup.error.credentialSaveFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That key could not be saved. Try entering it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar esa clave. Intenta introducirla de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette clé n’a pas pu être enregistrée. Essaie de la saisir à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare la chiave. Prova a inserirla di nuovo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Schlüssel konnte nicht gespeichert werden. Versuche, ihn erneut einzugeben."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die sleutel kon niet worden opgeslagen. Probeer deze opnieuw in te voeren."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nøglen kunne ikke gemmes. Prøv at indtaste den igen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyckeln kunde inte sparas. Försök ange den igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nøkkelen kunne ikke lagres. Prøv å skrive den inn på nytt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avainta ei voitu tallentaa. Yritä antaa se uudelleen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar essa chave. Tenta introduzi-la novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar essa chave. Tente inseri-la novamente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać tego klucza. Spróbuj wpisać go ponownie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 저장하지 못했습니다. 다시 입력하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを保存できませんでした。もう一度入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存该密钥。请重新输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存此金鑰。請嘗試重新輸入。"
          }
        }
      }
    },
    "setup.error.credentialStatusUnavailable": {
