    "chat.view.disclaimer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not medical advice, and not a substitute for a doctor or a certified coach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es asesoramiento médico ni sustituye a un médico o a un entrenador certificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces informations ne sont pas un avis médical et ne remplacent pas un médecin ou un coach certifié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è un consiglio medico e non sostituisce un medico o un coach certificato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine medizinische Beratung und kein Ersatz für einen Arzt oder einen zertifizierten Coach."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen medisch advies en geen vervanging voor een arts of een gecertificeerde coach."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke lægefaglig rådgivning og ikke en erstatning for en læge eller en certificeret træner."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta är inte medicinsk rådgivning och ersätter inte en läkare eller certifierad tränare."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er ikke medisinske råd og erstatter ikke en lege eller en sertifisert trener."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei lääketieteellisiä neuvoja eikä korvaa lääkäriä tai pätevää valmentajaa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não constitui aconselhamento médico nem substitui um médico ou um treinador certificado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não constitui aconselhamento médico nem substitui um médico ou um treinador certificado."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nie jest porada medyczna ani zastępstwo lekarza lub certyfikowanego trenera."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의학적 조언이 아니며 의사나 공인 코치를 대신하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "医療上の助言ではなく、医師や資格を持つコーチの代わりにはなりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此内容不是医疗建议，也不能替代医生或认证教练的指导。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此內容不是醫療建議，也不能取代醫師或認證教練的指導。"
          }
        }
      }
    },
