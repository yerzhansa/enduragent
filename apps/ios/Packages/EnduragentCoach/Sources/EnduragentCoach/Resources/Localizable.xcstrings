    },
    "training.ride.intervalsIntro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows recorded segments in order. Missing metrics stay unavailable, and no planned workout targets are inferred."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra los segmentos registrados en orden. Las métricas que faltan siguen sin estar disponibles y no se deducen objetivos de entrenamientos planificados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les segments enregistrés dans l’ordre. Les mesures manquantes restent indisponibles et aucune cible d’entraînement prévu n’est déduite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra i segmenti registrati in ordine. Le metriche mancanti restano non disponibili e non vengono dedotti obiettivi di allenamento programmati."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt aufgezeichnete Abschnitte in ihrer Reihenfolge. Fehlende Kennzahlen bleiben nicht verfügbar. Es werden keine geplanten Trainingsziele abgeleitet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont geregistreerde segmenten in volgorde. Ontbrekende meetwaarden blijven niet beschikbaar en er worden geen doelen voor geplande trainingen afgeleid."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser registrerede segmenter i rækkefølge. Manglende målinger forbliver utilgængelige, og der udledes ingen planlagte træningsmål."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar registrerade segment i ordning. Saknade mått förblir otillgängliga och inga mål från planerade träningspass härleds."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser registrerte segmenter i rekkefølge. Manglende måleverdier forblir utilgjengelige, og ingen mål for planlagte treningsøkter utledes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää tallennetut jaksot järjestyksessä. Puuttuvat mittarit pysyvät poissa, eikä suunniteltujen harjoitusten tavoitearvoja päätellä."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra os segmentos registados por ordem. As métricas em falta mantêm-se indisponíveis e não são inferidos objetivos de treinos planeados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra os segmentos registrados em ordem. Métricas ausentes permanecem indisponíveis, e nenhuma meta de treino planejado é deduzida."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje zarejestrowane odcinki w kolejności. Brakujące wskaźniki pozostają niedostępne. Docelowe wartości zaplanowanego treningu nie są wyznaczane."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록된 구간을 순서대로 표시합니다. 누락된 지표는 확인 불가로 유지되며, 예정된 워크아웃 목표를 추론하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録された区間を順に表示します。欠測指標は取得できないままとし、予定されたワークアウトの目標値は推定しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按顺序显示记录的片段。缺失指标保持不可用，不会推测计划训练课程的目标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依序顯示已記錄的區段。缺少的指標仍標示為無法取得，不會推測計畫訓練課表的目標。"
          }
        }
      }
    },
