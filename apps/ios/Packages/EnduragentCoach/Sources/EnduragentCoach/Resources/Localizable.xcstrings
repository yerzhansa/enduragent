    "settings.credentials.delete.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes it from %#@computer@ only. %#@product@ will stop using it if it is active. Your provider account is unchanged."
          },
