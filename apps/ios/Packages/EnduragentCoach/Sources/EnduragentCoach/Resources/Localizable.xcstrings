          "stringUnit": {
            "state": "translated",
            "value": "Vraag %#@botFather@ om een bot, kopieer het token en keer hier terug. %#@product@ leest en verifieert het token rechtstreeks van het klembord. Het token wordt nooit getoond."
          },
          "substitutions": {
            "botFather": {
              "argNum": 1,
              "formatSpecifier": "@"
            },
            "product": {
              "argNum": 2,
              "formatSpecifier": "@"
