    "settings.telegram.sender.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add only people you trust to use your coach and shared athlete data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade solo a personas en las que confíes para usar tu entrenador y los datos de deportista compartidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute uniquement des personnes à qui tu fais confiance pour utiliser ton coach et les données d’athlète partagées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi solo persone a cui affideresti l’uso del tuo coach e dei dati condivisi dell’atleta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge nur Personen hinzu, denen du die Nutzung deines Coaches und deiner gemeinsam genutzten Athletendaten anvertraust."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg alleen mensen toe die je vertrouwt met je coach en gedeelde atleetgegevens."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj kun personer, du stoler på til at bruge din træner og dine delte atletdata."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg bara till personer som du litar på kan använda din tränare och dina delade träningsdata."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg bare til personer du stoler på til å bruke treneren din og delte utøverdata."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää vain henkilöitä, joiden luotat käyttävän valmentajaasi ja yhteisiä urheilijatietoja."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona apenas pessoas em quem confias para usar o teu treinador e os dados de atleta partilhados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione apenas pessoas em quem você confia para usar seu treinador e os dados de atleta compartilhados."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodawaj tylko osoby, którym ufasz na tyle, by korzystały z twojego trenera i wspólnych danych sportowca."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코치와 공유 선수 데이터의 사용을 믿고 맡길 수 있는 사람만 추가하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コーチと共有アスリートデータの利用を信頼して任せられる人だけを追加してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请仅添加您信任的人，允许其使用教练和共享的运动员数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅新增您信任的人，讓他們使用教練與共用的運動員資料。"
          }
        }
      }
    },
