    "telegram.pairing.askOwner": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Otherwise: ask the bot owner to authorize your user ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no eres el propietario, pídele que autorice tu ID de usuario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinon, demande au propriétaire du bot d’autoriser ton identifiant utilisateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altrimenti, chiedi al proprietario del bot di autorizzare il tuo ID utente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andernfalls bitte den Bot-Besitzer, deine Nutzer-ID zu autorisieren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anders: vraag de eigenaar van de bot om je gebruikers-ID toegang te geven."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellers: bed bottens ejer om at godkende dit bruger-ID."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Annars kan du be botens ägare att ge ditt användar-ID åtkomst."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellers: be eieren av boten om å godkjenne bruker-ID-en din."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muussa tapauksessa pyydä botin omistajaa valtuuttamaan käyttäjätunnuksesi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Caso contrário, pede ao proprietário do bot que autorize o teu ID de utilizador."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caso contrário, peça ao proprietário do bot que autorize seu ID de usuário."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W przeciwnym razie poproś właściciela bota o przyznanie dostępu twojemu identyfikatorowi użytkownika."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "봇 소유자가 아니라면 소유자에게 사용자 ID를 허용해 달라고 요청하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "所有者でない場合は、ボットの所有者にユーザーIDの許可を依頼してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "否则，请联系机器人所有者授权此用户 ID。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "否則，請聯絡機器人擁有者授權此使用者 ID。"
          }
        }
      }
    },
