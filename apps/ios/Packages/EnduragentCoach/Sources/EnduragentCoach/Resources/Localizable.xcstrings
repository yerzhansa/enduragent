    "plan.view.ftpResolution.conflictingSourcesDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sources differ. The highest-precedence value is selected for this Draft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fuentes difieren. Se ha seleccionado el valor de mayor prioridad para este borrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sources diffèrent. La valeur de la source prioritaire est retenue pour ce brouillon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fonti differiscono. Per questa bozza è selezionato il valore con la priorità più alta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Quellen weichen voneinander ab. Der Wert mit der höchsten Priorität ist für diesen Entwurf ausgewählt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bronnen verschillen. De waarde uit de bron met de hoogste prioriteit is geselecteerd voor dit concept."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilderne er uenige. Værdien med højest prioritet er valgt til denne kladde."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Källorna skiljer sig åt. Värdet med högst prioritet väljs för det här utkastet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kildene er ulike. Verdien med høyest prioritet er valgt for dette utkastet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähteiden tiedot eroavat. Tähän luonnokseen valitaan ensisijaisen lähteen arvo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As fontes diferem. O valor com maior prioridade é selecionado para este rascunho."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fontes divergem. O valor da fonte de maior prioridade foi selecionado para este rascunho."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Źródła się różnią. Dla tej wersji roboczej wybrano wartość z najwyższym priorytetem."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출처별 값이 다릅니다. 이 초안에는 우선순위가 가장 높은 값이 선택됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参照元によって値が異なります。この下書きでは、優先順位が最も高い値を選択しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各来源数值不同。已为此草稿选择优先级最高的数值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
