          "substitutions": {
            "reply": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい会話を始めました。以前の会話は保管し、大切な情報は引き続き記憶しています。\n\n%#@reply@"
          },
          "substitutions": {
            "reply": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
