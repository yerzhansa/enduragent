    "coach.history.resetStepLimit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Started a fresh session - earlier conversation is archived, and I still have your key details in memory.\n\nI ran out of steps gathering data — ask me to continue and I'll pick up where I left off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "He iniciado una nueva sesión. La conversación anterior está archivada y conservo tus datos clave en la memoria.\n\nHe alcanzado el límite de pasos al recopilar datos. Pídeme que continúe y retomaré donde lo dejé."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’ai commencé une nouvelle conversation — la précédente est archivée, et je garde tes informations essentielles en mémoire.\n\nJ’ai atteint ma limite d’étapes en recueillant les données — demande-moi de continuer et je reprendrai là où je me suis arrêté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho iniziato una nuova sessione. La conversazione precedente è archiviata e ricordo ancora le tue informazioni principali.\n\nHo raggiunto il limite di passaggi durante la raccolta dei dati. Chiedimi di continuare e riprenderò da dove mi sono fermato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe ein neues Gespräch gestartet. Das bisherige Gespräch ist archiviert, und deine wichtigsten Angaben habe ich weiterhin im Gedächtnis.\n\nBeim Sammeln der Daten habe ich mein Schrittlimit erreicht. Bitte mich weiterzumachen, dann mache ich dort weiter, wo ich aufgehört habe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een nieuwe sessie gestart. Ons eerdere gesprek is gearchiveerd en ik heb je belangrijkste gegevens nog in mijn geheugen.\n\nIk heb het maximale aantal stappen bereikt bij het verzamelen van gegevens. Vraag me om door te gaan, dan pak ik het op waar ik gebleven was."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg har startet en ny samtale — den tidligere samtale er arkiveret, og jeg har stadig dine vigtigste oplysninger i hukommelsen.\n\nJeg nåede grænsen for antal trin, mens jeg hentede data — bed mig om at fortsætte, så tager jeg fat, hvor jeg slap."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag har startat en ny session. Det tidigare samtalet har arkiverats och jag har kvar dina viktigaste uppgifter i minnet.\n\nJag nådde gränsen för antal steg när jag samlade in data. Be mig fortsätta så tar jag vid där jag slutade."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg har startet en ny samtale — den forrige er arkivert, og jeg husker fortsatt de viktigste opplysningene om deg.\n\nJeg nådde grensen for antall steg mens jeg samlet data — be meg fortsette, så tar jeg opp tråden der jeg slapp."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloitin uuden keskustelun. Aiempi keskustelu on arkistoitu, ja muistan edelleen tärkeimmät tietosi.\n\nTietojen keräämiseen varatut vaiheet loppuivat. Pyydä minua jatkamaan, niin jatkan siitä, mihin jäin."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciei uma nova conversa. A anterior está arquivada e continuo a ter os teus dados principais na memória.\n\nAtingi o limite de passos ao reunir os dados. Pede-me para continuar e retomo de onde fiquei."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciei uma nova conversa. A anterior está arquivada e continuo com seus dados principais na memória.\n\nAtingi o limite de etapas ao reunir os dados. Peça para eu continuar e retomo de onde parei."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpocząłem nową sesję — wcześniejsza rozmowa jest w archiwum, a najważniejsze informacje o tobie nadal mam w pamięci.\n\nPodczas zbierania danych zabrakło mi kroków — poproś mnie o kontynuację, a wrócę do miejsca, w którym przerwałem."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 대화를 시작했습니다. 이전 대화는 보관했고, 중요한 정보는 계속 기억하고 있습니다.\n\n데이터를 모으다가 처리 단계 한도에 도달했습니다. 계속해 달라고 말씀하시면 멈춘 곳부터 이어가겠습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい会話を始めました。以前の会話は保管し、大切な情報は引き続き記憶しています。\n\nデータを集めている途中で処理ステップの上限に達しました。続けてほしいと伝えてもらえれば、中断したところから再開します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已开始新对话。之前的对话已归档，我仍记得重要信息。\n\n收集数据时已达到步骤上限。告诉我继续，我就会接着处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已開始新對話。先前的對話已封存，我仍記得重要資訊。\n\n收集資料時已達到步驟上限。告訴我繼續，我就會接著處理。"
          }
        }
      }
    },
