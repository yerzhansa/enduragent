    "settings.coach.error.credentialRequired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This provider needs a saved credential before it can coach you. Use the setup area above to add one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este proveedor necesita una credencial guardada para poder entrenarte. Usa el área de configuración de arriba para añadir una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fournisseur a besoin d’une donnée d’authentification enregistrée pour te coacher. Utilise la zone de configuration ci-dessus pour en ajouter une."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo fornitore richiede una credenziale salvata prima di poterti allenare. Usa l’area di configurazione qui sopra per aggiungerne una."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Anbieter benötigt gespeicherte Zugangsdaten, bevor er dich coachen kann. Füge sie im Einrichtungsbereich oben hinzu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze aanbieder heeft opgeslagen toegangsgegevens nodig om je te kunnen coachen. Voeg ze toe in het configuratiegedeelte hierboven."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne udbyder kræver gemte adgangsoplysninger for at kunne træne dig. Tilføj dem i opsætningsområdet ovenfor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här leverantören behöver sparade inloggningsuppgifter för att kunna träna dig. Lägg till dem i konfigurationen ovan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne leverandøren trenger lagrede tilgangsopplysninger før den kan veilede deg. Legg dem til i oppsettområdet ovenfor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä palveluntarjoaja tarvitsee tallennetun tunnistautumistiedon voidakseen valmentaa sinua. Lisää se yllä olevassa käyttöönotto-osiossa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este fornecedor precisa de uma credencial guardada para te orientar. Usa a área de configuração acima para adicionares uma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este provedor precisa de uma credencial salva para orientar seu treinamento. Use a área de configuração acima para adicionar uma."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten dostawca wymaga zapisanych danych dostępowych, zanim będzie mógł cię trenować. Dodaj je w sekcji konfiguracji powyżej."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 제공업체의 코칭을 사용하려면 인증 정보가 저장되어 있어야 합니다. 위의 설정 영역에서 추가하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロバイダーでコーチを利用するには、認証情報の保存が必要です。上のセットアップ欄で追加してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要先保存此服务商的凭据才能使用教练。请在上方的设置区域添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此供應商需要已儲存的憑證才能提供指導。請在上方的初始設定區新增。"
          }
        }
      }
    },
    "settings.coach.error.invalidInput": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That provider or model wasn’t accepted. Check the model name and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha aceptado ese proveedor o modelo. Comprueba el nombre del modelo e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fournisseur ou ce modèle n’a pas été accepté. Vérifie le nom du modèle et réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il fornitore o il modello non è stato accettato. Controlla il nome del modello e riprova."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Anbieter oder dieses Modell wurde nicht akzeptiert. Prüfe den Modellnamen und versuche es erneut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aanbieder of dat model is niet geaccepteerd. Controleer de modelnaam en probeer het opnieuw."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udbyderen eller modellen blev ikke accepteret. Kontrollér modelnavnet, og prøv igen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Leverantören eller modellen godkändes inte. Kontrollera modellnamnet och försök igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne leverandøren eller modellen ble ikke godtatt. Sjekk modellnavnet og prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palveluntarjoajaa tai mallia ei hyväksytty. Tarkista mallin nimi ja yritä uudelleen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse fornecedor ou modelo não foi aceite. Verifica o nome do modelo e tenta novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse provedor ou modelo não foi aceito. Confira o nome do modelo e tente novamente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten dostawca lub model nie został zaakceptowany. Sprawdź nazwę modelu i spróbuj ponownie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 제공업체 또는 모델이 허용되지 않았습니다. 모델 이름을 확인하고 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのプロバイダーまたはモデルは受け付けられませんでした。モデル名を確認して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商或模型未被接受。请检查模型名称后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未接受此供應商或模型。請檢查模型名稱後重試。"
          }
        }
      }
    },
    "settings.coach.error.requestFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coach settings couldn’t be saved right now. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido guardar los ajustes del entrenador ahora. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paramètres du coach n’ont pas pu être enregistrés pour le moment. Réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare le impostazioni del coach al momento. Riprova."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Coach-Einstellungen konnten gerade nicht gespeichert werden. Versuche es erneut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coachinstellingen konden nu niet worden opgeslagen. Probeer het opnieuw."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Trænerindstillingerne kunne ikke gemmes lige nu. Prøv igen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tränarinställningarna kunde inte sparas just nu. Försök igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenerinnstillingene kunne ikke lagres akkurat nå. Prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valmentajan asetuksia ei voitu juuri nyt tallentaa. Yritä uudelleen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar as definições do treinador agora. Tenta novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar as configurações do treinador agora. Tente novamente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można teraz zapisać ustawień trenera. Spróbuj ponownie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 코치 설정을 저장할 수 없습니다. 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、コーチ設定を保存できません。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法保存教练设置。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法儲存教練設定。請重試。"
          }
        }
      }
    },
