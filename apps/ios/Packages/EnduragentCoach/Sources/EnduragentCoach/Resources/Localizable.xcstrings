        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het opschonen van het oude schema is gecontroleerd voordat het vervangende schema naar de agenda werd geschreven."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprydningen af den gamle træningsplan blev bekræftet, før erstatningen blev synkroniseret til kalenderen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rensningen av den gamla planen verifierades innan den nya planens kalenderkopia skrevs."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppryddingen etter den gamle planen ble bekreftet før erstatningsplanen ble overført til kalenderen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vanhan kalenterin siivous vahvistettiin ennen korvaavan suunnitelman kalenterikopion kirjoittamista."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
