    "training.power.rotation.balanced": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short and long efforts changed at a similar rate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los esfuerzos cortos y largos cambiaron a un ritmo similar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les efforts courts et longs ont évolué à un rythme similaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli sforzi brevi e lunghi sono cambiati in misura simile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurze und lange Belastungen haben sich ähnlich stark verändert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Korte en lange inspanningen veranderden in vergelijkbare mate."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Korte og lange præstationer ændrede sig i omtrent samme takt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Korta och långa insatser förändrades i ungefär samma takt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Korte og lange prestasjoner endret seg i omtrent samme takt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyhyet ja pitkät suoritukset muuttuivat samaan tahtiin."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os esforços curtos e longos mudaram a um ritmo semelhante."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os esforços curtos e longos mudaram em proporções semelhantes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krótkie i długie wysiłki zmieniły się w podobnym tempie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단시간 및 장시간 기록이 비슷한 비율로 변했습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短時間と長時間の記録は、同程度の割合で変化しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短时和长时功率表现的变化幅度相近。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "短時間與長時間表現的變化幅度相近。"
          }
        }
      }
    },
    "training.power.rotation.endurance": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long efforts changed more favorably than short efforts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los esfuerzos largos evolucionaron de forma más favorable que los cortos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les efforts longs ont évolué plus favorablement que les efforts courts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli sforzi lunghi sono cambiati più favorevolmente di quelli brevi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lange Belastungen haben sich günstiger entwickelt als kurze."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lange inspanningen ontwikkelden zich gunstiger dan korte inspanningen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lange præstationer udviklede sig mere positivt end korte præstationer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Långa insatser utvecklades mer gynnsamt än korta insatser."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lange prestasjoner utviklet seg mer positivt enn korte prestasjoner."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitkät suoritukset muuttuivat suotuisammin kuin lyhyet."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os esforços longos evoluíram mais favoravelmente do que os curtos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os esforços longos mudaram de forma mais favorável que os curtos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Długie wysiłki zmieniły się korzystniej niż krótkie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장시간 기록이 단시간 기록보다 더 긍정적으로 변했습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長時間の記録は、短時間の記録よりも良好な変化を示しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长时功率表现的变化比短时更有利。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長時間表現的變化優於短時間表現。"
          }
        }
      }
    },
