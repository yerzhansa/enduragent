    "setup.ai.apiKeyHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Created in the provider's console, billed per use — usually cents per conversation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se crea en la consola del proveedor y se factura por uso, normalmente unos céntimos por conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créée dans la console du fournisseur, facturée à l’usage — généralement quelques centimes par conversation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creata nella console del fornitore, con addebito in base all’uso, di solito pochi centesimi per conversazione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird in der Konsole des Anbieters erstellt und nach Nutzung abgerechnet — meist Centbeträge pro Gespräch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aangemaakt in de console van de aanbieder, afgerekend per gebruik. Meestal enkele centen per gesprek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprettes i udbyderens konsol og afregnes efter forbrug. Normalt få cent pr. samtale."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapas i leverantörens konsol och debiteras efter användning, vanligtvis några cent per samtal."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opprettes i leverandørens konsoll og faktureres etter bruk, vanligvis noen få amerikanske cent per samtale."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luodaan palveluntarjoajan hallintapaneelissa, laskutetaan käytön mukaan. Yleensä muutamia senttejä keskustelulta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Criada na consola do fornecedor, com cobrança por utilização, normalmente cêntimos por conversa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Criada no console do provedor, com cobrança por uso — geralmente centavos por conversa."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tworzony w konsoli dostawcy, opłaty za użycie — zwykle kilka centów za rozmowę."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공업체 콘솔에서 생성하며 사용량에 따라 청구됩니다. 보통 대화당 몇 센트입니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダーの管理画面で作成します。従量課金で、通常は1回の会話につき数セントです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在服务商控制台创建，按用量计费，通常每次对话花费几美分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在供應商控制台建立，依用量計費；每次對話通常只需幾美分。"
          }
        }
      }
    },
