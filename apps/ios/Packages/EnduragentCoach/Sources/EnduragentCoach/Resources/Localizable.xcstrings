              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@product@ kon niet stoppen met het gebruik van alle actieve toegangsgegevens. Probeer het opnieuw om het verwijderen af te ronden."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@product@ kunne ikke stoppe brugen af alle aktive adgangsoplysninger. Prøv igen for at afslutte fjernelsen."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@product@ kunde inte sluta använda alla aktiva inloggningsuppgifter. Försök igen för att slutföra borttagningen."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@product@ kunne ikke stoppe bruken av alle aktive tilgangsopplysninger. Prøv igjen for å fullføre fjerningen."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@product@ ei voinut lopettaa kaikkien käytössä olevien tunnistautumistietojen käyttöä. Viimeistele poisto yrittämällä uudelleen."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@product@ não conseguiu parar a utilização de todas as credenciais ativas. Tenta novamente para terminares a remoção das credenciais."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@product@ não conseguiu interromper o uso de todas as credenciais ativas. Tente novamente para concluir a remoção."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@product@ nie mógł zatrzymać korzystania ze wszystkich aktywnych danych dostępowych. Spróbuj ponownie, aby dokończyć usuwanie."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@product@에서 활성 인증 정보의 사용을 모두 중단하지 못했습니다. 다시 시도하여 인증 정보 삭제를 완료하세요."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@product@は使用中の認証情報をすべて停止できませんでした。再試行して認証情報の削除を完了してください。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@product@ 无法停止使用全部已启用的凭据。请重试以完成移除。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@product@ 無法停用所有已啟用的憑證。請重試以完成移除。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        }
      }
    },
    "settings.credentials.feedback.reset.unverified": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Credential removal could not be verified because Settings could not reload. Reconnect and reload."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido verificar la eliminación de credenciales porque no se ha podido volver a cargar Ajustes. Vuelve a conectar y recarga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression des données d’authentification n’a pas pu être vérifiée, car les Paramètres n’ont pas pu être rechargés. Reconnecte et recharge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare la rimozione delle credenziali perché le Impostazioni non sono state ricaricate. Riconnetti e ricarica."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Entfernen der Zugangsdaten konnte nicht überprüft werden, weil die Einstellungen nicht neu geladen werden konnten. Verbinde dich erneut und lade neu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het verwijderen van toegangsgegevens kon niet worden geverifieerd omdat Instellingen niet opnieuw kon worden geladen. Maak opnieuw verbinding en laad opnieuw."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjernelsen af adgangsoplysninger kunne ikke bekræftes, fordi Indstillinger ikke kunne genindlæses. Opret forbindelse igen, og genindlæs."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Borttagningen av inloggningsuppgifter kunde inte verifieras eftersom Inställningar inte kunde läsas in igen. Anslut på nytt och läs in igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerning av tilgangsopplysninger kunne ikke bekreftes fordi Innstillinger ikke kunne lastes inn på nytt. Koble til og last inn på nytt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunnistautumistietojen poistoa ei voitu varmistaa, koska asetuksia ei voitu ladata uudelleen. Yhdistä ja lataa uudelleen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar a remoção das credenciais porque não foi possível recarregar as Definições. Volta a ligar e a carregar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar a remoção das credenciais porque Configurações não pôde ser recarregado. Reconecte e recarregue."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zweryfikować usunięcia danych dostępowych, ponieważ nie można ponownie wczytać Ustawień. Połącz ponownie i odśwież dane."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정을 다시 불러오지 못해 인증 정보 삭제 여부를 확인할 수 없습니다. 다시 연결하고 새로고침하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を再読み込みできなかったため、認証情報の削除を確認できませんでした。再接続して再読み込みしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法重新加载设置，因此无法验证凭据是否已移除。请重新连接并加载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法重新載入「設定」，因此無法驗證憑證是否已移除。請重新連線並重新載入。"
          }
        }
      }
    },
    "settings.credentials.feedback.unavailable": {
      "localizations": {
        "en": {
