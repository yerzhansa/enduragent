    "chat.newConversation.attachmentDraft": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your visible conversation and unsent attachment draft will be cleared. Your training data and saved coach memory will remain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borrarán la conversación visible y el borrador de adjuntos sin enviar. Se conservarán tus datos de entrenamiento y la memoria guardada del entrenador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta conversation visible et ton brouillon de pièces jointes non envoyé seront effacés. Tes données d’entraînement et la mémoire enregistrée du coach seront conservées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversazione visibile e la bozza con allegati non inviata verranno cancellate. I dati di allenamento e la memoria salvata del coach rimarranno."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein sichtbares Gespräch und der Entwurf mit ungesendeten Anhängen werden gelöscht. Deine Trainingsdaten und die gespeicherten Erinnerungen des Coaches bleiben erhalten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je zichtbare gesprek en je onverzonden concept met bijlage worden gewist. Je trainingsgegevens en het opgeslagen coachgeheugen blijven bewaard."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din synlige samtale og din kladde med en vedhæftet fil, som ikke er sendt, bliver ryddet. Dine træningsdata og trænerens gemte hukommelse bliver bevaret."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt synliga samtal och ditt oskickade utkast med bilagor rensas. Dina träningsdata och tränarens sparade minne finns kvar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den synlige samtalen og utkastet med vedlegg som ikke er sendt, tømmes. Treningsdata og trenerens lagrede hukommelse beholdes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näkyvä keskustelusi ja lähettämätön liiteluonnos tyhjennetään. Harjoitustietosi ja valmentajan tallennettu muisti säilyvät."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A conversa visível e o rascunho de anexos por enviar serão limpos. Os teus dados de treino e a memória guardada do treinador mantêm-se."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conversa visível e o rascunho de anexos não enviados serão limpos. Seus dados de treinamento e a memória salva do treinador serão preservados."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Widoczna rozmowa i niewysłany załącznik w wersji roboczej zostaną usunięte. Twoje dane treningowe i zapisana pamięć trenera pozostaną."
          }
        },
        "ko": {
