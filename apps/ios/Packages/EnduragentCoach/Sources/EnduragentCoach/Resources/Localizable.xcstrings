    "setup.error.runtimeUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That key was saved, but it is not active yet. Choose Retry saved keys to activate it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha guardado esa clave, pero aún no está activa. Elige Reintentar claves guardadas para activarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette clé a été enregistrée, mais elle n’est pas encore active. Choisis Réessayer les clés enregistrées pour l’activer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
