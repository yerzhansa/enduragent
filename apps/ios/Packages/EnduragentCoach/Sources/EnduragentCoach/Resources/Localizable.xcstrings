          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keskusteluasetuksia ei voitu tallentaa. Muutoksesi ovat yhä tässä."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
