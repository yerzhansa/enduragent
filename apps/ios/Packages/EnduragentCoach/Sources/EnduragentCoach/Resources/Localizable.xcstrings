    "chat.planCreation.pendingCommitment": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your last confirmed limits remain effective. Draft building and activation wait for this correction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus últimos límites confirmados siguen vigentes. La creación del borrador y la activación esperan a esta corrección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes dernières limites confirmées restent en vigueur. La création du brouillon et l’activation attendent cette correction."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli ultimi limiti confermati restano validi. La creazione della bozza e l’attivazione attendono questa correzione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine zuletzt bestätigten Limits gelten weiterhin. Die Erstellung und Aktivierung des Entwurfs warten auf diese Korrektur."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je laatst bevestigde limieten blijven gelden. Het maken en activeren van het concept wachten op deze correctie."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine senest bekræftede grænser gælder stadig. Oprettelse af kladden og aktivering afventer denne rettelse."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina senast bekräftade gränser gäller fortfarande. Utkastet kan skapas och aktiveras först när korrigeringen är klar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De sist bekreftede grensene dine gjelder fortsatt. Oppretting av utkast og aktivering venter på denne korrigeringen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeksi vahvistamasi rajat pysyvät voimassa. Luonnoksen luonti ja aktivointi odottavat tätä korjausta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os últimos limites que confirmaste mantêm-se em vigor. A criação do rascunho e a ativação aguardam esta correção."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os últimos limites que você confirmou continuam em vigor. A criação do rascunho e a ativação aguardam esta correção."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnie potwierdzone limity pozostają w mocy. Tworzenie wersji roboczej i aktywacja czekają na tę korektę."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막으로 확인한 제한은 계속 적용됩니다. 이 수정을 완료할 때까지 초안 생성과 활성화가 대기합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後に確定した制限は引き続き有効です。この修正が終わるまで、下書きの作成と有効化は保留されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次确认的限制仍然有效。完成此修正后才能生成草稿和启用计划。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上次確認的限制仍然有效。完成此修正後才能產生草稿與啟用計畫。"
          }
        }
      }
    },
