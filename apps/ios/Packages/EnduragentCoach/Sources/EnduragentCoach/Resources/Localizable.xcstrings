    "settings.telegram.pairing.storageFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The primary %#@telegram@ user could not be saved. Check local disk access and try pairing again."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar el usuario principal de %#@telegram@. Comprueba el acceso al disco local e intenta vincular de nuevo."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’utilisateur principal de %#@telegram@ n’a pas pu être enregistré. Vérifie l’accès au disque local et réessaie l’association."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare l’utente %#@telegram@ principale. Controlla l’accesso al disco locale e riprova l’abbinamento."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hauptnutzer von %#@telegram@ konnte nicht gespeichert werden. Prüfe den Zugriff auf den lokalen Datenträger und versuche die Kopplung erneut."
          },
          "substitutions": {
            "telegram": {
              "argNum": 1,
              "formatSpecifier": "@"
