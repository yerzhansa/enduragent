    "chat.notice.attachmentFailure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn’t update that attachment. Your message draft is preserved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo actualizar ese adjunto. Se conserva el borrador de tu mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette pièce jointe n’a pas pu être mise à jour. Ton brouillon de message est conservé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aggiornare l’allegato. La bozza del messaggio è conservata."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Anhang konnte nicht aktualisiert werden. Dein Nachrichtenentwurf bleibt erhalten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die bijlage kon niet worden bijgewerkt. Je conceptbericht blijft bewaard."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke opdatere den vedhæftede fil. Din beskedkladde bliver bevaret."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilagan kunde inte uppdateras. Ditt meddelandeutkast finns kvar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke oppdatere vedlegget. Meldingsutkastet ditt er bevart."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liitettä ei voitu päivittää. Viestiluonnoksesi säilyy."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível atualizar esse anexo. O rascunho da tua mensagem mantém-se."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível atualizar esse anexo. O rascunho da sua mensagem foi preservado."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zaktualizować tego załącznika. Twoja wersja robocza wiadomości została zachowana."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첨부 파일을 업데이트하지 못했습니다. 메시지 초안은 유지됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "添付ファイルを更新できませんでした。メッセージの下書きは残っています。"
          }
        },
        "zh-Hans": {
