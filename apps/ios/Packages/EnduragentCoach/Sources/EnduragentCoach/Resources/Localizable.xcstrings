    "chat.planChange.paused": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan Changes are paused because synchronized training is older than %#@hours@ hours. Refresh the connection, then request a fresh preview."
          },
          "substitutions": {
            "hours": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios del plan están en pausa porque los datos de entrenamiento se sincronizaron hace más de %#@hours@ horas. Actualiza la conexión y solicita una nueva vista previa."
          },
          "substitutions": {
            "hours": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications du plan sont en pause, car les données d’entraînement synchronisées datent de plus de %#@hours@ heures. Actualise la connexion, puis demande un nouvel aperçu."
          },
          "substitutions": {
            "hours": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche al piano sono in pausa perché i dati di allenamento sincronizzati risalgono a più di %#@hours@ ore fa. Aggiorna la connessione, poi richiedi una nuova anteprima."
          },
          "substitutions": {
            "hours": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Planänderungen sind pausiert, weil die synchronisierten Trainingsdaten älter als %#@hours@ Stunden sind. Aktualisiere die Verbindung und fordere dann eine neue Vorschau an."
          },
          "substitutions": {
            "hours": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigingen aan het trainingsschema zijn gepauzeerd omdat de gesynchroniseerde trainingsgegevens ouder zijn dan %#@hours@ uur. Vernieuw de verbinding en vraag daarna een nieuw wijzigingsvoorbeeld aan."
          },
          "substitutions": {
            "hours": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ændringer af træningsplanen er sat på pause, fordi de synkroniserede træningsdata er over %#@hours@ timer gamle. Opdatér forbindelsen, og bed derefter om en ny forhåndsvisning."
          },
          "substitutions": {
            "hours": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Planändringar är pausade eftersom de synkroniserade träningsuppgifterna är äldre än %#@hours@ timmar. Uppdatera anslutningen och begär sedan en ny förhandsgranskning."
          },
          "substitutions": {
            "hours": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Planendringer er satt på pause fordi den synkroniserte treningen er eldre enn %#@hours@ timer. Oppdater tilkoblingen, og be deretter om en ny forhåndsvisning."
          },
          "substitutions": {
            "hours": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suunnitelman muutokset on keskeytetty, koska synkronoidut harjoitustiedot ovat yli %#@hours@ tuntia vanhoja. Päivitä yhteys ja pyydä sitten uusi esikatselu."
          },
          "substitutions": {
            "hours": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações ao plano estão em pausa porque os dados de treino sincronizados têm mais de %#@hours@ horas. Atualiza a ligação e pede uma nova pré-visualização."
          },
          "substitutions": {
            "hours": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações ao plano estão em pausa porque os dados de treinamento sincronizados têm mais de %#@hours@ horas. Atualize a conexão e peça uma nova prévia."
          },
          "substitutions": {
            "hours": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany planu są wstrzymane, ponieważ zsynchronizowane dane treningowe mają ponad %#@hours@ godz. Odśwież połączenie, a potem poproś o nowy podgląd."
          },
          "substitutions": {
            "hours": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화된 훈련 데이터가 %#@hours@시간 이상 지나 계획 변경이 일시 중지되었습니다. 연결을 새로고침한 후 새 미리보기를 요청하세요."
          },
          "substitutions": {
            "hours": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期されたトレーニングデータが%#@hours@時間以上前のため、プランの変更を一時停止しています。接続を更新してから、新しいプレビューを取得してください。"
