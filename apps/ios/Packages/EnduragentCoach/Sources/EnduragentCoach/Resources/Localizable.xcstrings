    "desktop.lifecycle.unexpectedContent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@product@ hit an unexpected problem while starting. Quit %#@product@ and try again. If it keeps happening, log out and back in before reopening it."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@product@ encontró un problema inesperado al iniciarse. Cierra %#@product@ y vuelve a intentarlo. Si sigue ocurriendo, cierra sesión y vuelve a iniciarla antes de abrirlo de nuevo."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@product@ a rencontré un problème inattendu au démarrage. Quitte %#@product@ et réessaie. Si le problème persiste, ferme ta session et reconnecte-toi avant de le rouvrir."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@product@ ha riscontrato un problema imprevisto all'avvio. Chiudi %#@product@ e riprova. Se il problema persiste, esci dalla sessione e accedi di nuovo prima di riaprirlo."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Starten von %#@product@ ist ein unerwartetes Problem aufgetreten. Beende %#@product@ und versuche es erneut. Wenn das Problem weiterhin auftritt, melde dich ab und wieder an, bevor du es erneut öffnest."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een onverwacht probleem opgetreden bij het starten van %#@product@. Sluit %#@product@ af en probeer het opnieuw. Blijft dit gebeuren, log dan uit en weer in voordat je het opnieuw opent."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@product@ stødte på et uventet problem under opstart. Afslut %#@product@, og prøv igen. Hvis det bliver ved med at ske, så log ud og ind igen, før du åbner det igen."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@product@ stötte på ett oväntat problem vid start. Avsluta %#@product@ och försök igen. Om det fortsätter att hända, logga ut och in igen innan du öppnar det på nytt."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@product@ støtte på et uventet problem under oppstart. Avslutt %#@product@, og prøv igjen. Hvis det fortsetter å skje, logger du ut og inn igjen før du åpner det på nytt."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@product@ kohtasi odottamattoman ongelman käynnistyessään. Lopeta %#@product@ ja yritä uudelleen. Jos ongelma toistuu, kirjaudu ulos ja takaisin sisään ennen kuin avaat sovelluksen uudelleen."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@product@ encontrou um problema inesperado ao iniciar. Encerra %#@product@ e tenta novamente. Se o problema se repetir, termina sessão e volta a iniciá-la antes de voltares a abrir a aplicação."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@product@ encontrou um problema inesperado ao iniciar. Encerre %#@product@ e tente novamente. Se o problema se repetir, saia da sessão e entre novamente antes de reabrir o aplicativo."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas uruchamiania %#@product@ wystąpił nieoczekiwany problem. Zamknij %#@product@ i spróbuj ponownie. Jeśli problem się powtarza, wyloguj się i zaloguj ponownie przed kolejnym otwarciem aplikacji."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@product@을(를) 시작하는 중에 예기치 않은 문제가 발생했습니다. %#@product@을(를) 종료하고 다시 시도하세요. 계속 발생하면 로그아웃한 후 다시 로그인하고 앱을 다시 여세요."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@product@の起動中に予期しない問題が発生しました。%#@product@を終了して、もう一度お試しください。繰り返し発生する場合は、ログアウトしてからログインし直し、アプリを開き直してください。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@product@ 启动时遇到了意外问题。请退出 %#@product@ 后重试。如果问题反复出现，请注销并重新登录，再重新打开应用。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@product@ 啟動時遇到非預期的問題。請結束 %#@product@ 後再試。若問題反覆發生，請登出並重新登入，再重新開啟應用程式。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        }
      }
    },
