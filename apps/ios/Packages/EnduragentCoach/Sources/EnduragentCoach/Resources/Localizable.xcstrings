    "training.response.heartRateDistributionIntro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows how much measured ride time fell inside each recorded heart-rate range. It can load even when power data is unavailable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra cuánto tiempo medido de la salida corresponde a cada rango de frecuencia cardiaca registrado. Se puede cargar aunque no haya datos de potencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique le temps de sortie mesuré dans chaque plage de fréquence cardiaque enregistrée. Peut être chargé même sans données de puissance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra quanto tempo misurato in sella rientra in ciascun intervallo di frequenza cardiaca registrato. Può caricarsi anche quando i dati di potenza non sono disponibili."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt, wie viel gemessene Fahrzeit in den jeweiligen aufgezeichneten Herzfrequenzbereich fällt. Kann auch ohne Leistungsdaten geladen werden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont hoeveel gemeten rijtijd binnen elk geregistreerd hartslagbereik viel. Dit kan ook worden geladen als vermogensgegevens ontbreken."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser, hvor meget målt køretid der lå inden for hvert registreret pulsinterval. Kan indlæses, selvom effektdata er utilgængelige."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar hur mycket av den uppmätta cykeltiden som låg inom varje registrerat pulsintervall. Kan läsas in även när effektdata saknas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser hvor mye av den målte turtiden som falt innenfor hvert registrerte pulsintervall. Kan lastes inn selv når wattdata er utilgjengelige."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää, kuinka paljon mitattua ajoaikaa osui kuhunkin tallennettuun sykeväliin. Se voi latautua, vaikka tehotietoja ei ole saatavilla."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra quanto tempo medido da volta ficou dentro de cada intervalo de frequência cardíaca registado. Pode carregar mesmo sem dados de potência disponíveis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra quanto tempo medido da pedalada ficou em cada faixa de frequência cardíaca registrada. Pode carregar mesmo quando os dados de potência estão indisponíveis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje, ile zmierzonego czasu jazdy przypada na każdy zarejestrowany zakres tętna. Może się wczytać nawet bez danych mocy."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록된 각 심박수 범위에서 측정된 라이딩 시간을 표시합니다. 파워 데이터가 없어도 불러올 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録された各心拍数の範囲に含まれる測定ライド時間を表示します。パワーデータがなくても読み込めます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示各记录心率范围内的实测骑行时间。即使功率数据不可用，也可加载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示各記錄心率範圍內的實測騎乘時間。即使沒有功率資料，仍可載入。"
          }
        }
      }
    },
