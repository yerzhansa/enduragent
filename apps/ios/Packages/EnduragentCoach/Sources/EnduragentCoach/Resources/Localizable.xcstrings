    "desktop.lifecycle.versionMismatchContent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A different version of the %#@product@ background service is running from the CLI or a previous install. Quit that service, then reopen %#@product@."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay otra versión del servicio en segundo plano de %#@product@ en ejecución desde la CLI o una instalación anterior. Cierra ese servicio y vuelve a abrir %#@product@."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre version du service en arrière-plan de %#@product@ est en cours d'exécution, lancée depuis la ligne de commande ou une installation précédente. Arrête ce service, puis rouvre %#@product@."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È in esecuzione una versione diversa del servizio in background di %#@product@, avviata dalla CLI o da un'installazione precedente. Termina quel servizio, poi riapri %#@product@."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere Version des Hintergrunddienstes von %#@product@ läuft bereits. Sie wurde über die CLI oder eine frühere Installation gestartet. Beende diesen Dienst und öffne %#@product@ erneut."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een andere versie van de achtergrondservice van %#@product@ actief vanuit de CLI of een eerdere installatie. Sluit die service af en open %#@product@ opnieuw."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En anden version af baggrundstjenesten til %#@product@ kører fra CLI eller en tidligere installation. Afslut den tjeneste, og åbn derefter %#@product@ igen."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En annan version av bakgrundstjänsten för %#@product@ körs från CLI eller en tidigare installation. Avsluta den tjänsten och öppna sedan %#@product@ igen."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En annen versjon av bakgrunnstjenesten til %#@product@ kjører fra CLI eller en tidligere installasjon. Avslutt den tjenesten, og åpne deretter %#@product@ på nytt."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovelluksen %#@product@ taustapalvelun eri versio on käynnissä komentoriviltä tai aiemmasta asennuksesta. Lopeta kyseinen palvelu ja avaa sitten %#@product@ uudelleen."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Está em execução uma versão diferente do serviço em segundo plano de %#@product@, iniciada pela linha de comandos ou por uma instalação anterior. Para esse serviço e volta a abrir %#@product@."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma versão diferente do serviço em segundo plano de %#@product@ está em execução, iniciada pela linha de comando ou por uma instalação anterior. Encerre esse serviço e reabra %#@product@."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa inna wersja usługi %#@product@ w tle, uruchomiona z wiersza poleceń lub wcześniejszej instalacji. Zatrzymaj tę usługę, a następnie otwórz ponownie %#@product@."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI 또는 이전 설치에서 다른 버전의 %#@product@ 백그라운드 서비스가 실행 중입니다. 해당 서비스를 종료한 후 %#@product@을(를) 다시 여세요."
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CLIまたは以前のインストールから、別のバージョンの%#@product@のバックグラウンドサービスが実行されています。そのサービスを終了してから、%#@product@を開き直してください。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI 或先前的安装正在运行另一个版本的 %#@product@ 后台服务。请退出该服务，再重新打开 %#@product@。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI 或先前的安裝正在執行另一個版本的 %#@product@ 背景服務。請結束該服務，再重新開啟 %#@product@。"
          },
          "substitutions": {
            "product": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        }
      }
    },
