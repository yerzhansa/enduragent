    "settings.telegram.feedback.failure.webhook": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The webhook could not be removed. Check the internet connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido eliminar el webhook. Comprueba la conexión a internet e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le webhook n’a pas pu être supprimé. Vérifie la connexion Internet et réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile rimuovere il webhook. Controlla la connessione Internet e riprova."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Webhook konnte nicht entfernt werden. Prüfe die Internetverbindung und versuche es erneut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De webhook kon niet worden verwijderd. Controleer de internetverbinding en probeer het opnieuw."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Webhooken kunne ikke fjernes. Kontrollér internetforbindelsen, og prøv igen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Webhooken kunde inte tas bort. Kontrollera internetanslutningen och försök igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Webhooken kunne ikke fjernes. Sjekk internettforbindelsen og prøv igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Webhookia ei voitu poistaa. Tarkista internetyhteys ja yritä uudelleen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível remover o webhook. Verifica a ligação à Internet e tenta novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível remover o webhook. Confira a conexão com a internet e tente novamente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się usunąć webhooka. Sprawdź połączenie z internetem i spróbuj ponownie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹훅을 삭제하지 못했습니다. 인터넷 연결을 확인하고 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Webhookを削除できませんでした。インターネット接続を確認して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法移除 webhook。请检查网络连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法移除 webhook。請檢查網路連線後重試。"
          }
        }
      }
    },
    "settings.telegram.feedback.failure.webhookRemovalRequired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The copied bot still uses a webhook. Remove the webhook, then delete the current connection and connect this bot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bot cuyo token has copiado sigue usando un webhook. Elimina el webhook, elimina la conexión actual y conecta este bot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bot dont tu as copié le jeton utilise encore un webhook. Supprime le webhook, puis supprime la connexion actuelle et connecte ce bot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bot di cui hai copiato il token usa ancora un webhook. Rimuovi il webhook, poi elimina la connessione attuale e collega questo bot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bot zum kopierten Token verwendet noch einen Webhook. Entferne den Webhook, lösche dann die aktuelle Verbindung und verbinde diesen Bot."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bot van het gekopieerde token gebruikt nog een webhook. Verwijder de webhook, verwijder daarna de huidige verbinding en verbind deze bot."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Botten fra det kopierede token bruger stadig en webhook. Fjern webhooken, slet derefter den aktuelle forbindelse, og forbind denne bot."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Boten vars token du kopierade använder fortfarande en webhook. Ta bort webhooken, ta sedan bort den nuvarande anslutningen och anslut den här boten."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Boten du kopierte tokenet fra, bruker fortsatt en webhook. Fjern webhooken, slett den nåværende tilkoblingen og koble til denne boten."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopioitua tunnistetta käyttävä botti käyttää yhä webhookia. Poista webhook, poista sitten nykyinen yhteys ja yhdistä tämä botti."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O bot cujo token copiaste ainda usa um webhook. Remove o webhook, elimina a ligação atual e liga este bot."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O bot copiado ainda usa um webhook. Remova o webhook, exclua a conexão atual e conecte este bot."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot ze skopiowanego tokena nadal używa webhooka. Usuń webhook, a następnie usuń bieżące połączenie i połącz tego bota."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "토큰을 복사한 봇이 아직 웹훅을 사용하고 있습니다. 웹훅을 삭제한 후 현재 연결을 삭제하고 이 봇을 연결하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーしたトークンのボットはまだWebhookを使用しています。Webhookを削除し、現在の接続を削除してから、このボットを接続してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制令牌所对应的机器人仍在使用 webhook。请先移除 webhook，再删除当前连接并连接此机器人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製權杖所屬的機器人仍在使用 webhook。請移除 webhook，再刪除目前的連線並連結此機器人。"
          }
        }
      }
    },
    "settings.telegram.feedback.health.conflict": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another service is polling this bot. Stop that deployment, then check again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro servicio está consultando este bot. Detén esa instancia y comprueba de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre service interroge ce bot. Arrête ce déploiement, puis vérifie à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro servizio sta interrogando questo bot. Arresta quell’istanza, poi controlla di nuovo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Dienst ruft Nachrichten dieses Bots ab. Beende diese Installation und prüfe dann erneut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een andere service vraagt deze bot al om updates. Stop die implementatie en controleer opnieuw."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En anden tjeneste henter opdateringer fra denne bot. Stop den installation, og kontrollér igen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En annan tjänst hämtar meddelanden för den här boten. Stoppa den installationen och kontrollera sedan igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En annen tjeneste henter meldinger fra denne boten. Stopp den instansen, og sjekk igjen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toinen palvelu hakee tämän botin viestejä. Pysäytä kyseinen palvelinasennus ja tarkista sitten uudelleen."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro serviço está a consultar este bot. Para essa instalação e verifica novamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro serviço está consultando este bot. Interrompa esse serviço e verifique novamente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inna usługa odpytuje tego bota. Zatrzymaj tę instancję i sprawdź ponownie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 서비스에서 이 봇을 폴링하고 있습니다. 해당 배포 환경에서 중지한 후 다시 확인하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のサービスがこのボットをポーリングしています。そちらの稼働環境で停止してから再確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他服务正在轮询此机器人。请先停止该部署，再重新检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一個服務正在輪詢此機器人。請停止該部署後再次檢查。"
