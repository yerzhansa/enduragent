    "chat.planCreation.replaceDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@name@ closes. Today’s calendar Workout stays. The new Plan activates now."
          },
          "substitutions": {
            "name": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@name@ se cierra. El entrenamiento de hoy en el calendario se mantiene. El nuevo plan se activa ahora."
          },
          "substitutions": {
            "name": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@name@ se termine. L’entraînement du calendrier prévu aujourd’hui est conservé. Le nouveau plan s’active maintenant."
          },
          "substitutions": {
            "name": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@name@ viene chiuso. L’allenamento di oggi nel calendario rimane. Il nuovo piano si attiva ora."
          },
          "substitutions": {
            "name": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@name@ wird abgeschlossen. Das heutige Training im Kalender bleibt. Der neue Plan wird jetzt aktiviert."
          },
          "substitutions": {
            "name": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@name@ wordt afgesloten. De kalendertraining van vandaag blijft staan. Het nieuwe trainingsschema wordt nu actief."
          },
          "substitutions": {
            "name": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@name@ afsluttes. Dagens træning i kalenderen bliver bevaret. Den nye træningsplan bliver aktiv nu."
          },
          "substitutions": {
            "name": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@name@ avslutas. Dagens träningspass i kalendern finns kvar. Den nya planen aktiveras nu."
          },
          "substitutions": {
            "name": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@name@ avsluttes. Dagens treningsøkt i kalenderen beholdes. Den nye planen aktiveres nå."
          },
          "substitutions": {
            "name": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@name@ päättyy. Tämän päivän kalenteriharjoitus säilyy. Uusi suunnitelma aktivoituu nyt."
          },
          "substitutions": {
            "name": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@name@ é encerrado. O treino de hoje no calendário mantém-se. O novo plano é ativado agora."
          },
          "substitutions": {
            "name": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@name@ é encerrado. O treino de hoje no calendário permanece inalterado. O novo plano é ativado agora."
          },
          "substitutions": {
            "name": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@name@ zostanie zamknięty. Dzisiejszy trening w kalendarzu zostaje. Nowy plan zostanie aktywowany teraz."
          },
          "substitutions": {
            "name": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@name@ 계획이 종료됩니다. 오늘의 캘린더 워크아웃은 유지됩니다. 새 계획이 지금 활성화됩니다."
          },
          "substitutions": {
            "name": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@name@を終了します。カレンダーにある今日のワークアウトは残ります。新しいプランが今すぐ有効になります。"
          },
          "substitutions": {
            "name": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@name@ 将结束。今日日历中的训练课程会保留。新计划将立即启用。"
          },
          "substitutions": {
            "name": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@name@ 將結束。今日行事曆中的訓練課表會保留。新計畫將立即啟用。"
          },
          "substitutions": {
            "name": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        }
      }
    },
