    "plan.view.ended.cleanupFailedDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Plan remains ended. Retry cleanup or verify %#@intervals@ again."
          },
          "substitutions": {
            "intervals": {
              "argNum": 1,
              "formatSpecifier": "@"
            }
          }
        },
        "es": {
