{
  "name": "@enduragent/desktop-renderer",
  "version": "0.0.5",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p tsconfig.preview.json",
