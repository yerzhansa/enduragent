{
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": false,
    "types": []
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"]
}
