{
  "name": "@enduragent/credits-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run && node --test --test-timeout=60000 scripts/proof-bundle.test.mjs scripts/worker-startup.test.mjs",
    "test:proof": "node --test scripts/proof-bundle.test.mjs",
    "test:startup": "node --test --test-timeout=60000 scripts/worker-startup.test.mjs",
    "proof:build": "node scripts/proof-build.mjs",
    "proof": "node dist/live-proof.mjs"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260911.1",
    "@types/node-fetch": "2.6.13",
    "esbuild": "0.28.1",
    "node-fetch": "2.7.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.131.1"
  },
  "engines": {
    "node": ">=24"
  }
}
