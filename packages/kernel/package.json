    "./planning": "./dist/planning.js",
    "./archive": "./dist/archive/index.js",
    "./store/export": "./dist/store/export/index.js",
    "./ingest": "./dist/ingest/index.js",
    "./reference/metrics": "./dist/reference/metrics.js",
    "./reference/registry": "./dist/reference/registry.js",
    "./reference/schemas": "./dist/reference/schemas.js",
    "./reference/validation": "./dist/reference/validation.js",
    "./reference/cs-resolution": "./dist/reference/cs-resolution.js",
    "./reference/freshness": "./dist/reference/freshness.js",
    "./reference/preserve-tokens": "./dist/reference/preserve-tokens.js",
