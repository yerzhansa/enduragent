{
  "name": "@enduragent/sync-file-import",
  "version": "0.0.3",
  "private": true,
  "description": "Private stable file source for the Reference layer.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./manual": "./dist/manual.js",
    "./watcher": "./dist/watcher.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@enduragent/kernel": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsup": "^8.4.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.11"
  },
  "license": "MIT"
}
